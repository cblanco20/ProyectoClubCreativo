<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport"
          content="width=device-width, initial-scale=1.0" />

    <title>@ViewData["Title"] - Club Creativo</title>

    <link rel="stylesheet"
          href="~/lib/bootstrap/dist/css/bootstrap.min.css" />

    <link rel="stylesheet"
          href="~/css/club-creativo.css"
          asp-append-version="true" />

    <link rel="stylesheet"
          href="~/css/acceso.css"
          asp-append-version="true" />
</head>

<body class="pagina-acceso">

    <a asp-controller="Home"
       asp-action="Index"
       class="marca-acceso">

        <span class="logo-acceso-contenedor">
            <img src="~/images/logo.jpg"
                 alt="Club Creativo"
                 class="logo-acceso"
                 asp-append-version="true" />
        </span>

        <span class="nombre-acceso">
            <span>Club</span> Creativo
        </span>
    </a>

    <main>
        @RenderBody()
    </main>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>

    <script src="~/js/acceso.js"
            asp-append-version="true"></script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
