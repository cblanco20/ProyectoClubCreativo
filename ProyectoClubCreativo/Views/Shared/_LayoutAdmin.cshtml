@{
    string accionActual = ViewContext.RouteData.Values["action"]?.ToString() ?? "";

    string ClaseAdmin(string accion)
    {
        return accionActual == accion ? "enlace-admin activo" : "enlace-admin";
    }
}

<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Administración Club Creativo</title>

    <link rel="icon" type="image/x-icon" href="~/favicon.ico" />
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css" />
    <link rel="stylesheet" href="~/css/club-creativo.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/admin.css" asp-append-version="true" />
</head>

<body class="pagina-admin">

    <div id="fondoMenuAdmin" class="fondo-menu-admin"></div>

    <aside id="menuAdmin" class="menu-admin">

        <div class="encabezado-menu-admin">
            <a asp-controller="Admin" asp-action="Panel" class="marca-menu-admin">
                <img src="~/images/logo.jpg" alt="Club Creativo" class="logo-menu-admin" />
                <span><strong>Club</strong> Creativo <small>Admin</small></span>
            </a>

            <button id="cerrarMenuAdmin" type="button" class="cerrar-menu-admin" aria-label="Cerrar menú">
                <i class="bi bi-x-lg"></i>
            </button>
        </div>

        <div class="resumen-menu-admin">
            <div class="avatar-menu-admin"><i class="bi bi-person-badge-fill"></i></div>
            <div>
                <strong>Jossete Sánchez</strong>
                <span>Administradora</span>
            </div>
        </div>

        <nav class="navegacion-admin">
            <span class="titulo-grupo-menu">General</span>

            <a asp-controller="Admin" asp-action="Panel" class="@ClaseAdmin("Panel")">
                <i class="bi bi-grid-fill"></i> Dashboard
            </a>

            <span class="titulo-grupo-menu">Gestión</span>

            <a asp-controller="Admin" asp-action="Usuarios" class="@ClaseAdmin("Usuarios")">
                <i class="bi bi-people-fill"></i> Usuarios
            </a>

            <a asp-controller="Admin" asp-action="Emprendimientos" class="@ClaseAdmin("Emprendimientos")">
                <i class="bi bi-buildings-fill"></i> Emprendimientos
            </a>

            <a asp-controller="Admin" asp-action="Suscripciones" class="@ClaseAdmin("Suscripciones")">
                <i class="bi bi-gem"></i> Suscripciones
            </a>

            <a asp-controller="Admin" asp-action="Productos" class="@ClaseAdmin("Productos")">
                <i class="bi bi-box-seam-fill"></i> Productos
            </a>
            <a asp-controller="Admin" asp-action="Ventas" class="@ClaseAdmin("Ventas")">
                <i class="bi bi-cash-stack"></i> Ventas
            </a>
            <a asp-controller="Admin" asp-action="Eventos" class="@ClaseAdmin("Eventos")">
                <i class="bi bi-calendar-event-fill"></i> Eventos
            </a>
            <a asp-controller="Admin" asp-action="Talleres" class="@ClaseAdmin("Talleres")">
                <i class="bi bi-palette-fill"></i> Talleres
            </a>
            <a asp-controller="Admin" asp-action="PuntosRecompensas" class="@ClaseAdmin("PuntosRecompensas")">
                <i class="bi bi-gift-fill"></i> Puntos y recompensas
            </a>
            <a asp-controller="Admin" asp-action="AsistenciaQr" class="@ClaseAdmin("AsistenciaQr")">
                <i class="bi bi-qr-code-scan"></i> Asistencia QR
            </a>

            <span class="titulo-grupo-menu">Contenido</span>

            <a asp-controller="Admin" asp-action="Notificaciones" class="@ClaseAdmin("Notificaciones")">
                <i class="bi bi-bell-fill"></i> Notificaciones
            </a>
            <a asp-controller="Admin" asp-action="Galerias" class="@ClaseAdmin("Galerias")">
                <i class="bi bi-images"></i> Galerías
            </a>
            <a asp-controller="Admin" asp-action="Noticias" class="@ClaseAdmin("Noticias")">
                <i class="bi bi-newspaper"></i> Noticias y anuncios
            </a>
            <a asp-controller="Admin" asp-action="Comentarios" class="@ClaseAdmin("Comentarios")">
                <i class="bi bi-chat-square-text-fill"></i> Moderación de comentarios
            </a>
            <a asp-controller="Admin" asp-action="Categorias" class="@ClaseAdmin("Categorias")">
                <i class="bi bi-tags-fill"></i> Categorías y etiquetas
            </a>
            <a asp-controller="Admin" asp-action="Promociones" class="@ClaseAdmin("Promociones")">
                <i class="bi bi-megaphone-fill"></i> Promociones y campañas
            </a>
            <a asp-controller="Admin" asp-action="Encuestas" class="@ClaseAdmin("Encuestas")">
                <i class="bi bi-clipboard2-check-fill"></i> Encuestas
            </a>

            <span class="titulo-grupo-menu">Análisis y seguridad</span>

            <a asp-controller="Admin" asp-action="Reportes" class="@ClaseAdmin("Reportes")">
                <i class="bi bi-graph-up-arrow"></i> Reportes y estadísticas
            </a>
            <a asp-controller="Admin" asp-action="Bitacora" class="@ClaseAdmin("Bitacora")">
                <i class="bi bi-shield-lock-fill"></i> Seguridad y auditoría
            </a>
        </nav>
     
        <a asp-controller="Admin" asp-action="CerrarSesion" class="cerrar-sesion-menu">
            <i class="bi bi-box-arrow-left"></i> Cerrar sesión
        </a>
    </aside>

    <div class="estructura-admin">

        <header class="encabezado-admin">
            <button id="abrirMenuAdmin" type="button" class="boton-menu-admin" aria-label="Abrir menú">
                <i class="bi bi-list"></i>
            </button>

            <h1 class="titulo-encabezado-admin">@ViewData["Title"]</h1>

            <div class="acciones-admin">
                <span class="accion-icono-admin"><i class="bi bi-bell"></i></span>
                <div class="perfil-encabezado-admin">
                    <span class="avatar-encabezado-admin"><i class="bi bi-person-badge-fill"></i></span>
                    <span class="nombre-encabezado-admin">Jossete Sánchez</span>
                </div>
            </div>
        </header>

        <main class="contenido-principal-admin">
            @if (TempData["MensajeAdmin"] is not null)
            {
                <div class="alerta-exito-admin">
                    <i class="bi bi-check-circle-fill"></i> @TempData["MensajeAdmin"]
                </div>
            }
            @RenderBody()
        </main>
    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/admin.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
