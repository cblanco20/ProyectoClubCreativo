@model ProyectoClubCreativo.Models.ViewModels.Admin.GestionSuscripcionesViewModel

@{
    ViewData["Title"] = "Gestión de suscripciones";
    Layout = "~/Views/Shared/_LayoutAdmin.cshtml";
}

<article class="bloque-admin">
    <div class="encabezado-bloque-admin">
        <h2><i class="bi bi-gem"></i> Planes de suscripción</h2>
        <a asp-action="CrearPlan" class="boton-admin boton-admin-primario">
            <i class="bi bi-plus-circle-fill"></i> Crear plan
        </a>
    </div>

    <section class="grid-estadisticas-admin">
        @foreach (var plan in Model.Planes)
        {
            <article class="tarjeta-estadistica-admin" style="align-items:flex-start;">
                <span class="icono-estadistica-admin icono-solicitudes-admin"><i class="bi bi-gem"></i></span>
                <div style="flex:1;">
                    <strong>@plan.Nombre</strong>
                    <span>₡@plan.Precio.ToString("N0") / @plan.Periodicidad.ToLower()</span>
                    <div style="margin-top:8px;">
                        <span class="etiqueta-estado-admin estado-activo">@plan.CantidadSuscriptores suscriptores</span>
                    </div>
                    <a asp-action="EditarPlan" asp-route-id="@plan.Id" class="boton-admin boton-admin-secundario" style="margin-top:10px;padding:6px 14px;">
                        <i class="bi bi-pencil-fill"></i> Editar
                    </a>
                </div>
            </article>
        }
    </section>
</article>

<article class="bloque-admin">
    <div class="encabezado-bloque-admin">
        <h2><i class="bi bi-credit-card-2-front-fill"></i> Suscripciones activas y vencimientos</h2>
        <span class="etiqueta-estado-admin estado-porvencer">@Model.TotalPorVencer por vencer</span>
    </div>

    <div class="tabla-admin-contenedor">
        <table class="tabla-admin">
            <thead>
                <tr>
                    <th>Emprendimiento</th>
                    <th>Plan</th>
                    <th>Inicio</th>
                    <th>Vencimiento</th>
                    <th>Estado</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var suscripcion in Model.Activas)
                {
                    string clase = suscripcion.Estado switch
                    {
                        "Vigente" => "estado-vigente",
                        "Por vencer" => "estado-porvencer",
                        _ => "estado-vencida"
                    };

                    <tr>
                        <td>@suscripcion.Emprendimiento</td>
                        <td>@suscripcion.Plan</td>
                        <td>@suscripcion.FechaInicio</td>
                        <td>@suscripcion.FechaVencimiento</td>
                        <td><span class="etiqueta-estado-admin @clase">@suscripcion.Estado</span></td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</article>
