@model ProyectoClubCreativo.Models.ViewModels.Admin.ListadoNoticiasAdminViewModel

@{
    ViewData["Title"] = "Gestión de noticias y anuncios";
    Layout = "~/Views/Shared/_LayoutAdmin.cshtml";
    string[] estados = { "Todas", "Borrador", "Publicada", "Inactiva" };
}

<div class="pestanas-admin">
    @foreach (var estado in estados)
    {
        <a asp-action="Noticias" asp-route-estado="@estado" class="pestana-admin @(Model.FiltroEstado == estado ? "activa" : "")">@estado</a>
    }
</div>

<div class="grupo-acciones-admin" style="margin-bottom:20px;">
    <a asp-action="CrearNoticia" class="boton-admin boton-admin-primario">
        <i class="bi bi-plus-circle-fill"></i> Crear publicación
    </a>
</div>

<article class="bloque-admin">
    <div class="encabezado-bloque-admin">
        <h2><i class="bi bi-newspaper"></i> Publicaciones (@Model.Noticias.Count)</h2>
    </div>

    <div class="tabla-admin-contenedor">
        <table class="tabla-admin">
            <thead>
                <tr>
                    <th>Título</th>
                    <th>Categoría</th>
                    <th>Autor</th>
                    <th>Publicación</th>
                    <th>Estado</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var noticia in Model.Noticias)
                {
                    string clase = noticia.Estado switch
                    {
                        "Publicada" => "estado-activo",
                        "Inactiva" => "estado-inactivo",
                        _ => "estado-pendiente"
                    };

                    <tr>
                        <td>
                            <div class="celda-usuario-admin">
                                <img src="@noticia.Imagen" class="foto-tabla-admin" alt="@noticia.Titulo" />
                                @noticia.Titulo
                            </div>
                        </td>
                        <td>@noticia.Categoria</td>
                        <td>@noticia.Autor</td>
                        <td>@(string.IsNullOrWhiteSpace(noticia.FechaPublicacion) ? "—" : noticia.FechaPublicacion)</td>
                        <td><span class="etiqueta-estado-admin @clase">@noticia.Estado</span></td>
                        <td>
                            <div class="grupo-acciones-admin">
                                <a asp-action="EditarNoticia" asp-route-id="@noticia.Id" class="boton-admin boton-admin-secundario">
                                    <i class="bi bi-pencil-fill"></i>
                                </a>
                                @if (noticia.Estado != "Publicada")
                                {
                                    <form asp-action="PublicarNoticia" method="post">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="id" value="@noticia.Id" />
                                        <button type="submit" class="boton-admin boton-admin-exito"><i class="bi bi-broadcast"></i></button>
                                    </form>
                                }
                                else
                                {
                                    <form asp-action="DesactivarNoticia" method="post">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="id" value="@noticia.Id" />
                                        <button type="submit" class="boton-admin boton-admin-secundario"><i class="bi bi-eye-slash-fill"></i></button>
                                    </form>
                                }
                                <form asp-action="EliminarNoticia" method="post" onsubmit="return confirm('¿Eliminar esta publicación de forma permanente?');">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="id" value="@noticia.Id" />
                                    <button type="submit" class="boton-admin boton-admin-peligro"><i class="bi bi-trash-fill"></i></button>
                                </form>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</article>
