@model ProyectoClubCreativo.Models.ViewModels.Admin.EncuestaAdminViewModel
@{
    ViewData["Title"] = "Resultados de encuesta";
    Layout = "~/Views/Shared/_LayoutAdmin.cshtml";
}

<a asp-action="Encuestas" class="boton-admin boton-admin-secundario" style="margin-bottom:18px;">
    <i class="bi bi-arrow-left"></i> Volver a encuestas
</a>

<article class="bloque-admin">
    <div class="encabezado-bloque-admin">
        <h2><i class="bi bi-bar-chart-fill"></i> @Model.Titulo</h2>
        <span class="etiqueta-estado-admin">@Model.Estado</span>
    </div>

    <p style="font-size:13px;">
        @Model.TotalRespuestas respuesta(s) recibidas · Creada el @Model.FechaCreacion
    </p>

    @if (Model.TotalRespuestas == 0)
    {
        <p>Todavía no hay respuestas para esta encuesta.</p>
    }

    @foreach (var pregunta in Model.Resultados)
    {
        int totalVotos = pregunta.Opciones.Sum(o => o.Votos);

        <div style="margin-top:18px;">
            <h4>@pregunta.Texto</h4>

            @if (pregunta.Tipo == "Texto")
            {
                @if (pregunta.RespuestasTexto.Count == 0)
                {
                    <p style="font-size:13px;">Sin comentarios.</p>
                }
                @foreach (string comentario in pregunta.RespuestasTexto)
                {
                    <p style="font-size:13px;margin:4px 0;">• @comentario</p>
                }
            }
            else
            {
                @if (pregunta.Promedio.HasValue)
                {
                    <p style="font-size:13px;">Promedio: @pregunta.Promedio.Value.ToString("0.0") de 5</p>
                }
                @foreach (var opcion in pregunta.Opciones)
                {
                    int porcentaje = totalVotos == 0 ? 0 : (int)((double)opcion.Votos / totalVotos * 100);
                    <div style="display:flex;align-items:center;gap:10px;margin:6px 0;font-size:13px;">
                        <span style="min-width:140px;">@opcion.Texto</span>
                        <div style="flex:1;background:#eee;border-radius:8px;height:10px;">
                            <div style="width:@(porcentaje)%;background:var(--color-naranja, #f47a20);height:10px;border-radius:8px;"></div>
                        </div>
                        <span>@opcion.Votos (@porcentaje%)</span>
                    </div>
                }
            }
        </div>
    }
</article>
