@model ProyectoClubCreativo.Models.ViewModels.Admin.TallerAdminViewModel
@{
    ViewData["Title"] = "Inscritos: " + Model.Nombre; Layout = "~/Views/Shared/_LayoutAdmin.cshtml";
    bool cancelable = Model.Estado == "Programado" || Model.Estado == "Borrador";
}

<a asp-action="Talleres" class="boton-admin boton-admin-secundario" style="margin-bottom:18px;"><i class="bi bi-arrow-left"></i> Volver a talleres</a>

<article class="bloque-admin">
    <div class="encabezado-bloque-admin">
    <h2>
        <i class="bi bi-people-fill"></i>
        @Model.Nombre — @Model.Inscritos / @Model.CuposTotales cupos ocupados
        (@Model.CuposDisponibles disponibles)
    </h2>

    <div class="grupo-acciones-admin">
            <a asp-action="ReporteAsistencia"
               asp-route-id="@Model.Id"
               asp-route-tipo="Taller"
               class="boton-admin boton-admin-secundario">
                <i class="bi bi-file-earmark-text"></i>
                Ver reporte de asistencia
            </a>

        @if (!Model.QrGenerado && Model.Estado == "Programado")
        {
            <form asp-action="GenerarQrTaller" method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" name="id" value="@Model.Id" />

                <button type="submit" class="boton-admin boton-admin-primario">
                    <i class="bi bi-qr-code"></i> Generar QR
                </button>
            </form>
        }
        else if (Model.QrGenerado)
        {
            <a asp-action="DescargarQrTaller"
               asp-route-id="@Model.Id"
               class="boton-admin boton-admin-secundario">
                <i class="bi bi-download"></i> Descargar QR
            </a>

            @if (Model.Estado == "Programado")
            {
                <form asp-action="RegenerarQrTaller" method="post">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="id" value="@Model.Id" />

                    <button type="submit"
                            class="boton-admin boton-admin-oscuro"
                            onclick="return confirm('¿Deseas regenerar el QR? El código anterior dejará de funcionar.');">
                        <i class="bi bi-arrow-repeat"></i> Regenerar
                    </button>
                </form>
            }
        }
        else
        {
            <span class="etiqueta-estado-admin estado-pendiente">
                QR no disponible
            </span>
        }

    </div>
</div>

    <div class="tabla-admin-contenedor">
        <table class="tabla-admin">
            <thead><tr><th>Nombre</th><th>Correo</th><th>Inscripción</th><th>Estado</th></tr></thead>
            <tbody>
                @foreach (var i in Model.ListaInscritos)
                {
                    <tr><td>@i.Nombre</td><td>@i.Correo</td><td>@i.Fecha</td><td><span class="etiqueta-estado-admin @(i.Estado == "Confirmada" ? "estado-activo" : "estado-pendiente")">@i.Estado</span></td></tr>
                }
                @if (Model.ListaInscritos.Count == 0)
                {
                    <tr><td colspan="4">Todavía no hay inscritos.</td></tr>
                }
            </tbody>
        </table>
    </div>

    @if (cancelable)
    {
        <form asp-action="CancelarTaller" method="post" class="formulario-admin" style="margin-top:22px;">
            <input type="hidden" name="id" value="@Model.Id" />
            <div class="grupo-formulario"><label>Motivo de cancelación del taller</label><textarea name="motivo" rows="2" required></textarea></div>
            <button type="submit" class="boton-admin boton-admin-peligro">Cancelar taller</button>
        </form>
    }
</article>
