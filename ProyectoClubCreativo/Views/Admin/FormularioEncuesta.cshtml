@model ProyectoClubCreativo.Models.ViewModels.Admin.EncuestaAdminViewModel
@{
    ViewData["Title"] = ViewData["Titulo"]?.ToString() ?? "Encuesta";
    Layout = "~/Views/Shared/_LayoutAdmin.cshtml";
    bool esNueva = Model.Id == 0;
}

<a asp-action="Encuestas" class="boton-admin boton-admin-secundario" style="margin-bottom:18px;">
    <i class="bi bi-arrow-left"></i> Volver a encuestas
</a>

<article class="bloque-admin" style="max-width:640px;">
    <div class="encabezado-bloque-admin">
        <h2><i class="bi bi-clipboard2-check-fill"></i> @ViewData["Title"]</h2>
    </div>

    <form asp-action="@(esNueva ? "CrearEncuesta" : "EditarEncuesta")" method="post" class="formulario-admin">
        @Html.AntiForgeryToken()
        <input type="hidden" asp-for="Id" />
        <div asp-validation-summary="ModelOnly"></div>

        <div class="grupo-formulario">
            <label asp-for="Titulo"></label>
            <input asp-for="Titulo" placeholder="Ej. Satisfacción con la feria de agosto" />
            <span class="mensaje-validacion" asp-validation-for="Titulo"></span>
        </div>

        <div class="grupo-formulario">
            <label asp-for="Descripcion"></label>
            <textarea asp-for="Descripcion" rows="2"></textarea>
        </div>

        <div class="grupo-formulario">
            <label asp-for="PreguntasTexto"></label>
            <textarea asp-for="PreguntasTexto" rows="5" placeholder="¿Cómo calificarías la organización del evento?&#10;¿Qué tan probable es que asistas a la próxima edición?"></textarea>
            <span class="mensaje-validacion" asp-validation-for="PreguntasTexto"></span>
        </div>

        <div class="grupo-formulario">
            <label asp-for="Estado"></label>
            <select asp-for="Estado">
                <option>Borrador</option>
                <option>Publicada</option>
                <option>Cerrada</option>
            </select>
        </div>

        <button type="submit" class="boton-admin boton-admin-primario">
            <i class="bi bi-check-circle-fill"></i> @(esNueva ? "Crear encuesta" : "Guardar cambios")
        </button>
    </form>
</article>
