@model ProyectoClubCreativo.Models.ViewModels.Admin.PromocionAdminViewModel
@{
    ViewData["Title"] = ViewData["Titulo"]?.ToString() ?? "Promoción";
    Layout = "~/Views/Shared/_LayoutAdmin.cshtml";
    bool esNueva = Model.Id == 0;
    var emprendimientos = (IEnumerable<dynamic>)(ViewBag.EmprendimientosPromocion ?? new List<dynamic>());
    var productos = (IEnumerable<dynamic>)(ViewBag.ProductosPromocion ?? new List<dynamic>());
    var eventos = (IEnumerable<dynamic>)(ViewBag.EventosPromocion ?? new List<dynamic>());
}

<a asp-action="Promociones" class="boton-admin boton-admin-secundario" style="margin-bottom:18px;">
    <i class="bi bi-arrow-left"></i> Volver a promociones
</a>

<article class="bloque-admin" style="max-width:640px;">
    <div class="encabezado-bloque-admin">
        <h2><i class="bi bi-megaphone-fill"></i> @ViewData["Title"]</h2>
    </div>

    <form asp-action="@(esNueva ? "CrearPromocion" : "EditarPromocion")" method="post" class="formulario-admin" novalidate>
        @Html.AntiForgeryToken()
        <input type="hidden" asp-for="Id" />
        <div asp-validation-summary="ModelOnly" class="alerta-error-admin"></div>

        <div class="grupo-formulario">
            <label asp-for="Nombre"></label>
            <input asp-for="Nombre" maxlength="150" placeholder="Ej. Descuento Feria San Pedro" />
            <span class="mensaje-validacion" asp-validation-for="Nombre"></span>
        </div>

        <div class="grupo-formulario">
            <label asp-for="Descripcion"></label>
            <textarea asp-for="Descripcion" rows="3"></textarea>
            <span class="mensaje-validacion" asp-validation-for="Descripcion"></span>
        </div>

        <div class="fila-formulario">
            <div class="grupo-formulario">
                <label asp-for="TipoDescuento"></label>
                <select asp-for="TipoDescuento">
                    <option>Porcentaje</option>
                    <option value="MontoFijo">Monto fijo</option>
                </select>
                <span class="mensaje-validacion" asp-validation-for="TipoDescuento"></span>
            </div>
            <div class="grupo-formulario">
                <label asp-for="ValorDescuento"></label>
                <input asp-for="ValorDescuento" type="number" step="0.01" min="0" />
                <span class="mensaje-validacion" asp-validation-for="ValorDescuento"></span>
            </div>
        </div>

        <div class="fila-formulario">
            <div class="grupo-formulario">
                <label asp-for="FechaInicio"></label>
                <input asp-for="FechaInicio" type="date" />
                <span class="mensaje-validacion" asp-validation-for="FechaInicio"></span>
            </div>
            <div class="grupo-formulario">
                <label asp-for="FechaFin"></label>
                <input asp-for="FechaFin" type="date" />
                <span class="mensaje-validacion" asp-validation-for="FechaFin"></span>
            </div>
        </div>

        <div class="fila-formulario">
            <div class="grupo-formulario">
                <label asp-for="IdEmprendimiento"></label>
                <select name="IdEmprendimiento">
                    <option value="">Todos</option>
                    @foreach (var emprendimiento in emprendimientos)
                    {
                        <option value="@emprendimiento.IdEmprendimiento" selected="@(Model.IdEmprendimiento == (int)emprendimiento.IdEmprendimiento)">@emprendimiento.NombreComercial</option>
                    }
                </select>
            </div>
            <div class="grupo-formulario">
                <label asp-for="IdProducto"></label>
                <select name="IdProducto">
                    <option value="">Todos</option>
                    @foreach (var producto in productos)
                    {
                        <option value="@producto.IdProducto" selected="@(Model.IdProducto == (int)producto.IdProducto)">@producto.Nombre</option>
                    }
                </select>
            </div>
        </div>

        <div class="fila-formulario">
            <div class="grupo-formulario">
                <label asp-for="IdEvento"></label>
                <select name="IdEvento">
                    <option value="">Ninguno</option>
                    @foreach (var evento in eventos)
                    {
                        <option value="@evento.IdEvento" selected="@(Model.IdEvento == (int)evento.IdEvento)">@evento.Nombre</option>
                    }
                </select>
            </div>
            <div class="grupo-formulario">
                <label asp-for="LimiteUsos"></label>
                <input asp-for="LimiteUsos" type="number" min="1" placeholder="Sin límite" />
                <span class="mensaje-validacion" asp-validation-for="LimiteUsos"></span>
            </div>
        </div>

        <div class="grupo-acciones-admin">
            <button type="submit" class="boton-admin boton-admin-primario">
                <i class="bi bi-check-circle-fill"></i> @(esNueva ? "Guardar promoción" : "Guardar cambios")
            </button>
            <a asp-action="Promociones" class="boton-admin boton-admin-secundario">
                <i class="bi bi-x-circle"></i> Cancelar
            </a>
        </div>
    </form>
</article>
