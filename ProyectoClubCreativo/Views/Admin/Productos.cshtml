@model ProyectoClubCreativo.Models.ViewModels.Admin.ListadoProductosAdminViewModel

@{
    ViewData["Title"] = "Gestión de productos";
    Layout = "~/Views/Shared/_LayoutAdmin.cshtml";

    string[] categorias = { "Todas", "Arte e ilustración", "Accesorios", "Hogar y decoración", "Velas y aromas" };
    string[] estados = { "Todos", "Activo", "En revisión", "Pausado" };
}

<form asp-controller="Admin" asp-action="Productos" method="get" class="barra-filtros-admin">
    <div class="campo-filtro-admin" style="min-width:240px;">
        <label>Buscar</label>
        <input type="text" name="busqueda" value="@Model.Busqueda" placeholder="Producto o emprendimiento" />
    </div>
    <div class="campo-filtro-admin">
        <label>Categoría</label>
        <select name="categoria">
            @foreach (var c in categorias)
            {
                <option value="@c" selected="@(Model.FiltroCategoria == c)">@c</option>
            }
        </select>
    </div>
    <div class="campo-filtro-admin">
        <label>Estado</label>
        <select name="estado">
            @foreach (var e in estados)
            {
                <option value="@e" selected="@(Model.FiltroEstado == e)">@e</option>
            }
        </select>
    </div>
    <button type="submit" class="boton-filtro-admin"><i class="bi bi-search"></i> Buscar</button>
</form>

<article class="bloque-admin">
    <div class="encabezado-bloque-admin">
        <h2><i class="bi bi-box-seam-fill"></i> Productos (@Model.Productos.Count)</h2>
    </div>

    <div class="tabla-admin-contenedor">
        <table class="tabla-admin">
            <thead>
                <tr>
                    <th>Producto</th>
                    <th>Emprendimiento</th>
                    <th>Categoría</th>
                    <th>Precio</th>
                    <th>Estado</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var producto in Model.Productos)
                {
                    string clase = producto.Estado switch
                    {
                        "Activo" => "estado-activo",
                        "Pausado" => "estado-pausado",
                        _ => "estado-revision"
                    };

                    <tr>
                        <td>
                            <div class="celda-usuario-admin">
                                <img src="@producto.Imagen" class="foto-tabla-admin" alt="@producto.Nombre" />
                                @producto.Nombre
                                @if (producto.Reportes > 0)
                                {
                                    <span class="etiqueta-estado-admin estado-rechazado" style="margin-left:6px;">
                                        <i class="bi bi-flag-fill"></i>&nbsp;@producto.Reportes
                                    </span>
                                }
                            </div>
                        </td>
                        <td>@producto.Emprendimiento</td>
                        <td>@producto.Categoria</td>
                        <td>₡@producto.Precio.ToString("N0")</td>
                        <td><span class="etiqueta-estado-admin @clase">@producto.Estado</span></td>
                        <td>
                            <a asp-action="RevisarProducto" asp-route-id="@producto.Id" class="boton-admin boton-admin-secundario">
                                <i class="bi bi-eye-fill"></i> Revisar
                            </a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</article>
