@model ProyectoClubCreativo.Models.ViewModels.Admin.CategoriaAdminViewModel
@{
    ViewData["Title"] = ViewData["Titulo"]?.ToString() ?? "Categoría";
    Layout = "~/Views/Shared/_LayoutAdmin.cshtml";
    bool esNueva = Model.Id == 0;
}

<a asp-action="Categorias" asp-route-tipo="@Model.Tipo" class="boton-admin boton-admin-secundario" style="margin-bottom:18px;">
    <i class="bi bi-arrow-left"></i> Volver al listado
</a>

<article class="bloque-admin" style="max-width:560px;">
    <div class="encabezado-bloque-admin">
        <h2><i class="bi bi-tags-fill"></i> @ViewData["Title"]</h2>
    </div>

    <form asp-action="@(esNueva ? "CrearCategoria" : "EditarCategoria")" method="post" class="formulario-admin">
        @Html.AntiForgeryToken()
        <input type="hidden" asp-for="Id" />
        <div asp-validation-summary="ModelOnly"></div>

        <div class="grupo-formulario">
            <label asp-for="Nombre"></label>
            <input asp-for="Nombre" placeholder="Ej. Arte e ilustración" />
            <span class="mensaje-validacion" asp-validation-for="Nombre"></span>
        </div>

        <div class="grupo-formulario">
            <label asp-for="Descripcion"></label>
            <textarea asp-for="Descripcion" rows="3"></textarea>
        </div>

        <div class="fila-formulario">
            <div class="grupo-formulario">
                <label asp-for="Tipo"></label>
                <select asp-for="Tipo">
                    <option value="Categoria">Categoría</option>
                    <option value="Etiqueta">Etiqueta</option>
                </select>
            </div>
            <div class="grupo-formulario">
                <label asp-for="Modulo"></label>
                <select asp-for="Modulo">
                    <option>Productos</option>
                    <option>Eventos</option>
                    <option>Talleres</option>
                    <option>Noticias</option>
                </select>
            </div>
        </div>

        <button type="submit" class="boton-admin boton-admin-primario">
            <i class="bi bi-check-circle-fill"></i> @(esNueva ? "Crear" : "Guardar cambios")
        </button>
    </form>
</article>
