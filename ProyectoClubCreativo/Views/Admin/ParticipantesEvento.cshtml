@model ProyectoClubCreativo.Models.ViewModels.Admin.EventoAdminViewModel
@{
    ViewData["Title"] = "Participantes: " + Model.Nombre; Layout = "~/Views/Shared/_LayoutAdmin.cshtml";
}

<a asp-action="Eventos" class="boton-admin boton-admin-secundario" style="margin-bottom:18px;"><i class="bi bi-arrow-left"></i> Volver a eventos</a>

<article class="bloque-admin">
    <div class="encabezado-bloque-admin">
        <h2><i class="bi bi-people-fill"></i> @Model.Nombre — @Model.Inscritos / @Model.CupoTotal inscritos</h2>
        <div class="grupo-acciones-admin">
            <form asp-action="GenerarQrEvento" method="post"><input type="hidden" name="id" value="@Model.Id" /><button class="boton-admin boton-admin-oscuro"><i class="bi bi-qr-code"></i> @(Model.QrGenerado ? "Regenerar QR" : "Generar QR")</button></form>
        </div>
    </div>

    <h3>Emprendimientos asignados</h3>
    <div class="grupo-acciones-admin" style="margin-bottom:14px;">
        @foreach (var em in Model.EmprendimientosAsignados)
        {
            <span class="etiqueta-estado-admin estado-activo">@em</span>
        }
    </div>
    <a asp-action="EditarEvento" asp-route-id="@Model.Id" class="boton-admin boton-admin-secundario" style="margin-bottom:22px;">
        <i class="bi bi-pencil-square"></i> Gestionar emprendimientos
    </a>

    <h3>Participantes</h3>
    <div class="tabla-admin-contenedor">
        <table class="tabla-admin">
            <thead><tr><th>Nombre</th><th>Correo</th><th>Estado</th></tr></thead>
            <tbody>
                @foreach (var p in Model.Participantes)
                {
                    string clase = p.Estado switch
                    {
                        "Confirmada" or "Asistio" => "estado-activo",
                        "Cancelada" or "NoAsistio" => "estado-rechazado",
                        _ => "estado-pendiente"
                    };

                    <tr><td>@p.Nombre</td><td>@p.Correo</td><td><span class="etiqueta-estado-admin @clase">@p.Estado</span></td></tr>
                }

                @if (!Model.Participantes.Any())
                {
                    <tr><td colspan="3">Aún no hay usuarios inscritos en este evento.</td></tr>
                }
            </tbody>
        </table>
    </div>

    <form asp-action="EliminarEvento"
          method="post"
          class="formulario-admin"
          style="margin-top:22px;"
          onsubmit="return confirm('¿Cancelar y eliminar este evento? Se notificará a los usuarios registrados.');">
        <input type="hidden" name="id" value="@Model.Id" />
        <div class="grupo-formulario">
            <label>Motivo de cancelación del evento (opcional)</label>
            <textarea name="motivo" rows="2" maxlength="500"></textarea>
        </div>
        <button type="submit" class="boton-admin boton-admin-peligro">Cancelar evento</button>
    </form>
</article>