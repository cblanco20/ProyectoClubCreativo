@model ProyectoClubCreativo.Models.ViewModels.Admin.ListadoTalleresAdminViewModel
@{
    ViewData["Title"] = "Gestión de talleres"; Layout = "~/Views/Shared/_LayoutAdmin.cshtml";
}

<div class="pestanas-admin">
    @foreach (var e in new[] { "Todos", "Programado", "Cancelado", "Finalizado" })
    {
        <a asp-action="Talleres" asp-route-estado="@e" class="pestana-admin @(Model.FiltroEstado == e ? "activa" : "")">@e</a>
    }
</div>

<article class="bloque-admin">
    <div class="encabezado-bloque-admin">
        <h2><i class="bi bi-palette-fill"></i> Talleres (@Model.Talleres.Count)</h2>
        <a asp-action="CrearTaller" class="boton-admin boton-admin-primario"><i class="bi bi-plus-lg"></i> Crear taller</a>
    </div>
    <div class="tabla-admin-contenedor">
        <table class="tabla-admin">
            <thead><tr><th>Taller</th><th>Fecha</th><th>Cupos</th><th>Estado</th><th></th></tr></thead>
            <tbody>
                @foreach (var t in Model.Talleres)
                {
                    string clase = t.CuposDisponibles == 0 ? "estado-pausado" : t.Estado switch { "Programado" => "estado-activo", "Cancelado" => "estado-rechazado", _ => "estado-pendiente" };
                    string texto = t.CuposDisponibles == 0 ? "Cupo lleno" : t.Estado;
                    <tr>
                        <td>@t.Nombre</td>
                        <td>@t.Fecha</td>
                        <td>@t.CuposDisponibles / @t.CuposTotales</td>
                        <td><span class="etiqueta-estado-admin @clase">@texto</span></td>
                        <td class="grupo-acciones-admin">
                            <a asp-action="InscritosTaller" asp-route-id="@t.Id" class="boton-admin boton-admin-secundario">Ver</a>
                            <a asp-action="EditarTaller" asp-route-id="@t.Id" class="boton-admin boton-admin-secundario">Editar</a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</article>
