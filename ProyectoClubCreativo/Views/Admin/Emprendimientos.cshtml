@model ProyectoClubCreativo.Models.ViewModels.Admin.ListadoEmprendimientosAdminViewModel

@{
    ViewData["Title"] = "Gestión de emprendimientos";
    Layout = "~/Views/Shared/_LayoutAdmin.cshtml";
}

<div class="pestanas-admin">
    <a asp-action="Emprendimientos" asp-route-estado="Pendiente" class="pestana-admin @(Model.FiltroEstado == "Pendiente" ? "activa" : "")">
        Pendientes (@Model.TotalPendientes)
    </a>
    <a asp-action="Emprendimientos" asp-route-estado="Aprobado" class="pestana-admin @(Model.FiltroEstado == "Aprobado" ? "activa" : "")">
        Aprobados (@Model.TotalAprobados)
    </a>
    <a asp-action="Emprendimientos" asp-route-estado="Rechazado" class="pestana-admin @(Model.FiltroEstado == "Rechazado" ? "activa" : "")">
        Rechazados (@Model.TotalRechazados)
    </a>
</div>

<article class="bloque-admin">
    <div class="tabla-admin-contenedor">
        <table class="tabla-admin">
            <thead>
                <tr>
                    <th>Emprendimiento</th>
                    <th>Solicitante</th>
                    <th>Categoría</th>
                    <th>Fecha</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @if (!Model.Solicitudes.Any())
                {
                    <tr><td colspan="5">No hay solicitudes en este estado.</td></tr>
                }
                @foreach (var solicitud in Model.Solicitudes)
                {
                    <tr>
                        <td>
                            <div class="celda-usuario-admin">
                                <img src="@solicitud.Logo" class="foto-tabla-admin" alt="@solicitud.NombreComercial" />
                                @solicitud.NombreComercial
                            </div>
                        </td>
                        <td>@solicitud.Solicitante</td>
                        <td>@solicitud.Categoria</td>
                        <td>@solicitud.FechaSolicitud</td>
                        <td>
                            <a asp-action="DetalleSolicitud" asp-route-id="@solicitud.Id" class="boton-admin boton-admin-secundario">
                                <i class="bi bi-eye-fill"></i> Ver detalle
                            </a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</article>
