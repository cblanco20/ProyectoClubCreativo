@model ProyectoClubCreativo.Models.ViewModels.Admin.VentaAdminViewModel

@{
    ViewData["Title"] = "Detalle de orden";
    Layout = "~/Views/Shared/_LayoutAdmin.cshtml";
    string clase = Model.Estado switch
    {
        "Pagada" => "estado-activo",
        "En preparacion" => "estado-preparacion",
        "Enviada" => "estado-enviada",
        "Entregada" => "estado-entregada",
        "Cancelada" => "estado-rechazado",
        _ => "estado-pendiente"
    };
    }


@if (TempData["ErrorAdmin"] is string error)
{
    <div class="alert alert-danger" role="alert">
        @error
    </div>
}

<article class="bloque-admin">
    <div class="encabezado-bloque-admin">
        <h2><i class="bi bi-receipt"></i> @Model.NumeroOrden</h2>
        <span class="etiqueta-estado-admin @clase">@Model.Estado</span>
    </div>

    <div class="formulario-admin">
        <div class="fila-formulario">
            <div><label>Cliente</label><p>@Model.Cliente</p></div>
            <div><label>Emprendimiento</label><p>@Model.Emprendimiento</p></div>
            <div><label>Fecha</label><p>@Model.Fecha</p></div>
            <div><label>Método de pago</label><p>@Model.MetodoPago</p></div>
            <div>
                <label>Estado del pago</label>
                <p>@Model.EstadoPago</p>
            </div>
        </div>
    </div>

    <div class="tabla-admin-contenedor" style="margin-top:18px;">
        <table class="tabla-admin">
            <thead><tr><th>Producto</th><th>Cantidad</th><th>Precio unitario</th><th>Subtotal</th></tr></thead>
            <tbody>
                @foreach (var i in Model.Items)
                {
                    <tr><td>@i.Producto</td><td>@i.Cantidad</td><td>₡@i.PrecioUnitario.ToString("N0")</td><td>₡@((i.Cantidad * i.PrecioUnitario).ToString("N0"))</td></tr>
                }
            </tbody>
        </table>
    </div>

    <h2 style="text-align:right; margin-top:14px;">Total: ₡@Model.Total.ToString("N0")</h2>

    @if (Model.Estado == "Cancelada")
    {
        <p class="text-muted">
            Esta orden ya fue cancelada.
        </p>

        @if (!string.IsNullOrWhiteSpace(Model.MotivoCancelacion))
        {
            <p>
                <strong>Motivo de cancelación:</strong>
                @Model.MotivoCancelacion
            </p>
        }
    }
    else if (Model.Estado == "Entregada")
    {
        <p class="text-muted">
            No se puede cancelar una orden que ya fue entregada.
        </p>
    }
    else if (Model.EstadoPago != "Pendiente")
    {
        <p class="text-muted">
            Esta orden no puede cancelarse desde administración
            porque su pago no está pendiente.
        </p>
    }
    else
    {
        <form asp-controller="Admin"
              asp-action="CancelarVenta"
              method="post">

            @Html.AntiForgeryToken()

            <input type="hidden"
                   name="id"
                   value="@Model.Id" />

            <div class="mb-3">
                <label for="motivoCancelacion"
                       class="form-label">
                    Motivo de cancelación
                </label>

                <textarea id="motivoCancelacion"
                          name="motivo"
                          class="form-control"
                          maxlength="300"
                          rows="3"
                          required
                          placeholder="Indique el motivo de la cancelación"></textarea>
            </div>

            <button type="submit"
                    class="btn btn-danger"
                    onclick="return confirm('¿Está seguro de cancelar esta orden? Esta acción no se puede deshacer.');">
                Cancelar orden
            </button>
        </form>
    }
</article>