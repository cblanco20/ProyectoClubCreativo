@model ProyectoClubCreativo.Models.ViewModels.Admin.NoticiaAdminViewModel
@{
    ViewData["Title"] = ViewData["Titulo"]?.ToString() ?? "Publicación";
    Layout = "~/Views/Shared/_LayoutAdmin.cshtml";
    bool esNueva = Model.Id == 0;
}

<a asp-action="Noticias" class="boton-admin boton-admin-secundario" style="margin-bottom:18px;">
    <i class="bi bi-arrow-left"></i> Volver a noticias
</a>

<article class="bloque-admin" style="max-width:640px;">
    <div class="encabezado-bloque-admin">
        <h2><i class="bi bi-newspaper"></i> @ViewData["Title"]</h2>
    </div>

    <form asp-action="@(esNueva ? "CrearNoticia" : "EditarNoticia")" method="post" class="formulario-admin" enctype="multipart/form-data" novalidate>
        @Html.AntiForgeryToken()
        <input type="hidden" asp-for="Id" />
        <div asp-validation-summary="All" class="alerta-error-admin"></div>

        <div class="grupo-formulario">
            <label asp-for="Titulo"></label>
            <input asp-for="Titulo" maxlength="180" placeholder="Ej. Nueva alianza con artesanos locales" />
            <span class="mensaje-validacion" asp-validation-for="Titulo"></span>
        </div>

        <div class="grupo-formulario">
            <label asp-for="Contenido"></label>
            <textarea asp-for="Contenido" rows="5"></textarea>
            <span class="mensaje-validacion" asp-validation-for="Contenido"></span>
        </div>

        <div class="fila-formulario">
            <div class="grupo-formulario">
                <label asp-for="Categoria"></label>
                <select asp-for="Categoria">
                    <option>Anuncio</option>
                    <option>Noticia</option>
                </select>
                <span class="mensaje-validacion" asp-validation-for="Categoria"></span>
            </div>
            @if (!esNueva)
            {
                <div class="grupo-formulario">
                    <label asp-for="Estado"></label>
                    <select asp-for="Estado">
                        <option>Borrador</option>
                        <option>Publicada</option>
                        <option>Inactiva</option>
                    </select>
                </div>
            }
        </div>

        <div class="grupo-formulario">
            <label asp-for="ImagenArchivo"></label>
            @if (!esNueva && !string.IsNullOrWhiteSpace(Model.Imagen))
            {
                <img src="@Model.Imagen" class="foto-tabla-admin" alt="@Model.Titulo" style="margin-bottom:8px;" />
            }
            <input asp-for="ImagenArchivo" type="file" accept=".jpg,.jpeg,.png,.webp" />
            <span class="mensaje-validacion" asp-validation-for="ImagenArchivo"></span>
        </div>

        <div class="grupo-acciones-admin">
            @if (esNueva)
            {
                <button type="submit" name="accion" value="publicar" class="boton-admin boton-admin-primario">
                    <i class="bi bi-broadcast"></i> Publicar
                </button>
                <button type="submit" name="accion" value="guardar" class="boton-admin boton-admin-secundario">
                    <i class="bi bi-save-fill"></i> Guardar borrador
                </button>
            }
            else
            {
                <button type="submit" class="boton-admin boton-admin-primario">
                    <i class="bi bi-check-circle-fill"></i> Guardar cambios
                </button>
            }
            <a asp-action="Noticias" class="boton-admin boton-admin-secundario">
                <i class="bi bi-x-circle"></i> Cancelar
            </a>
        </div>
    </form>
</article>
