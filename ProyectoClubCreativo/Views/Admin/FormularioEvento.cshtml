@model ProyectoClubCreativo.Models.ViewModels.Admin.EventoAdminViewModel
@using ProyectoClubCreativo.Models.Entities
@{
    ViewData["Title"] = ViewData["Titulo"]?.ToString() ?? "Evento";
    Layout = "~/Views/Shared/_LayoutAdmin.cshtml";
    bool esNuevo = Model.Id == 0;

    List<Categoria> categorias =
        ViewBag.CategoriasEvento as List<Categoria> ?? new();

    List<Emprendimiento> emprendimientos =
        ViewBag.EmprendimientosEvento as List<Emprendimiento> ?? new();
}

<a asp-action="Eventos" class="boton-admin boton-admin-secundario" style="margin-bottom:18px;"><i class="bi bi-arrow-left"></i> Volver a eventos</a>

<article class="bloque-admin" style="max-width:640px;">
    <div class="encabezado-bloque-admin"><h2><i class="bi bi-calendar-event-fill"></i> @ViewData["Title"]</h2></div>

    <form asp-action="@(esNuevo ? "CrearEvento" : "EditarEvento")" method="post" class="formulario-admin" novalidate>
        @Html.AntiForgeryToken()
        <input type="hidden" asp-for="Id" />
        <div asp-validation-summary="All" class="resumen-validacion-admin"></div>

        <div class="grupo-formulario">
            <label asp-for="Nombre"></label>
            <input asp-for="Nombre" placeholder="Ej. Feria Creativa Cartago" />
        </div>

        <div class="fila-formulario">
            <div class="grupo-formulario">
                <label asp-for="FechaInicio"></label>
                <input asp-for="FechaInicio" type="datetime-local" />
            </div>
            <div class="grupo-formulario">
                <label asp-for="FechaFin"></label>
                <input asp-for="FechaFin" type="datetime-local" />
            </div>
        </div>

        <div class="fila-formulario">
            <div class="grupo-formulario">
                <label asp-for="Ubicacion"></label>
                <input asp-for="Ubicacion" />
            </div>
            <div class="grupo-formulario">
                <label asp-for="IdCategoria"></label>
                <select asp-for="IdCategoria">
                    <option value="">Seleccione una categoría</option>
                    @foreach (Categoria categoria in categorias)
                    {
                        <option value="@categoria.IdCategoria"
                                selected="@(Model.IdCategoria == categoria.IdCategoria)">
                            @categoria.Nombre
                        </option>
                    }
                </select>
            </div>
        </div>

        <div class="fila-formulario">
            <div class="grupo-formulario">
                <label asp-for="CupoTotal"></label>
                <input asp-for="CupoTotal" type="number" min="1" />
            </div>

            @if (!esNuevo)
            {
                <div class="grupo-formulario">
                    <label asp-for="Estado"></label>
                    <select asp-for="Estado">
                        <option>Programado</option>
                        <option>Finalizado</option>
                        @if (Model.Estado != "Programado" && Model.Estado != "Finalizado")
                        {
                            <option>@Model.Estado</option>
                        }
                    </select>
                </div>
            }
        </div>

        <div class="grupo-formulario">
            <label asp-for="Descripcion"></label>
            <textarea asp-for="Descripcion" rows="3"></textarea>
        </div>

        <div class="grupo-formulario">
            <label>Emprendimientos participantes</label>

            @if (!emprendimientos.Any())
            {
                <p style="font-size:13px;">No hay emprendimientos aprobados disponibles.</p>
            }
            else
            {
                <div style="display:grid; gap:8px; max-height:180px; overflow-y:auto;">
                    @foreach (Emprendimiento emprendimiento in emprendimientos)
                    {
                        <label style="display:flex; align-items:center; gap:8px; font-weight:400;">
                            <input type="checkbox"
                                   name="IdsEmprendimientos"
                                   value="@emprendimiento.IdEmprendimiento"
                                   checked="@Model.IdsEmprendimientos.Contains(emprendimiento.IdEmprendimiento)" />
                            @emprendimiento.NombreComercial
                        </label>
                    }
                </div>
            }
        </div>

        <div style="display:flex; gap:10px; flex-wrap:wrap;">
            <button type="submit" class="boton-admin boton-admin-primario">
                <i class="bi bi-check-circle-fill"></i> @(esNuevo ? "Crear evento" : "Guardar cambios")
            </button>

            <a asp-action="Eventos" class="boton-admin boton-admin-secundario">
                <i class="bi bi-x-circle"></i> Cancelar
            </a>
        </div>
    </form>
</article>