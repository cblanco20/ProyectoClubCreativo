<!-- MODAL DETALLE DE VENTA -->
<div id="modalDetalleVenta"
     class="modal-detalle-venta @(abrirModal ? "visible" : "")"
     aria-hidden="@(abrirModal ? "false" : "true")">

    <div id="fondoModalDetalleVenta"
         class="fondo-modal-detalle-venta">
    </div>

    <div class="contenido-modal-detalle-venta"
         role="dialog"
         aria-modal="true"
         aria-labelledby="tituloDetalleVenta">

        <button type="button"
                id="cerrarModalDetalleVenta"
                class="cerrar-modal-detalle-venta"
                aria-label="Cerrar">

            <i class="bi bi-x-lg"></i>

        </button>

        <div class="cabecera-modal-venta">

            <span class="icono-modal-venta">
                <i class="bi bi-receipt-cutoff"></i>
            </span>

            <div>
                <span>Detalle de la orden</span>

                <h2 id="tituloDetalleVenta">
                    <span id="detalleNumeroOrden">
                        @Model.NumeroOrden
                    </span>
                </h2>
            </div>

        </div>


        <div class="grid-datos-detalle-venta">

            <div>
                <span>Cliente</span>
                <strong id="detalleClienteVenta">—</strong>
            </div>

            <div>
                <span>Correo</span>
                <strong id="detalleCorreoVenta">—</strong>
            </div>

            <div>
                <span>Fecha</span>
                <strong id="detalleFechaVenta">—</strong>
            </div>

            <div>
                <span>Total</span>
                <strong id="detalleTotalVenta">—</strong>
            </div>

            <div class="dato-amplio-detalle-venta">
                <span>Productos</span>
                <strong id="detalleProductosVenta">—</strong>
            </div>

            <div class="dato-amplio-detalle-venta">
                <span>Estado actual</span>
                <strong id="detalleEstadoVenta">—</strong>
            </div>

        </div>


        <form asp-controller="Emprendedor"
              asp-action="ActualizarEstadoVenta"
              method="post"
              novalidate>

            @Html.AntiForgeryToken()

            <div asp-validation-summary="All"
                 class="resumen-validacion-emprendedor">
            </div>

            <input asp-for="IdVenta"
                   type="hidden"
                   id="idVentaSeleccionada" />

            <input asp-for="NumeroOrden"
                   type="hidden"
                   id="numeroOrdenSeleccionada" />


            <div class="grupo-campo-emprendedor">

                <label asp-for="NuevoEstado"></label>

                <select asp-for="NuevoEstado"
                        id="nuevoEstadoVenta"
                        class="control-emprendedor">

                    <option value="">
                        Seleccione un estado
                    </option>

                    <option value="Pendiente">
                        Pendiente
                    </option>

                    <option value="En preparación">
                        En preparación
                    </option>

                    <option value="Enviada">
                        Enviada
                    </option>

                    <option value="Entregada">
                        Entregada
                    </option>

                    <option value="Cancelada">
                        Cancelada
                    </option>

                </select>

                <span asp-validation-for="NuevoEstado"
                      class="mensaje-validacion-emprendedor">
                </span>

            </div>


            <div class="grupo-campo-emprendedor">

                <label asp-for="Observacion"></label>

                <textarea asp-for="Observacion"
                          class="control-emprendedor textarea-emprendedor"
                          rows="4"
                          maxlength="300"
                          placeholder="Agrega una observación relacionada con el cambio...">
                </textarea>

                <div class="ayuda-campo-emprendedor">
                    Campo opcional. Máximo 300 caracteres.
                </div>

                <span asp-validation-for="Observacion"
                      class="mensaje-validacion-emprendedor">
                </span>

            </div>


            <label class="confirmacion-cambio-venta">

                <input asp-for="ConfirmaCambio" />

                <span>
                    Confirmo que deseo actualizar el estado
                    de esta orden.
                </span>

            </label>

            <span asp-validation-for="ConfirmaCambio"
                  class="mensaje-validacion-emprendedor">
            </span>


            <div class="acciones-modal-venta">

                <button type="button"
                        id="cancelarCambioVenta"
                        class="boton-cancelar-cambio-venta">

                    Cerrar

                </button>

                <button type="submit"
                        class="boton-guardar-cambio-venta">

                    <i class="bi bi-check-circle-fill"></i>
                    Guardar estado

                </button>

            </div>

        </form>

    </div>

</div>


@section Scripts {

    <partial name="_ValidationScriptsPartial" />

    <script>
        document.addEventListener("DOMContentLoaded", () => {

            const buscador =
                document.getElementById("buscarVentaEmprendedor");

            const filtroEstado =
                document.getElementById("filtroEstadoVenta");

            const filtroFecha =
                document.getElementById("filtroFechaVenta");

            const botonLimpiar =
                document.getElementById("limpiarFiltrosVentas");

            const botonPendientes =
                document.getElementById("mostrarVentasPendientes");

            const ventas =
                document.querySelectorAll(".venta-filtrable");

            const mensajeSinVentas =
                document.getElementById("mensajeSinVentas");


            const filtrarVentas = () => {

                const texto =
                    buscador.value.trim().toLowerCase();

                const estado =
                    filtroEstado.value;

                const fecha =
                    filtroFecha.value;

                let visibles = 0;

                ventas.forEach((venta) => {

                    const orden =
                        venta.dataset.orden.toLowerCase();

                    const cliente =
                        venta.dataset.cliente.toLowerCase();

                    const estadoVenta =
                        venta.dataset.estado;

                    const fechaVenta =
                        venta.dataset.fecha;

                    const coincideTexto =
                        orden.includes(texto) ||
                        cliente.includes(texto);

                    const coincideEstado =
                        estado === "todos" ||
                        estadoVenta === estado;

                    const coincideFecha =
                        fecha === "todos" ||
                        fechaVenta === fecha ||
                        (
                            fecha === "mes" &&
                            ["hoy", "semana", "mes"]
                                .includes(fechaVenta)
                        ) ||
                        (
                            fecha === "semana" &&
                            ["hoy", "semana"]
                                .includes(fechaVenta)
                        );

                    const mostrar =
                        coincideTexto &&
                        coincideEstado &&
                        coincideFecha;

                    venta.style.display =
                        mostrar ? "" : "none";

                    if (mostrar) {
                        visibles++;
                    }
                });

                mensajeSinVentas.style.display =
                    visibles === 0
                        ? "flex"
                        : "none";
            };


            buscador?.addEventListener(
                "input",
                filtrarVentas
            );

            filtroEstado?.addEventListener(
                "change",
                filtrarVentas
            );

            filtroFecha?.addEventListener(
                "change",
                filtrarVentas
            );

            botonLimpiar?.addEventListener("click", () => {

                buscador.value = "";
                filtroEstado.value = "todos";
                filtroFecha.value = "todos";

                filtrarVentas();
            });

            botonPendientes?.addEventListener("click", () => {

                buscador.value = "";
                filtroFecha.value = "todos";
                filtroEstado.value = "pendiente";

                filtrarVentas();
            });


            const modal =
                document.getElementById("modalDetalleVenta");

            const fondo =
                document.getElementById("fondoModalDetalleVenta");

            const botonCerrar =
                document.getElementById("cerrarModalDetalleVenta");

            const botonCancelar =
                document.getElementById("cancelarCambioVenta");

            const botonesDetalle =
                document.querySelectorAll(".boton-ver-detalle-venta");

            const campoId =
                document.getElementById("idVentaSeleccionada");

            const campoOrden =
                document.getElementById("numeroOrdenSeleccionada");

            const detalleOrden =
                document.getElementById("detalleNumeroOrden");

            const detalleCliente =
                document.getElementById("detalleClienteVenta");

            const detalleCorreo =
                document.getElementById("detalleCorreoVenta");

            const detalleFecha =
                document.getElementById("detalleFechaVenta");

            const detalleTotal =
                document.getElementById("detalleTotalVenta");

            const detalleProductos =
                document.getElementById("detalleProductosVenta");

            const detalleEstado =
                document.getElementById("detalleEstadoVenta");

            const nuevoEstado =
                document.getElementById("nuevoEstadoVenta");


            const abrirModal = (boton) => {

                campoId.value =
                    boton.dataset.id;

                campoOrden.value =
                    boton.dataset.orden;

                detalleOrden.textContent =
                    boton.dataset.orden;

                detalleCliente.textContent =
                    boton.dataset.cliente;

                detalleCorreo.textContent =
                    boton.dataset.correo;

                detalleFecha.textContent =
                    boton.dataset.fecha;

                detalleTotal.textContent =
                    boton.dataset.total;

                detalleProductos.textContent =
                    boton.dataset.productos;

                detalleEstado.textContent =
                    boton.dataset.estado;

                nuevoEstado.value =
                    boton.dataset.estado;

                modal.classList.add("visible");

                modal.setAttribute(
                    "aria-hidden",
                    "false"
                );

                document.body.classList.add(
                    "modal-venta-abierto"
                );
            };


            const cerrarModal = () => {

                modal.classList.remove("visible");

                modal.setAttribute(
                    "aria-hidden",
                    "true"
                );

                document.body.classList.remove(
                    "modal-venta-abierto"
                );
            };


            botonesDetalle.forEach((boton) => {

                boton.addEventListener(
                    "click",
                    () => abrirModal(boton)
                );
            });

            botonCerrar?.addEventListener(
                "click",
                cerrarModal
            );

            botonCancelar?.addEventListener(
                "click",
                cerrarModal
            );

            fondo?.addEventListener(
                "click",
                cerrarModal
            );

            document.addEventListener("keydown", (evento) => {

                if (evento.key === "Escape") {
                    cerrarModal();
                }
            });


            if (modal?.classList.contains("visible")) {

                document.body.classList.add(
                    "modal-venta-abierto"
                );

                detalleOrden.textContent =
                    campoOrden?.value || "Orden";

                detalleCliente.textContent =
                    "Cliente seleccionado";

                detalleEstado.textContent =
                    nuevoEstado?.value || "Sin seleccionar";
            }
        });
    </script>
}