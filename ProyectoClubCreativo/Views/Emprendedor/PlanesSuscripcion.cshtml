@model ProyectoClubCreativo.Models.ViewModels.SeleccionPlanViewModel

@{
    ViewData["Title"] = "Planes de suscripción";
    Layout = "~/Views/Shared/_LayoutEmprendedor.cshtml";
}

<section class="cabecera-vista-emprendedor">

    <div>
        <span class="subtitulo-emprendedor">
            Suscripción
        </span>

        <h1>Planes para hacer crecer tu emprendimiento</h1>

        <p>
            Selecciona el plan que mejor se adapte a las necesidades
            de tu negocio y a la cantidad de productos que deseas publicar.
        </p>
    </div>

    <a asp-controller="Emprendedor"
       asp-action="MiSuscripcion"
       class="boton-volver-emprendedor">

        <i class="bi bi-credit-card"></i>
        Mi suscripción

    </a>

</section>


<section class="resumen-planes-emprendedor">

    <div class="contenido-resumen-planes">

        <span class="icono-resumen-planes">
            <i class="bi bi-gem"></i>
        </span>

        <div>
            <strong>Encuentra el plan ideal para tu negocio</strong>

            <p>
                Revisa las opciones disponibles y selecciona
                la que mejor se adapte a tu emprendimiento.
            </p>
        </div>

    </div>

    <div class="garantia-planes-emprendedor">

        <i class="bi bi-shield-check"></i>

        <span>
            Puedes cambiar o cancelar tu plan cuando lo necesites.
        </span>

    </div>

</section>


<form action="/Emprendedor/PlanesSuscripcion"
      method="post"
      class="formulario-planes-emprendedor"
      novalidate>

    @Html.AntiForgeryToken()

    <div asp-validation-summary="All"
     class="resumen-validacion-emprendedor">
 </div>

 @if (!ViewData.ModelState.IsValid)
{
    <div style="background:white; color:red; padding:15px; border:2px solid red; margin:15px 0;">
        <strong>ERRORES DE VALIDACIÓN:</strong>

        @foreach (var item in ViewData.ModelState)
        {
            foreach (var error in item.Value.Errors)
            {
                <p>
                    Campo: @item.Key |
                    Error: @(string.IsNullOrWhiteSpace(error.ErrorMessage)
                        ? error.Exception?.Message
                        : error.ErrorMessage)
                </p>
            }
        }
    </div>
}



    @if (Model.Planes.Count > 0)
    {
        <section class="grid-planes-suscripcion">

            @foreach (var plan in Model.Planes)
            {
                <label class="tarjeta-plan-emprendedor">

                    <input asp-for="IdPlanSeleccionado"
                           type="radio"
                           value="@plan.IdPlan"
                           class="selector-plan-oculto" />

                    <span class="indicador-seleccion-plan">
                        <i class="bi bi-check-lg"></i>
                    </span>


                    <div class="cabecera-plan-emprendedor">

                        <span class="icono-plan-suscripcion">
                            <i class="bi bi-gem"></i>
                        </span>

                        <span class="etiqueta-plan-suscripcion">
                            Plan disponible
                        </span>

                    </div>


                    <div class="nombre-plan-emprendedor">

                        <h2>@plan.Nombre</h2>

                        @if (!string.IsNullOrWhiteSpace(plan.Descripcion))
                        {
                            <p>
                                @plan.Descripcion
                            </p>
                        }

                    </div>


                    <div class="precio-plan-emprendedor">

                        @if (plan.Precio == 0)
                        {
                            <strong>Gratis</strong>
                        }
                        else
                        {
                            <strong>₡@plan.Precio.ToString("N0")</strong>
                        }

                        <span>
                            @plan.Periodicidad
                        </span>

                    </div>


                    @if (!string.IsNullOrWhiteSpace(plan.Beneficios))
                    {
                        <ul class="beneficios-plan-emprendedor">

                            @foreach (var beneficio in plan.Beneficios
                                .Split(
                                    new[] { '\r', '\n' },
                                    StringSplitOptions.RemoveEmptyEntries))
                            {
                                <li>
                                    <i class="bi bi-check-circle-fill"></i>
                                    @beneficio.Trim()
                                </li>
                            }

                        </ul>
                    }


                    <span class="boton-seleccionar-plan">
                        Seleccionar plan
                    </span>

                </label>
            }

        </section>


        <span asp-validation-for="IdPlanSeleccionado"
              class="mensaje-validacion-emprendedor validacion-plan-emprendedor">
        </span>

        @if (Model.Planes.Count >= 2)
{
    <div style="display:flex; justify-content:center; margin:28px 0;">
        <button type="button"
                id="botonCompararPlanes"
                class="boton-cancelar-formulario-emprendedor">
            <i class="bi bi-columns-gap"></i>
            Comparar planes
        </button>
    </div>

    <section id="comparacionPlanes"
             class="confirmacion-plan-emprendedor"
             style="display:none;">

        <div class="informacion-confirmacion-plan">

            <span class="icono-confirmacion-plan">
                <i class="bi bi-bar-chart"></i>
            </span>

            <div>
                <h2>Comparación de planes</h2>
                <p>
                    Compara las características de los planes disponibles
                    antes de seleccionar el que mejor se adapte a tu emprendimiento.
                </p>
            </div>

        </div>

        <div style="overflow-x:auto; margin-top:20px;">

            <table style="width:100%; border-collapse:collapse;">

                <thead>
                    <tr>
                        <th style="text-align:left; padding:14px;">
                            Característica
                        </th>

                        @foreach (var plan in Model.Planes)
                        {
                            <th style="text-align:center; padding:14px;">
                                @plan.Nombre
                            </th>
                        }
                    </tr>
                </thead>

                <tbody>

                    <tr>
                        <td style="padding:14px;">
                            <strong>Precio</strong>
                        </td>

                        @foreach (var plan in Model.Planes)
                        {
                            <td style="text-align:center; padding:14px;">
                                @if (plan.Precio == 0)
                                {
                                    <span>Gratis</span>
                                }
                                else
                                {
                                    <span>₡@plan.Precio.ToString("N0")</span>
                                }
                            </td>
                        }
                    </tr>

                    <tr>
                        <td style="padding:14px;">
                            <strong>Periodicidad</strong>
                        </td>

                        @foreach (var plan in Model.Planes)
                        {
                            <td style="text-align:center; padding:14px;">
                                @plan.Periodicidad
                            </td>
                        }
                    </tr>

                    <tr>
                        <td style="padding:14px;">
                            <strong>Descripción</strong>
                        </td>

                        @foreach (var plan in Model.Planes)
                        {
                            <td style="text-align:center; padding:14px;">
                                @(string.IsNullOrWhiteSpace(plan.Descripcion)
                                    ? "Sin descripción"
                                    : plan.Descripcion)
                            </td>
                        }
                    </tr>

                    <tr>
                        <td style="padding:14px; vertical-align:top;">
                            <strong>Beneficios</strong>
                        </td>

                        @foreach (var plan in Model.Planes)
                        {
                            <td style="padding:14px; vertical-align:top;">

                                @if (!string.IsNullOrWhiteSpace(plan.Beneficios))
                                {
                                    <ul style="margin:0; padding-left:20px;">

                                        @foreach (var beneficio in plan.Beneficios
                                            .Split(
                                                new[] { '\r', '\n' },
                                                StringSplitOptions.RemoveEmptyEntries))
                                        {
                                            <li style="margin-bottom:6px;">
                                                @beneficio.Trim()
                                            </li>
                                        }

                                    </ul>
                                }
                                else
                                {
                                    <span>Sin beneficios registrados</span>
                                }

                            </td>
                        }

                    </tr>

                </tbody>

            </table>

        </div>

    </section>
}

        <section class="confirmacion-plan-emprendedor">

            <div class="informacion-confirmacion-plan">

                <span class="icono-confirmacion-plan">
                    <i class="bi bi-shield-check"></i>
                </span>

                <div>
                    <h2>Confirma tu elección</h2>

                    <p>
                        Selecciona uno de los planes y confirma que deseas
                        continuar con la suscripción.
                    </p>
                </div>

            </div>


            <label class="casilla-confirmacion-plan">

                <input asp-for="ConfirmaSeleccion" />

                <span>
                    Confirmo que deseo seleccionar el plan indicado
                    y conozco sus beneficios.
                </span>

            </label>


            <span asp-validation-for="ConfirmaSeleccion"
                  class="mensaje-validacion-emprendedor">
            </span>

        </section>


        <div class="acciones-formulario-emprendedor">

            <a asp-controller="Emprendedor"
               asp-action="Panel"
               class="boton-cancelar-formulario-emprendedor">

                Cancelar

            </a>

            <button type="submit"
                    class="boton-guardar-formulario-emprendedor">

                <i class="bi bi-credit-card-fill"></i>
                Continuar con el plan

            </button>

        </div>
    }
    else
    {
        <section class="confirmacion-plan-emprendedor">

            <div class="informacion-confirmacion-plan">

                <span class="icono-confirmacion-plan">
                    <i class="bi bi-info-circle"></i>
                </span>

                <div>
                    <h2>No hay planes disponibles</h2>

                    <p>
                        En este momento no existen planes de suscripción
                        disponibles para nuevas suscripciones.
                    </p>
                </div>

            </div>

        </section>


        <div class="acciones-formulario-emprendedor">

            <a asp-controller="Emprendedor"
               asp-action="Panel"
               class="boton-cancelar-formulario-emprendedor">

                Volver al panel

            </a>

        </div>
    }

</form>


<section class="preguntas-planes-emprendedor">

    <div class="encabezado-preguntas-planes">

        <span class="subtitulo-emprendedor">
            Información
        </span>

        <h2>Preguntas frecuentes</h2>

    </div>


    <div class="grid-preguntas-planes">

        <article>
            <i class="bi bi-arrow-repeat"></i>

            <div>
                <h3>¿Puedo cambiar de plan?</h3>

                <p>
                    Sí. Puedes seleccionar otro plan desde la sección
                    Mi suscripción.
                </p>
            </div>
        </article>


        <article>
            <i class="bi bi-calendar-x"></i>

            <div>
                <h3>¿Puedo cancelar?</h3>

                <p>
                    Puedes solicitar la cancelación antes de la siguiente
                    fecha de renovación.
                </p>
            </div>
        </article>


        <article>
            <i class="bi bi-box-seam"></i>

            <div>
                <h3>¿Qué pasa con mis productos?</h3>

                <p>
                    Las condiciones relacionadas con los productos dependerán
                    del plan de suscripción seleccionado.
                </p>
            </div>
        </article>

    </div>

</section>


@section Scripts {
    <partial name="_ValidationScriptsPartial" />

    <script>
        document.addEventListener("DOMContentLoaded", function () {

            const botonComparar = document.getElementById("botonCompararPlanes");
            const comparacion = document.getElementById("comparacionPlanes");

            if (botonComparar && comparacion) {

                botonComparar.addEventListener("click", function () {

                    const estaOculta = comparacion.style.display === "none";

                    comparacion.style.display = estaOculta ? "block" : "none";

                    botonComparar.innerHTML = estaOculta
                        ? '<i class="bi bi-x-lg"></i> Ocultar comparación'
                        : '<i class="bi bi-columns-gap"></i> Comparar planes';

                    if (estaOculta) {
                        comparacion.scrollIntoView({
                            behavior: "smooth",
                            block: "start"
                        });
                    }
                });
            }
        });
    </script>
}