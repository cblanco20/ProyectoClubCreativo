@model ProyectoClubCreativo.Models.ViewModels.MiSuscripcionViewModel

@{
    ViewData["Title"] = "Mi suscripción";
    Layout = "~/Views/Shared/_LayoutEmprendedor.cshtml";
}

@if (TempData["MensajeSuscripcion"] is not null)
{
    <div class="mensaje-exito-emprendedor">
        <i class="bi bi-check-circle-fill"></i>
        @TempData["MensajeSuscripcion"]
    </div>
}

@if (TempData["MensajeError"] is not null)
{
    <div class="alert alert-danger" role="alert">
        <i class="bi bi-exclamation-circle-fill me-2"></i>
        @TempData["MensajeError"]
    </div>
}

<section class="cabecera-vista-emprendedor">

    <div>
        <span class="subtitulo-emprendedor">
            Suscripción
        </span>

        <h1>Mi suscripción</h1>

        <p>
            Consulta el plan actual de tu emprendimiento,
            sus beneficios, fechas y opciones de administración.
        </p>
    </div>

    <a asp-controller="Emprendedor"
       asp-action="PlanesSuscripcion"
       class="boton-editar-perfil-emprendedor">

        <i class="bi bi-arrow-repeat"></i>
        Cambiar plan

    </a>

</section>

@if (!Model.TieneSuscripcion)
{
    <article class="bloque-suscripcion-emprendedor">

        <div class="encabezado-bloque-suscripcion">
            <div>
                <span class="subtitulo-emprendedor">
                    Suscripción
                </span>

                <h2>No tienes una suscripción activa</h2>

                <p>
                    Tu suscripción anterior ha finalizado.
                    Puedes seleccionar un plan para volver a disfrutar
                    de los beneficios.
                </p>
            </div>
        </div>

        <a asp-controller="Emprendedor"
           asp-action="PlanesSuscripcion"
           class="boton-guardar-formulario-emprendedor">

            <i class="bi bi-arrow-repeat"></i>
            Ver planes disponibles
        </a>

    </article>
}
else
{
<!-- PLAN ACTUAL -->
<section class="tarjeta-plan-actual-emprendedor">

    <div class="decoracion-plan-actual decoracion-uno"></div>
    <div class="decoracion-plan-actual decoracion-dos"></div>

    <div class="contenido-plan-actual">

        <div class="cabecera-plan-actual">

            <span class="icono-plan-actual">
                <i class="bi bi-rocket-takeoff-fill"></i>
            </span>

            <div>
                <span class="etiqueta-plan-actual">
                    Plan actual
                </span>

                <h2>@Model.NombrePlan</h2>

                @if (!string.IsNullOrWhiteSpace(Model.DescripcionPlan))
                {
                    <p>@Model.DescripcionPlan</p>
                }
                else
                {
                    <p>
                        Consulta los beneficios disponibles
                        en tu plan de suscripción.
                    </p>
                }

            </div>

        </div>

        <div class="precio-plan-actual">

            @if (Model.Precio == 0)
            {
                <strong>Gratis</strong>
            }
            else
            {
                <strong>₡@Model.Precio.ToString("N0")</strong>
            }

            <span>@Model.Periodicidad</span>

        </div>

    </div>

    <div class="estado-plan-actual">

        <span class="insignia-suscripcion-activa">
            <i class="bi bi-check-circle-fill"></i>
            @Model.Estado
        </span>

        <a asp-controller="Emprendedor"
           asp-action="PlanesSuscripcion">

            Ver otros planes
            <i class="bi bi-arrow-right"></i>

        </a>

    </div>

</section>


<!-- RESUMEN -->
<section class="resumen-mi-suscripcion">

    <article class="tarjeta-dato-suscripcion">

        <span class="icono-dato-suscripcion inicio">
            <i class="bi bi-calendar-check-fill"></i>
        </span>

        <div>
            <span>Fecha de inicio</span>
            <strong>
                @(Model.FechaInicio?.ToString("dd/MM/yyyy") ?? "Sin fecha")
            </strong>
        </div>

    </article>


    <article class="tarjeta-dato-suscripcion renovacion">

        <span class="icono-dato-suscripcion renovacion">
            <i class="bi bi-arrow-clockwise"></i>
        </span>

        <div>
            <span>Fecha de vencimiento</span>
            <strong>
                @(Model.FechaFin?.ToString("dd/MM/yyyy") ?? "Sin fecha")
            </strong>
        </div>

    </article>


    
        <article class="tarjeta-dato-suscripcion">

            <span class="icono-dato-suscripcion metodo">
                <i class="bi bi-phone-fill"></i>
            </span>

            <div>
                <span>Método de pago</span>
                <strong>SINPE Móvil</strong>
            </div>

        </article>


    <article class="tarjeta-dato-suscripcion">

        <span class="icono-dato-suscripcion estado">
            <i class="bi bi-shield-check"></i>
        </span>

        <div>
            <span>Estado</span>
            <strong>@Model.Estado</strong>
        </div>

    </article>

</section>

}
@if (Model.TienePlanProgramado)
{
    <article class="bloque-suscripcion-emprendedor mb-4">

        <div class="encabezado-bloque-suscripcion">
            <div>
                <span class="subtitulo-emprendedor">
                    Próxima suscripción
                </span>

                <h2>Plan programado</h2>

                <p>
                    Tu pago SINPE Móvil fue aprobado.
                    El siguiente período se activará
                    cuando llegue la fecha programada.
                </p>
            </div>
        </div>

        <div class="detalle-renovacion-suscripcion">

            <div>
                <span>Próximo plan</span>
                <strong>@Model.NombrePlanProgramado</strong>
            </div>

            <div>
                <span>Fecha de inicio</span>
                <strong>
                    @(Model.FechaInicioPlanProgramado?.ToString("dd/MM/yyyy"))
                </strong>
            </div>

            <div>
                <span>Fecha de vencimiento</span>
                <strong>
                    @(Model.FechaFinPlanProgramado?.ToString("dd/MM/yyyy"))
                </strong>
            </div>

            <div>
                <span>Estado</span>
                <strong>Pendiente de activación</strong>
            </div>

        </div>

    </article>
}
<!-- CONTENIDO -->
<section class="grid-mi-suscripcion">

    <div class="columna-principal-suscripcion">

@if (Model.TieneSuscripcion)
{

        <!-- BENEFICIOS -->
<section class="beneficios-mi-suscripcion">

    <div class="encabezado-seccion-suscripcion">

        <span class="subtitulo-emprendedor">
            Beneficios
        </span>

        <h2>Incluido en tu plan</h2>

        <p>
            Estos son los beneficios disponibles actualmente
            para tu emprendimiento.
        </p>

    </div>

    @if (!string.IsNullOrWhiteSpace(Model.Beneficios))
    {
        <div class="grid-beneficios-suscripcion">

            @foreach (var beneficio in Model.Beneficios.Split(
                new[] { '\r', '\n' },
                StringSplitOptions.RemoveEmptyEntries))
            {
                <article class="beneficio-suscripcion">

                    <span class="icono-beneficio-suscripcion">
                        <i class="bi bi-check-circle-fill"></i>
                    </span>

                    <div>
                        <strong>@beneficio.Trim()</strong>
                    </div>

                    <i class="bi bi-check-circle-fill check-beneficio-suscripcion"></i>

                </article>
            }

        </div>
    }
    else
    {
        <p>
            Este plan no tiene beneficios adicionales registrados.
        </p>
    }

</section>

        }

        <!-- SOLICITUDES DE PAGO SINPE -->
        <article class="bloque-suscripcion-emprendedor">

            <div class="encabezado-bloque-suscripcion">
                <div>
                    <span class="subtitulo-emprendedor">
                        Pagos SINPE Móvil
                    </span>

                    <h2>Mis solicitudes de pago</h2>

                    <p>
                        Consulta las transferencias registradas
                        y el estado de revisión de cada solicitud.
                    </p>
                </div>
            </div>

            <div class="tabla-historial-suscripcion">

                <div class="fila-historial-suscripcion encabezado-historial">
                    <span>Fecha</span>
                    <span>Plan solicitado</span>
                    <span>Monto</span>
                    <span>Estado</span>
                </div>

                @if (Model.SolicitudesSinpe.Any())
                {
                    @foreach (var solicitud in Model.SolicitudesSinpe)
                    {
                        <div class="fila-historial-suscripcion">

                            <span>
                                @solicitud.FechaSolicitud.ToString("dd/MM/yyyy")
                            </span>

                            <span>
                                @solicitud.NombrePlan
                            </span>

                            <span>
                                ₡@solicitud.Monto.ToString("N0")
                            </span>

                            <span>
                                @if (solicitud.Estado == "Aprobada")
                                {
                                    <span class="estado-pago-suscripcion completado">
                                        Aprobada
                                    </span>
                                }
                                else if (solicitud.Estado == "Rechazada")
                                {
                                    <span class="badge bg-danger">
                                        Rechazada
                                    </span>
                                }
                                else
                                {
                                    <span class="badge bg-warning text-dark">
                                        Pendiente
                                    </span>
                                }
                            </span>

                        </div>

                        <div class="mb-3 p-3 border-bottom">
                            <p class="mb-1">
                                <strong>Referencia SINPE:</strong>
                                @solicitud.NumeroReferencia
                            </p>

                            @if (solicitud.FechaRevision.HasValue)
                            {
                                <p class="mb-1">
                                    <strong>Fecha de revisión:</strong>
                                    @solicitud.FechaRevision.Value.ToString("dd/MM/yyyy")
                                </p>
                            }

                            @if (!string.IsNullOrWhiteSpace(solicitud.Observaciones))
                            {
                                <p class="mb-0">
                                    <strong>Observaciones:</strong>
                                    @solicitud.Observaciones
                                </p>
                            }

                            @if (solicitud.Estado == "Pendiente")
                            {
                                <p class="text-muted mt-2 mb-0">
                                    Tu transferencia está pendiente
                                    de verificación administrativa.
                                </p>
                            }
                        </div>
                    }
                }
                else
                {
                    <div class="fila-historial-suscripcion">
                        <span>—</span>
                        <span>No tienes solicitudes SINPE registradas.</span>
                        <span>—</span>
                        <span>—</span>
                    </div>
                }

            </div>

        </article>



        <!-- HISTORIAL -->
        <article class="bloque-suscripcion-emprendedor">

            <div class="encabezado-bloque-suscripcion">

                <div>
                    <span class="subtitulo-emprendedor">
                        Historial
                    </span>

                    <h2>Movimientos de la suscripción</h2>
                </div>

            </div>

            <div class="tabla-historial-suscripcion">

                <div class="fila-historial-suscripcion encabezado-historial">
                    <span>Fecha</span>
                    <span>Descripción</span>
                    <span>Monto</span>
                    <span>Estado</span>
                </div>

                @if (Model.Historial.Any())
                {
                    @foreach (var movimiento in Model.Historial)
                    {
                        <div class="fila-historial-suscripcion">

                            <span>
                                @movimiento.Fecha.ToString("dd/MM/yyyy")
                            </span>

                            <span>
                                @movimiento.Descripcion
                            </span>

                            <span>
                                @if (movimiento.Monto == 0)
                                {
                                    <text>Sin pago registrado</text>
                                }
                                else
                                {
                                    <text>₡@movimiento.Monto.ToString("N0")</text>
                                }
                            </span>

                            <span class="estado-pago-suscripcion completado">
                                @movimiento.Estado
                            </span>

                        </div>
                    }
                }
                else
                {
                    <div class="fila-historial-suscripcion">

                        <span>—</span>
                        <span>No hay movimientos registrados.</span>
                        <span>—</span>
                        <span>—</span>

                    </div>
                }

            </div>

        </article>

    </div>


    <!-- COLUMNA LATERAL -->
    <aside class="columna-lateral-suscripcion">

        @if (Model.TieneSuscripcion)
{

            <!-- RENOVACIÓN MANUAL -->
            <article class="bloque-suscripcion-emprendedor">

                <div class="encabezado-bloque-suscripcion">
                    <div>
                        <span class="subtitulo-emprendedor">
                            Renovación
                        </span>

                        <h2>Renovar mi suscripción</h2>
                    </div>
                </div>

                <div class="estado-renovacion-suscripcion">

                    <span class="icono-renovacion-activa">
                        <i class="bi bi-arrow-repeat"></i>
                    </span>

                    <div>
                        <strong>Renovación mediante SINPE Móvil</strong>

                        <p>
                            Tu plan permanecerá activo hasta el
                            @(Model.FechaFin?.ToString("dd/MM/yyyy") ?? "final del período").
                            Si deseas continuar, deberás solicitar
                            una renovación y realizar un nuevo pago SINPE Móvil.
                        </p>
                    </div>

                </div>

                <div class="detalle-renovacion-suscripcion">

                    <div>
                        <span>Monto del plan</span>

                        @if (Model.Precio == 0)
                        {
                            <strong>Gratis</strong>
                        }
                        else
                        {
                            <strong>₡@Model.Precio.ToString("N0")</strong>
                        }
                    </div>

                    <div>
                        <span>Fecha de vencimiento</span>

                        <strong>
                            @(Model.FechaFin?.ToString("dd/MM/yyyy") ?? "Sin fecha")
                        </strong>
                    </div>

                </div>

                @{
                    int diasRestantes = Model.FechaFin.HasValue
                        ? Model.FechaFin.Value.DayNumber -
                          DateOnly.FromDateTime(DateTime.Today).DayNumber
                        : int.MaxValue;
                }

                @if (Model.TieneCancelacionProgramada)
                {
                    <p class="text-muted mt-3">
                        Esta suscripción tiene una cancelación registrada.
                        No puedes solicitar su renovación.
                    </p>
                }
                else if (diasRestantes >= 0 && diasRestantes <= 3)
                {
                    <form asp-controller="Emprendedor"
                          asp-action="RenovarSuscripcion"
                          method="post">

                        @Html.AntiForgeryToken()

                        <button type="submit"
                                class="boton-renovacion-suscripcion">

                            <i class="bi bi-arrow-repeat"></i>
                            Solicitar renovación por SINPE

                        </button>

                    </form>
                }
                else
                {
                    <p class="text-muted mt-3">
                        Podrás solicitar la renovación cuando falten
                        3 días o menos para el vencimiento de tu plan.
                    </p>
                }

            </article>
        }


        <!-- CAMBIAR PLAN -->
        <article class="cambiar-plan-suscripcion">

            <span class="icono-cambiar-plan">
                <i class="bi bi-gem"></i>
            </span>

            <div>
                <span class="subtitulo-emprendedor">
                    Más beneficios
                </span>

                <h2>Mejora tu suscripción</h2>

                <p>
                    Obtén publicaciones ilimitadas, acceso a Hecho en CR
                    y participación prioritaria en eventos.
                </p>

                <a asp-controller="Emprendedor"
                   asp-action="PlanesSuscripcion">

                    Comparar planes
                    <i class="bi bi-arrow-right"></i>

                </a>
            </div>

        </article>

        @if (Model.TieneSuscripcion)
{
        <!-- CANCELACIÓN -->
        <article class="bloque-suscripcion-emprendedor bloque-cancelacion-suscripcion">

            <div class="encabezado-bloque-suscripcion">

                <div>
                    <span class="subtitulo-emprendedor">
                        Administración
                    </span>

                    @if (Model.TieneCancelacionProgramada)
                    {
                        <h2>Cancelación programada</h2>

                            <p>
                                Tu cancelación fue registrada correctamente.
                                Conservarás los beneficios de tu plan hasta el
                                @(Model.FechaFin?.ToString("dd/MM/yyyy") ?? "final del período").
                            </p>
                    }
                    else
                    {
                        <h2>Cancelar suscripción</h2>

                        <p>
                            El plan continuará activo hasta finalizar
                            el período actual.
                        </p>
                    }
                </div>

            </div>

            @if (Model.TieneCancelacionProgramada)
            {
                <p class="text-muted mt-2">
                    No se realizarán renovaciones automáticas.
                    Para contratar otro período deberás realizar
                    una nueva solicitud de pago.
                </p>
            }
            else
            {
                <button type="button"
                        id="abrirCancelacionSuscripcion"
                        class="boton-abrir-cancelacion">

                    <i class="bi bi-x-circle"></i>
                    Solicitar cancelación

                </button>
            }

        </article>

        }


        <!-- SOPORTE -->
        <article class="soporte-suscripcion-emprendedor">

            <span>
                <i class="bi bi-headset"></i>
            </span>

            <div>
                <h2>¿Necesitas ayuda?</h2>

                <p>
                    Comunícate con nuestro equipo para resolver
                    dudas relacionadas con tu plan.
                </p>

                <a asp-controller="Home"
                   asp-action="Contacto">

                    Contactar soporte
                    <i class="bi bi-arrow-right"></i>

                </a>
            </div>

        </article>

    </aside>

</section>


<!-- MODAL DE CANCELACIÓN -->
<div id="modalCancelacionSuscripcion"
     class="modal-cancelacion-suscripcion"
     aria-hidden="true">

    <div class="fondo-modal-cancelacion"
         id="fondoCancelacionSuscripcion">
    </div>

    <div class="contenido-modal-cancelacion"
         role="dialog"
         aria-modal="true"
         aria-labelledby="tituloCancelacionSuscripcion">

        <button type="button"
                id="cerrarCancelacionSuscripcion"
                class="cerrar-modal-cancelacion"
                aria-label="Cerrar">

            <i class="bi bi-x-lg"></i>

        </button>

        <span class="icono-modal-cancelacion">
            <i class="bi bi-exclamation-triangle-fill"></i>
        </span>

        <h2 id="tituloCancelacionSuscripcion">
            Cancelar suscripción
        </h2>

        <p>
            Al cancelar, conservarás los beneficios de tu plan
            hasta finalizar el período contratado.
            Después de esa fecha, necesitarás adquirir
            una nueva suscripción para continuar
            publicando productos o servicios.
        </p>

        <form asp-controller="Emprendedor"
              asp-action="CancelarSuscripcion"
              method="post"
              novalidate>

            @Html.AntiForgeryToken()

            <div asp-validation-summary="All"
                 class="resumen-validacion-emprendedor">
            </div>

            <div class="grupo-campo-emprendedor">

                <label asp-for="MotivoCancelacion"></label>

                <textarea asp-for="MotivoCancelacion"
                          class="control-emprendedor textarea-emprendedor"
                          rows="4"
                          maxlength="400"
                          placeholder="Puedes contarnos el motivo de la cancelación...">
                </textarea>

                <span asp-validation-for="MotivoCancelacion"
                      class="mensaje-validacion-emprendedor">
                </span>

            </div>

            <label class="confirmacion-cancelacion-suscripcion">

                <input asp-for="ConfirmaCancelacion" />

                <span>
                    Confirmo que deseo cancelar la suscripción
                    al finalizar el período actual.
                </span>

            </label>

            <span asp-validation-for="ConfirmaCancelacion"
                  class="mensaje-validacion-emprendedor">
            </span>

            <div class="acciones-modal-cancelacion">

                <button type="button"
                        id="cancelarModalSuscripcion"
                        class="boton-mantener-suscripcion">

                    Mantener suscripción

                </button>

                <button type="submit"
                        class="boton-confirmar-cancelacion">

                    Confirmar cancelación

                </button>

            </div>

        </form>

    </div>

</div>


@section Scripts {

    <partial name="_ValidationScriptsPartial" />

    <script>
        document.addEventListener("DOMContentLoaded", () => {

            const botonAbrir =
                document.getElementById(
                    "abrirCancelacionSuscripcion"
                );

            const botonCerrar =
                document.getElementById(
                    "cerrarCancelacionSuscripcion"
                );

            const botonCancelar =
                document.getElementById(
                    "cancelarModalSuscripcion"
                );

            const fondo =
                document.getElementById(
                    "fondoCancelacionSuscripcion"
                );

            const modal =
                document.getElementById(
                    "modalCancelacionSuscripcion"
                );

            const abrirModal = () => {

                modal?.classList.add("visible");

                modal?.setAttribute(
                    "aria-hidden",
                    "false"
                );

                document.body.classList.add(
                    "modal-suscripcion-abierto"
                );
            };

            const cerrarModal = () => {

                modal?.classList.remove("visible");

                modal?.setAttribute(
                    "aria-hidden",
                    "true"
                );

                document.body.classList.remove(
                    "modal-suscripcion-abierto"
                );
            };

            botonAbrir?.addEventListener(
                "click",
                abrirModal
            );

            botonCerrar?.addEventListener(
                "click",
                cerrarModal
            );

            botonCancelar?.addEventListener(
                "click",
                cerrarModal
            );

            fondo?.addEventListener(
                "click",
                cerrarModal
            );

            document.addEventListener(
                "keydown",
                (evento) => {

                    if (evento.key === "Escape") {
                        cerrarModal();
                    }
                }
            );

            const hayErrores =
                document.querySelector(
                    ".contenido-modal-cancelacion .validation-summary-errors"
                ) !== null ||
                document.querySelector(
                    ".contenido-modal-cancelacion .field-validation-error"
                ) !== null;

            if (hayErrores) {
                abrirModal();
            }
        });
    </script>
}