@model ProyectoClubCreativo.Models.ViewModels.EstadoSolicitudViewModel

@{
    ViewData["Title"] = "Estado de la solicitud";
    Layout = "~/Views/Shared/_LayoutEmprendedor.cshtml";

    (string claseEstado, string iconoEstado, string tituloEstado, string descripcionEstado) = Model.Estado switch
    {
        "Aprobado" => (
            "aprobado",
            "bi-check-circle-fill",
            "Solicitud aprobada",
            "¡Felicidades! Tu emprendimiento fue aprobado y ya forma parte de Club Creativo MiVo."
        ),
        "Rechazado" => (
            "rechazado",
            "bi-x-circle-fill",
            "Solicitud rechazada",
            "Tu solicitud no fue aprobada. Revisa el motivo indicado y corrige la información para volver a enviarla."
        ),
        _ => (
            "pendiente",
            "bi-hourglass-split",
            "Pendiente de revisión",
            "Tu solicitud fue recibida correctamente. El equipo de Club Creativo MiVo está revisando la información enviada."
        )
    };

    bool solicitudResuelta = Model.Estado is "Aprobado" or "Rechazado";
}

@if (TempData["MensajeSolicitud"] is not null)
{
    <div class="mensaje-exito-emprendedor">
        <i class="bi bi-check-circle-fill"></i>
        @TempData["MensajeSolicitud"]
    </div>
}

<section class="cabecera-vista-emprendedor">

    <div>
        <span class="subtitulo-emprendedor">
            Solicitud de emprendimiento
        </span>

        <h1>Estado de la solicitud</h1>

        <p>
            Consulta el avance de la solicitud enviada para registrar
            tu emprendimiento en Club Creativo MiVo.
        </p>
    </div>

    <a asp-controller="Emprendedor"
       asp-action="Panel"
       class="boton-volver-emprendedor">

        <i class="bi bi-arrow-left"></i>
        Volver al panel

    </a>

</section>


<section class="resumen-estado-solicitud">

    <article class="tarjeta-estado-principal">

        <div class="icono-estado-principal estado-@claseEstado">
            <i class="bi @iconoEstado"></i>
        </div>

        <div class="contenido-estado-principal">

            <span class="etiqueta-estado-solicitud">
                Estado actual
            </span>

            <h2>@tituloEstado</h2>

            <p>
                @descripcionEstado
            </p>

            @if (Model.FechaSolicitud.HasValue)
            {
                <div class="fecha-estado-solicitud">
                    <i class="bi bi-calendar-check"></i>
                    Solicitud enviada el @Model.FechaSolicitud.Value.ToString("d 'de' MMMM 'de' yyyy", new System.Globalization.CultureInfo("es-CR"))
                </div>
            }

            @if (solicitudResuelta && Model.FechaResolucion.HasValue)
            {
                <div class="fecha-estado-solicitud">
                    <i class="bi bi-calendar-event"></i>
                    Resuelta el @Model.FechaResolucion.Value.ToString("d 'de' MMMM 'de' yyyy", new System.Globalization.CultureInfo("es-CR"))
                </div>
            }

        </div>

        <span class="insignia-estado-solicitud @claseEstado">
            @Model.Estado
        </span>

    </article>

</section>


@if (Model.Estado == "Rechazado" && !string.IsNullOrWhiteSpace(Model.MotivoRechazo))
{
    <section class="aviso-edicion-emprendimiento">

        <span class="icono-aviso-edicion">
            <i class="bi bi-exclamation-triangle-fill"></i>
        </span>

        <div>
            <strong>Motivo del rechazo</strong>
            <p>@Model.MotivoRechazo</p>
        </div>

    </section>
}


<section class="grid-estado-solicitud">

    <div class="columna-estado-principal">

        <article class="bloque-estado-solicitud">

            <div class="encabezado-bloque-estado">

                <div>
                    <span class="subtitulo-emprendedor">
                        Seguimiento
                    </span>

                    <h2>Proceso de revisión</h2>
                </div>

            </div>

            <div class="linea-tiempo-solicitud">

                <div class="paso-solicitud completado">

                    <span class="circulo-paso-solicitud">
                        <i class="bi bi-check-lg"></i>
                    </span>

                    <div>
                        <strong>Solicitud enviada</strong>

                        <p>
                            La información fue recibida correctamente.
                        </p>

                        <span>
                            @(Model.FechaSolicitud.HasValue
                                ? Model.FechaSolicitud.Value.ToString("d 'de' MMMM 'de' yyyy", new System.Globalization.CultureInfo("es-CR"))
                                : "—")
                        </span>
                    </div>

                </div>

                <div class="paso-solicitud @(solicitudResuelta ? "completado" : "activo")">

                    <span class="circulo-paso-solicitud">
                        <i class="bi bi-search"></i>
                    </span>

                    <div>
                        <strong>Revisión de información</strong>

                        <p>
                            El equipo está validando los datos del emprendimiento.
                        </p>

                        <span>@(solicitudResuelta ? "Completado" : "En proceso")</span>
                    </div>

                </div>

                <div class="paso-solicitud @(solicitudResuelta ? "completado" : "")">

                    <span class="circulo-paso-solicitud">
                        <i class="bi bi-file-earmark-check"></i>
                    </span>

                    <div>
                        <strong>Resultado de la solicitud</strong>

                        <p>
                            @(solicitudResuelta
                                ? $"Tu solicitud fue {Model.Estado.ToLowerInvariant()}."
                                : "Recibirás una notificación por correo cuando finalice la revisión.")
                        </p>

                        <span>@(solicitudResuelta ? Model.Estado : "Pendiente")</span>
                    </div>

                </div>

                <div class="paso-solicitud @(Model.Estado == "Aprobado" ? "completado" : "")">

                    <span class="circulo-paso-solicitud">
                        <i class="bi bi-shop-window"></i>
                    </span>

                    <div>
                        <strong>Publicación del emprendimiento</strong>

                        <p>
                            @(Model.Estado == "Aprobado"
                                ? "Tu perfil ya está publicado en la plataforma."
                                : "El perfil será publicado después de su aprobación.")
                        </p>

                        <span>@(Model.Estado == "Aprobado" ? "Publicado" : "Pendiente")</span>
                    </div>

                </div>

            </div>

        </article>


        <article class="bloque-estado-solicitud">

            <div class="encabezado-bloque-estado">

                <div>
                    <span class="subtitulo-emprendedor">
                        Información enviada
                    </span>

                    <h2>Resumen de la solicitud</h2>
                </div>

                <a asp-controller="Emprendedor"
                   asp-action="EditarEmprendimiento"
                   class="enlace-editar-solicitud">

                    <i class="bi bi-pencil-square"></i>
                    Corregir información

                </a>

            </div>

            <div class="grid-datos-solicitud">

                <div class="dato-solicitud">
                    <span>Nombre comercial</span>
                    <strong>@Model.NombreComercial</strong>
                </div>

                <div class="dato-solicitud">
                    <span>Categoría</span>
                    <strong>@Model.Categoria</strong>
                </div>

                <div class="dato-solicitud">
                    <span>Correo</span>
                    <strong>@Model.Correo</strong>
                </div>

                <div class="dato-solicitud">
                    <span>Teléfono</span>
                    <strong>@(string.IsNullOrWhiteSpace(Model.Telefono) ? "—" : Model.Telefono)</strong>
                </div>

                <div class="dato-solicitud dato-solicitud-amplio">
                    <span>Sitio web o red social</span>

                    <strong>
                        @(string.IsNullOrWhiteSpace(Model.SitioWeb) ? "No indicado" : Model.SitioWeb)
                    </strong>
                </div>

                <div class="dato-solicitud dato-solicitud-amplio">
                    <span>Descripción</span>

                    <strong>
                        @Model.Descripcion
                    </strong>
                </div>

            </div>

        </article>

    </div>


    <aside class="columna-estado-secundaria">

        <article class="bloque-estado-solicitud ayuda-estado-solicitud">

            <div class="icono-ayuda-solicitud">
                <i class="bi bi-info-circle-fill"></i>
            </div>

            <h2>¿Qué sucede ahora?</h2>

            <p>
                La revisión puede tardar algunos días. Recibirás una
                notificación por correo cuando exista un cambio en el estado.
            </p>

            <ul>
                <li>
                    <i class="bi bi-check-circle-fill"></i>
                    Verificación de datos personales.
                </li>

                <li>
                    <i class="bi bi-check-circle-fill"></i>
                    Revisión de la información comercial.
                </li>

                <li>
                    <i class="bi bi-check-circle-fill"></i>
                    Validación de la categoría seleccionada.
                </li>

                <li>
                    <i class="bi bi-check-circle-fill"></i>
                    Revisión de términos aceptados.
                </li>
            </ul>

        </article>


        <article class="bloque-estado-solicitud estados-posibles">

            <div class="encabezado-bloque-estado">

                <div>
                    <span class="subtitulo-emprendedor">
                        Estados
                    </span>

                    <h2>Posibles resultados</h2>
                </div>

            </div>

            <div class="estado-posible-item">

                <span class="icono-estado-posible pendiente">
                    <i class="bi bi-hourglass-split"></i>
                </span>

                <div>
                    <strong>Pendiente</strong>

                    <p>
                        La solicitud todavía se encuentra en revisión.
                    </p>
                </div>

            </div>

            <div class="estado-posible-item">

                <span class="icono-estado-posible aprobado">
                    <i class="bi bi-check-circle-fill"></i>
                </span>

                <div>
                    <strong>Aprobada</strong>

                    <p>
                        El emprendimiento puede publicarse y administrarse.
                    </p>
                </div>

            </div>

            <div class="estado-posible-item">

                <span class="icono-estado-posible rechazado">
                    <i class="bi bi-x-circle-fill"></i>
                </span>

                <div>
                    <strong>Rechazada</strong>

                    <p>
                        Se mostrará el motivo y podrás corregir la información.
                    </p>
                </div>

            </div>

        </article>


        <article class="bloque-estado-solicitud contacto-estado-solicitud">

            <div class="icono-contacto-solicitud">
                <i class="bi bi-headset"></i>
            </div>

            <div>
                <h2>¿Necesitas ayuda?</h2>

                <p>
                    Comunícate con nuestro equipo si tienes dudas
                    sobre el proceso de revisión.
                </p>

                <a asp-controller="Home"
                   asp-action="Contacto">

                    Ir a contacto
                    <i class="bi bi-arrow-right"></i>

                </a>
            </div>

        </article>

    </aside>

</section>


<section class="acciones-estado-solicitud">

    <div>
        <h2>Mantén actualizada tu información</h2>

        <p>
            Puedes revisar o corregir los datos de tu emprendimiento
            cuando lo necesites.
        </p>
    </div>

    <div class="botones-estado-solicitud">

        <a asp-controller="Emprendedor"
           asp-action="EditarEmprendimiento"
           class="boton-secundario-estado">

            <i class="bi bi-pencil-square"></i>
            Corregir solicitud

        </a>

        <a asp-controller="Emprendedor"
           asp-action="Panel"
           class="boton-principal-estado">

            <i class="bi bi-grid-fill"></i>
            Volver al panel

        </a>

    </div>

</section>
