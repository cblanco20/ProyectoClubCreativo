        </div>


        <div id="mensajeSinProductosEstadisticas"
             class="mensaje-sin-productos-estadisticas">

            <i class="bi bi-bar-chart"></i>

            <h2>No se encontraron productos</h2>

            <p>
                Utiliza otro término de búsqueda.
            </p>

        </div>

    </div>

</section>


<!-- RECOMENDACIONES -->
<section class="recomendaciones-estadisticas-emprendedor">

    <div class="encabezado-recomendaciones-estadisticas">

        <span class="icono-recomendaciones-estadisticas">
            <i class="bi bi-lightbulb-fill"></i>
        </span>

        <div>
            <span class="subtitulo-emprendedor">
                Recomendaciones
            </span>

            <h2>Oportunidades para mejorar</h2>

            <p>
                Acciones sugeridas según el rendimiento del emprendimiento.
            </p>
        </div>

    </div>


    <div class="grid-recomendaciones-estadisticas">

        <article>

            <span class="numero-recomendacion-estadistica">
                01
            </span>

            <div>
                <h3>Actualiza el inventario</h3>

                <p>
                    Tus dos productos más vendidos tienen pocas
                    existencias disponibles.
                </p>

                <a asp-controller="Emprendedor"
                   asp-action="Inventario">

                    Revisar inventario
                    <i class="bi bi-arrow-right"></i>

                </a>
            </div>

        </article>


        <article>

            <span class="numero-recomendacion-estadistica">
                02
            </span>

            <div>
                <h3>Destaca tus mejores productos</h3>

                <p>
                    Los aretes artesanales generan la mayor cantidad
                    de visitas y conversiones.
                </p>

                <a asp-controller="Emprendedor"
                   asp-action="MisProductos">

                    Administrar productos
                    <i class="bi bi-arrow-right"></i>

                </a>
            </div>

        </article>


        <article>

            <span class="numero-recomendacion-estadistica">
                03
            </span>

            <div>
                <h3>Participa en próximos eventos</h3>

                <p>
                    Los eventos pueden aumentar la visibilidad
                    y las visitas al perfil.
                </p>

                <a asp-controller="Emprendedor"
                   asp-action="ParticipacionEventos">

                    Ver eventos
                    <i class="bi bi-arrow-right"></i>

                </a>
            </div>

        </article>

    </div>

</section>


@section Scripts {

    <script>
        document.addEventListener("DOMContentLoaded", () => {

            const selectorPeriodo =
                document.getElementById("periodoEstadisticas");

            const botonActualizar =
                document.getElementById(
                    "botonActualizarEstadisticas"
                );

            const mensajeActualizacion =
                document.getElementById(
                    "mensajeActualizacionEstadisticas"
                );

            const descripcionPeriodo =
                document.getElementById(
                    "descripcionPeriodoVentas"
                );


            const valoresPorPeriodo = {

                "7": {
                    ventas: "₡42.500",
                    ordenes: "4",
                    visitas: "326",
                    favoritos: "11",
                    conversion: "4,1 %",
                    promedio: "₡10.625",
                    descripcion:
                        "Ingresos obtenidos durante los últimos 7 días."
                },

                "30": {
                    ventas: "₡145.000",
                    ordenes: "12",
                    visitas: "1.248",
                    favoritos: "36",
                    conversion: "3,9 %",
                    promedio: "₡12.083",
                    descripcion:
                        "Ingresos obtenidos durante los últimos 30 días."
                },

                "90": {
                    ventas: "₡426.500",
                    ordenes: "35",
                    visitas: "3.842",
                    favoritos: "104",
                    conversion: "4,3 %",
                    promedio: "₡12.186",
                    descripcion:
                        "Ingresos obtenidos durante los últimos 3 meses."
                },

                "365": {
                    ventas: "₡1.785.000",
                    ordenes: "148",
                    visitas: "15.760",
                    favoritos: "418",
                    conversion: "4,7 %",
                    promedio: "₡12.061",
                    descripcion:
                        "Ingresos obtenidos durante el último año."
                }
            };


            const actualizarEstadisticas = () => {

                const periodo =
                    selectorPeriodo.value;

                const valores =
                    valoresPorPeriodo[periodo];

                document.getElementById(
                    "valorVentasEstadisticas"
                ).textContent = valores.ventas;

                document.getElementById(
                    "valorOrdenesEstadisticas"
                ).textContent = valores.ordenes;

                document.getElementById(
                    "valorVisitasEstadisticas"
                ).textContent = valores.visitas;

                document.getElementById(
                    "valorFavoritosEstadisticas"
                ).textContent = valores.favoritos;

                document.getElementById(
                    "valorConversionEstadisticas"
                ).textContent = valores.conversion;

                document.getElementById(
                    "valorPromedioEstadisticas"
                ).textContent = valores.promedio;

                descripcionPeriodo.textContent =
                    valores.descripcion;

                mensajeActualizacion.classList.add(
                    "visible"
                );

                window.setTimeout(() => {

                    mensajeActualizacion.classList.remove(
                        "visible"
                    );

                }, 3000);
            };


            botonActualizar?.addEventListener(
                "click",
                actualizarEstadisticas
            );


            const buscadorProductos =
                document.getElementById(
                    "buscarProductoEstadisticas"
                );

            const productos =
                document.querySelectorAll(
                    ".producto-rendimiento-filtrable"
                );

            const mensajeSinProductos =
                document.getElementById(
                    "mensajeSinProductosEstadisticas"
                );


            buscadorProductos?.addEventListener("input", () => {

                const texto =
                    buscadorProductos.value
                        .trim()
                        .toLowerCase();

                let visibles = 0;

                productos.forEach((producto) => {

                    const nombre =
                        producto.dataset.producto
                            .toLowerCase();

                    const mostrar =
                        nombre.includes(texto);

                    producto.style.display =
                        mostrar ? "" : "none";

                    if (mostrar) {
                        visibles++;
                    }
                });

                mensajeSinProductos.style.display =
                    visibles === 0
                        ? "flex"
                        : "none";
            });
        });
    </script>
}