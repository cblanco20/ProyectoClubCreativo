@{
    ViewData["Title"] = "Estadísticas del emprendimiento";
    Layout = "~/Views/Shared/_LayoutEmprendedor.cshtml";
}

<section class="cabecera-vista-emprendedor">

    <div>
        <span class="subtitulo-emprendedor">
            Crecimiento
        </span>

        <h1>Estadísticas del emprendimiento</h1>

        <p>
            Consulta el rendimiento de tus ventas, productos,
            visitas, favoritos y valoraciones.
        </p>
    </div>

    <div class="acciones-cabecera-estadisticas">

        <select id="periodoEstadisticas"
                class="selector-periodo-estadisticas"
                aria-label="Seleccionar período">

            <option value="7">
                Últimos 7 días
            </option>

            <option value="30" selected>
                Últimos 30 días
            </option>

            <option value="90">
                Últimos 3 meses
            </option>

            <option value="365">
                Último año
            </option>

        </select>

        <button type="button"
                id="botonActualizarEstadisticas"
                class="boton-actualizar-estadisticas">

            <i class="bi bi-arrow-clockwise"></i>
            Actualizar

        </button>

    </div>

</section>


<!-- MENSAJE DE ACTUALIZACIÓN -->
<div id="mensajeActualizacionEstadisticas"
     class="mensaje-actualizacion-estadisticas">

    <i class="bi bi-check-circle-fill"></i>

    <span>
        Las estadísticas fueron actualizadas correctamente.
    </span>

</div>


<!-- RESUMEN -->
<section class="resumen-estadisticas-emprendedor">

    <article class="tarjeta-estadistica-principal">

        <div class="cabecera-tarjeta-estadistica">

            <span class="icono-estadistica-principal ventas">
                <i class="bi bi-cash-coin"></i>
            </span>

            <span class="variacion-estadistica positiva">
                <i class="bi bi-arrow-up-right"></i>
                12,5 %
            </span>

        </div>

        <span class="etiqueta-estadistica">
            Ventas del período
        </span>

        <strong id="valorVentasEstadisticas">
            ₡145.000
        </strong>

        <small id="comparacionVentasEstadisticas">
            ₡16.100 más que el período anterior
        </small>

    </article>


    <article class="tarjeta-estadistica-principal">

        <div class="cabecera-tarjeta-estadistica">

            <span class="icono-estadistica-principal ordenes">
                <i class="bi bi-bag-check-fill"></i>
            </span>

            <span class="variacion-estadistica positiva">
                <i class="bi bi-arrow-up-right"></i>
                8,3 %
            </span>

        </div>

        <span class="etiqueta-estadistica">
            Órdenes recibidas
        </span>

        <strong id="valorOrdenesEstadisticas">
            12
        </strong>

        <small id="comparacionOrdenesEstadisticas">
            2 órdenes más que el período anterior
        </small>

    </article>


    <article class="tarjeta-estadistica-principal">

        <div class="cabecera-tarjeta-estadistica">

            <span class="icono-estadistica-principal visitas">
                <i class="bi bi-eye-fill"></i>
            </span>

            <span class="variacion-estadistica positiva">
                <i class="bi bi-arrow-up-right"></i>
                18,7 %
            </span>

        </div>

        <span class="etiqueta-estadistica">
            Visitas al perfil
        </span>

        <strong id="valorVisitasEstadisticas">
            1.248
        </strong>

        <small id="comparacionVisitasEstadisticas">
            197 visitas más que el período anterior
        </small>

    </article>


    <article class="tarjeta-estadistica-principal">

        <div class="cabecera-tarjeta-estadistica">

            <span class="icono-estadistica-principal favoritos">
                <i class="bi bi-heart-fill"></i>
            </span>

            <span class="variacion-estadistica positiva">
                <i class="bi bi-arrow-up-right"></i>
                6,4 %
            </span>

        </div>

        <span class="etiqueta-estadistica">
            Productos favoritos
        </span>

        <strong id="valorFavoritosEstadisticas">
            36
        </strong>

        <small id="comparacionFavoritosEstadisticas">
            4 favoritos más que el período anterior
        </small>

    </article>

</section>


<!-- SEGUNDA FILA DE DATOS -->
<section class="resumen-secundario-estadisticas">

    <article>

        <span class="icono-resumen-secundario valoracion">
            <i class="bi bi-star-fill"></i>
        </span>

        <div>
            <span>Valoración promedio</span>

            <strong>4,8 de 5</strong>

            <div class="estrellas-resumen-estadisticas">
                <i class="bi bi-star-fill"></i>
                <i class="bi bi-star-fill"></i>
                <i class="bi bi-star-fill"></i>
                <i class="bi bi-star-fill"></i>
                <i class="bi bi-star-half"></i>
            </div>
        </div>

    </article>


    <article>

        <span class="icono-resumen-secundario conversion">
            <i class="bi bi-percent"></i>
        </span>

        <div>
            <span>Tasa de conversión</span>
            <strong id="valorConversionEstadisticas">3,9 %</strong>
            <small>Visitas que finalizaron en compra</small>
        </div>

    </article>


    <article>

        <span class="icono-resumen-secundario promedio">
            <i class="bi bi-receipt-cutoff"></i>
        </span>

        <div>
            <span>Venta promedio</span>
            <strong id="valorPromedioEstadisticas">₡12.083</strong>
            <small>Promedio por cada orden</small>
        </div>

    </article>


    <article>

        <span class="icono-resumen-secundario productos">
            <i class="bi bi-box-seam-fill"></i>
        </span>

        <div>
            <span>Productos activos</span>
            <strong>6 de 8</strong>
            <small>75 % del catálogo publicado</small>
        </div>

    </article>

</section>


<!-- GRÁFICOS PRINCIPALES -->
<section class="grid-graficos-estadisticas">

    <!-- VENTAS -->
    <article class="bloque-estadisticas-emprendedor grafico-ventas-estadisticas">

        <div class="encabezado-bloque-estadisticas">

            <div>
                <span class="subtitulo-emprendedor">
                    Rendimiento
                </span>

                <h2>Evolución de ventas</h2>

                <p id="descripcionPeriodoVentas">
                    Ingresos obtenidos durante los últimos 30 días.
                </p>
            </div>

            <div class="leyenda-grafico-estadisticas">

                <span>
                    <i class="indicador-leyenda ventas-actuales"></i>
                    Período actual
                </span>

                <span>
                    <i class="indicador-leyenda ventas-anteriores"></i>
                    Período anterior
                </span>

            </div>

        </div>


        <div class="grafico-lineas-estadisticas">

            <div class="escala-grafico-ventas">

                <span>₡50 mil</span>
                <span>₡40 mil</span>
                <span>₡30 mil</span>
                <span>₡20 mil</span>
                <span>₡10 mil</span>
                <span>₡0</span>

            </div>

            <div class="area-grafico-ventas">

                <div class="lineas-horizontales-grafico">
                    <span></span>
                    <span></span>
                    <span></span>
                    <span></span>
                    <span></span>
                    <span></span>
                </div>

                <svg viewBox="0 0 700 260"
                     preserveAspectRatio="none"
                     class="svg-ventas-estadisticas"
                     aria-label="Gráfico de evolución de ventas">

                    <defs>

                        <linearGradient id="rellenoVentas"
                                        x1="0"
                                        y1="0"
                                        x2="0"
                                        y2="1">

                            <stop offset="0%"
                                  stop-color="#7f45c6"
                                  stop-opacity="0.28">
                            </stop>

                            <stop offset="100%"
                                  stop-color="#7f45c6"
                                  stop-opacity="0">
                            </stop>

                        </linearGradient>

                    </defs>

                    <path class="area-ventas-svg"
                          d="M0,210
                        C60,190 85,170 120,178
                        C170,190 200,120 250,135
                        C310,155 335,80 390,100
                        C440,120 475,55 530,72
                        C585,90 625,35 700,48
                        L700,260
                        L0,260 Z">
                    </path>

                    <path class="linea-anterior-svg"
                          d="M0,225
                        C70,210 90,195 130,200
                        C180,208 215,165 260,172
                        C320,182 350,135 400,145
                        C455,155 490,105 545,115
                        C600,125 650,82 700,92">
                    </path>

                    <path class="linea-actual-svg"
                          d="M0,210
                        C60,190 85,170 120,178
                        C170,190 200,120 250,135
                        C310,155 335,80 390,100
                        C440,120 475,55 530,72
                        C585,90 625,35 700,48">
                    </path>

                    <g class="puntos-grafico-ventas">

                        <circle cx="0" cy="210" r="5"></circle>
                        <circle cx="120" cy="178" r="5"></circle>
                        <circle cx="250" cy="135" r="5"></circle>
                        <circle cx="390" cy="100" r="5"></circle>
                        <circle cx="530" cy="72" r="5"></circle>
                        <circle cx="700" cy="48" r="5"></circle>

                    </g>

                </svg>

                <div class="etiquetas-grafico-ventas">

                    <span>Semana 1</span>
                    <span>Semana 2</span>
                    <span>Semana 3</span>
                    <span>Semana 4</span>

                </div>

            </div>

        </div>

    </article>


    <!-- CATEGORÍAS -->
    <article class="bloque-estadisticas-emprendedor">

        <div class="encabezado-bloque-estadisticas">

            <div>
                <span class="subtitulo-emprendedor">
                    Distribución
                </span>

                <h2>Ventas por categoría</h2>

                <p>
                    Participación de cada categoría en los ingresos.
                </p>
            </div>

        </div>


        <div class="grafico-circular-estadisticas">

            <div class="circulo-categorias-estadisticas">

                <div class="centro-circulo-estadisticas">
                    <strong>₡145 mil</strong>
                    <span>Total vendido</span>
                </div>

            </div>

        </div>


        <div class="leyenda-categorias-estadisticas">

            <div>
                <span class="color-categoria accesorios"></span>

                <div>
                    <strong>Accesorios</strong>
                    <small>38 %</small>
                </div>

                <strong>₡55.100</strong>
            </div>

            <div>
                <span class="color-categoria textiles"></span>

                <div>
                    <strong>Moda y textiles</strong>
                    <small>27 %</small>
                </div>

                <strong>₡39.150</strong>
            </div>

            <div>
                <span class="color-categoria decoracion"></span>

                <div>
                    <strong>Decoración</strong>
                    <small>22 %</small>
                </div>

                <strong>₡31.900</strong>
            </div>

            <div>
                <span class="color-categoria servicios"></span>

                <div>
                    <strong>Servicios</strong>
                    <small>13 %</small>
                </div>

                <strong>₡18.850</strong>
            </div>

        </div>

    </article>

</section>


<!-- PRODUCTOS Y ACTIVIDAD -->
<section class="grid-detalles-estadisticas">

    <!-- PRODUCTOS MÁS VENDIDOS -->
    <article class="bloque-estadisticas-emprendedor">

        <div class="encabezado-bloque-estadisticas">

            <div>
                <span class="subtitulo-emprendedor">
                    Catálogo
                </span>

                <h2>Productos más vendidos</h2>

                <p>
                    Productos con mejores resultados durante el período.
                </p>
            </div>

            <a asp-controller="Emprendedor"
               asp-action="MisProductos">

                Ver productos
                <i class="bi bi-arrow-right"></i>

            </a>

        </div>


        <div class="lista-productos-estadisticas">

            <article class="producto-estadistica">

                <span class="posicion-producto-estadistica primero">
