                <div class="producto-tabla-estadisticas">

                    <img src="~/images/producto-2.jpg"
                         alt="Bolso tejido artesanal" />

                    <div>
                        <strong>Bolso tejido artesanal</strong>
                        <span>Moda y textiles</span>
                    </div>

                </div>

                <span>318</span>
                <span>11</span>
                <strong>12</strong>

                <span class="conversion-producto-estadistica media">
                    3,8 %
                </span>

                <strong class="ingreso-producto-estadistica">
                    ₡216.000
                </strong>

            </article>


            <article class="fila-producto-rendimiento producto-rendimiento-filtrable"
                     data-producto="Llaveros personalizados">

                <div class="producto-tabla-estadisticas">

                    <img src="~/images/noticia-emprendimiento.jpg"
                         alt="Llaveros personalizados" />

                    <div>
                        <strong>Llaveros personalizados</strong>
                        <span>Accesorios y joyería</span>
                    </div>

                </div>

                <span>265</span>
                <span>7</span>
                <strong>9</strong>

                <span class="conversion-producto-estadistica media">
                    3,4 %
                </span>

                <strong class="ingreso-producto-estadistica">
                    ₡45.000
                </strong>

            </article>


            <article class="fila-producto-rendimiento producto-rendimiento-filtrable"
