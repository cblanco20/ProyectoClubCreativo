                <div class="informacion-producto-estadistica">

                    <strong>Aretes artesanales</strong>
                    <span>Accesorios y joyería</span>

                    <div class="barra-producto-estadistica">
                        <span style="width: 92%;"></span>
                    </div>

                </div>

                <div class="resultado-producto-estadistica">
                    <strong>18 ventas</strong>
                    <span>₡153.000</span>
                </div>

            </article>


            <article class="producto-estadistica">

