@using System.Globalization
@using ProyectoClubCreativo.Models.ViewModels
@model EstadisticasEmprendedorViewModel

@{
    ViewData["Title"] = "Estadísticas del emprendimiento";
    Layout = "~/Views/Shared/_LayoutEmprendedor.cshtml";

    string Dinero(decimal valor) => "₡" + valor.ToString("N0");

    string Inv(double valor) => valor.ToString("0.##", CultureInfo.InvariantCulture);

    string ImagenDe(string? url) =>
        string.IsNullOrWhiteSpace(url) ? Url.Content("~/images/logo.jpg") : Url.Content(url);

    string ClaseVariacion(double valor) => valor >= 0 ? "positiva" : "negativa";

    string IconoVariacion(double valor) =>
        valor >= 0 ? "bi-arrow-up-right" : "bi-arrow-down-right";

    string TiempoRelativo(DateTime fecha)
    {
        TimeSpan diferencia = DateTime.Now - fecha;

        if (diferencia.TotalMinutes < 1) return "Hace unos segundos";
        if (diferencia.TotalMinutes < 60) return $"Hace {(int)diferencia.TotalMinutes} min";
        if (diferencia.TotalHours < 24) return $"Hace {(int)diferencia.TotalHours} h";
        if (diferencia.TotalDays < 30) return $"Hace {(int)diferencia.TotalDays} día(s)";

        return fecha.ToString("dd/MM/yyyy");
    }

    int estrellasLlenas = (int)Math.Floor(Model.Valoracion ?? 0);
    bool mediaEstrella = (Model.Valoracion ?? 0) - estrellasLlenas >= 0.5;
}

<section class="cabecera-vista-emprendedor">
    <div>
        <span class="subtitulo-emprendedor">Crecimiento</span>
        <h1>Estadísticas del emprendimiento</h1>
        <p>
            Consulta el rendimiento de tus ventas, productos,
            favoritos y valoraciones.
        </p>
    </div>

    <form asp-controller="Emprendedor"
          asp-action="Estadisticas"
          method="get"
          class="acciones-cabecera-estadisticas">

        <select name="periodo"
                id="periodoEstadisticas"
                class="selector-periodo-estadisticas"
                aria-label="Seleccionar período"
                onchange="this.form.submit()">
            <option value="7" selected="@(Model.Periodo == 7)">Últimos 7 días</option>
            <option value="30" selected="@(Model.Periodo == 30)">Últimos 30 días</option>
            <option value="90" selected="@(Model.Periodo == 90)">Últimos 3 meses</option>
            <option value="365" selected="@(Model.Periodo == 365)">Último año</option>
        </select>

        <button type="submit" class="boton-actualizar-estadisticas">
            <i class="bi bi-arrow-clockwise"></i>
            Actualizar
        </button>
    </form>
</section>

<!-- RESUMEN -->
<section class="resumen-estadisticas-emprendedor">

    <article class="tarjeta-estadistica-principal">
        <div class="cabecera-tarjeta-estadistica">
            <span class="icono-estadistica-principal ventas"><i class="bi bi-cash-coin"></i></span>
            <span class="variacion-estadistica @ClaseVariacion(Model.VariacionVentas)">
                <i class="bi @IconoVariacion(Model.VariacionVentas)"></i>
                @Math.Abs(Model.VariacionVentas).ToString("0.#") %
            </span>
        </div>
        <span class="etiqueta-estadistica">Ventas del período</span>
        <strong>@Dinero(Model.Ventas)</strong>
        <small>
            @(Model.Ventas >= Model.VentasAnterior
                ? Dinero(Model.Ventas - Model.VentasAnterior) + " más"
                : Dinero(Model.VentasAnterior - Model.Ventas) + " menos")
            que el período anterior
        </small>
    </article>

    <article class="tarjeta-estadistica-principal">
        <div class="cabecera-tarjeta-estadistica">
            <span class="icono-estadistica-principal ordenes"><i class="bi bi-receipt"></i></span>
            <span class="variacion-estadistica @ClaseVariacion(Model.VariacionOrdenes)">
                <i class="bi @IconoVariacion(Model.VariacionOrdenes)"></i>
                @Math.Abs(Model.VariacionOrdenes).ToString("0.#") %
            </span>
        </div>
        <span class="etiqueta-estadistica">Órdenes</span>
        <strong>@Model.Ordenes</strong>
        <small>Pedidos con ventas confirmadas</small>
    </article>

    <article class="tarjeta-estadistica-principal">
        <div class="cabecera-tarjeta-estadistica">
            <span class="icono-estadistica-principal visitas"><i class="bi bi-box-seam-fill"></i></span>
            <span class="variacion-estadistica @ClaseVariacion(Model.VariacionUnidades)">
                <i class="bi @IconoVariacion(Model.VariacionUnidades)"></i>
                @Math.Abs(Model.VariacionUnidades).ToString("0.#") %
            </span>
        </div>
        <span class="etiqueta-estadistica">Unidades vendidas</span>
        <strong>@Model.Unidades</strong>
        <small>Productos vendidos en el período</small>
    </article>

    <article class="tarjeta-estadistica-principal">
        <div class="cabecera-tarjeta-estadistica">
            <span class="icono-estadistica-principal favoritos"><i class="bi bi-heart-fill"></i></span>
            <span class="variacion-estadistica @ClaseVariacion(Model.VariacionFavoritos)">
                <i class="bi @IconoVariacion(Model.VariacionFavoritos)"></i>
                @Math.Abs(Model.VariacionFavoritos).ToString("0.#") %
            </span>
        </div>
        <span class="etiqueta-estadistica">Favoritos nuevos</span>
        <strong>@Model.Favoritos</strong>
        <small>Guardados por la comunidad</small>
    </article>

</section>

<section class="resumen-secundario-estadisticas">

    <article>
        <span class="icono-resumen-secundario valoracion"><i class="bi bi-star-fill"></i></span>
        <div>
            <span>Valoración promedio</span>
            @if (Model.Valoracion.HasValue)
            {
                <strong>@Model.Valoracion.Value.ToString("0.0") de 5</strong>
                <div class="estrellas-resumen-estadisticas">
                    @for (int i = 1; i <= 5; i++)
                    {
                        <i class="bi @(i <= estrellasLlenas ? "bi-star-fill" : (i == estrellasLlenas + 1 && mediaEstrella ? "bi-star-half" : "bi-star"))"></i>
                    }
                </div>
            }
            else
            {
                <strong>Sin valoraciones</strong>
            }
        </div>
    </article>

    <article>
        <span class="icono-resumen-secundario conversion"><i class="bi bi-people-fill"></i></span>
        <div>
            <span>Clientes del período</span>
            <strong>@Model.Clientes</strong>
        </div>
    </article>

    <article>
        <span class="icono-resumen-secundario promedio"><i class="bi bi-receipt-cutoff"></i></span>
        <div>
            <span>Ticket promedio</span>
            <strong>@Dinero(Model.TicketPromedio)</strong>
        </div>
    </article>

    <article>
        <span class="icono-resumen-secundario productos"><i class="bi bi-box-seam"></i></span>
        <div>
            <span>Productos publicados</span>
            <strong>@Model.ProductosPublicados de @Model.ProductosTotales</strong>
        </div>
    </article>

</section>

<!-- GRÁFICOS -->
<section class="grid-graficos-estadisticas">

    <article class="bloque-estadisticas-emprendedor grafico-ventas-estadisticas">
        <div class="encabezado-bloque-estadisticas">
            <div>
                <span class="subtitulo-emprendedor">Rendimiento</span>
                <h2>Evolución de ventas</h2>
                <p>@Model.DescripcionPeriodo</p>
            </div>

            <div class="leyenda-grafico-estadisticas">
                <span><i class="indicador-leyenda ventas-actuales"></i> Período actual</span>
                <span><i class="indicador-leyenda ventas-anteriores"></i> Período anterior</span>
            </div>
        </div>

        <div class="grafico-lineas-estadisticas">
            <div class="escala-grafico-ventas">
                @foreach (string marca in Model.EscalaVentas)
                {
                    <span>@marca</span>
                }
            </div>

            <div class="area-grafico-ventas">
                <div class="lineas-horizontales-grafico">
                    <span></span><span></span><span></span><span></span><span></span><span></span>
                </div>

                <svg viewBox="0 0 700 260"
                     preserveAspectRatio="none"
                     class="svg-ventas-estadisticas"
                     aria-label="Gráfico de evolución de ventas">
                    <defs>
                        <linearGradient id="rellenoVentas" x1="0" y1="0" x2="0" y2="1">
                            <stop offset="0%" stop-color="#7f45c6" stop-opacity="0.28"></stop>
                            <stop offset="100%" stop-color="#7f45c6" stop-opacity="0"></stop>
                        </linearGradient>
                    </defs>

                    <path class="area-ventas-svg" d="@Model.RutaArea"></path>
                    <path class="linea-anterior-svg" d="@Model.RutaAnterior"></path>
                    <path class="linea-actual-svg" d="@Model.RutaActual"></path>

                    <g class="puntos-grafico-ventas">
                        @foreach (PuntoGraficoEmprendedorViewModel punto in Model.Puntos)
                        {
                            <circle cx="@Inv(punto.X)" cy="@Inv(punto.Y)" r="5"></circle>
                        }
                    </g>
                </svg>

                <div class="etiquetas-grafico-ventas">
                    @foreach (string etiqueta in Model.EtiquetasVentas)
                    {
                        <span>@etiqueta</span>
                    }
                </div>
            </div>
        </div>
    </article>

    <article class="bloque-estadisticas-emprendedor">
        <div class="encabezado-bloque-estadisticas">
            <div>
                <span class="subtitulo-emprendedor">Distribución</span>
                <h2>Ventas por categoría</h2>
                <p>Participación de cada categoría en los ingresos.</p>
            </div>
        </div>

        <div class="grafico-circular-estadisticas">
            <div class="circulo-categorias-estadisticas" style="background: @Model.GradienteCategorias;">
                <div class="centro-circulo-estadisticas">
                    <strong>@Dinero(Model.Ventas)</strong>
                    <span>Total vendido</span>
                </div>
            </div>
        </div>

        <div class="leyenda-categorias-estadisticas">
            @if (Model.Categorias.Count == 0)
            {
                <p>Aún no hay ventas en este período.</p>
            }

            @foreach (CategoriaVentaViewModel categoria in Model.Categorias)
            {
                <div>
                    <span class="color-categoria" style="background: @categoria.Color;"></span>
                    <div>
                        <strong>@categoria.Nombre</strong>
                        <small>@categoria.Porcentaje %</small>
                    </div>
                    <strong>@Dinero(categoria.Monto)</strong>
                </div>
            }
        </div>
    </article>

</section>

<!-- PRODUCTOS Y ACTIVIDAD -->
<section class="grid-detalles-estadisticas">

    <article class="bloque-estadisticas-emprendedor">
        <div class="encabezado-bloque-estadisticas">
            <div>
                <span class="subtitulo-emprendedor">Catálogo</span>
                <h2>Productos más vendidos</h2>
                <p>Productos con mejores resultados durante el período.</p>
            </div>

            <a asp-controller="Emprendedor" asp-action="MisProductos">
                Ver productos
                <i class="bi bi-arrow-right"></i>
            </a>
        </div>

        <div class="lista-productos-estadisticas">
            @if (Model.TopProductos.Count == 0)
            {
                <p>Aún no hay ventas en este período.</p>
            }

            @for (int i = 0; i < Model.TopProductos.Count; i++)
            {
                ProductoEstadisticaViewModel producto = Model.TopProductos[i];

                <article class="producto-estadistica">
                    <span class="posicion-producto-estadistica @(i == 0 ? "primero" : i == 1 ? "segundo" : i == 2 ? "tercero" : "")">
                        @(i + 1)
                    </span>

                    <img src="@ImagenDe(producto.ImagenUrl)" alt="@producto.Nombre" />

                    <div class="informacion-producto-estadistica">
                        <strong>@producto.Nombre</strong>
                        <span>@(producto.Categoria ?? "Sin categoría")</span>
                        <div class="barra-producto-estadistica">
                            <span style="width: @Inv(producto.Porcentaje)%;"></span>
                        </div>
                    </div>

                    <div class="resultado-producto-estadistica">
                        <strong>@producto.Unidades @(producto.Unidades == 1 ? "venta" : "ventas")</strong>
                        <span>@Dinero(producto.Ingresos)</span>
                    </div>
                </article>
            }
        </div>
    </article>

    <article class="bloque-estadisticas-emprendedor">
        <div class="encabezado-bloque-estadisticas">
            <div>
                <span class="subtitulo-emprendedor">Actividad</span>
                <h2>Actividad reciente</h2>
                <p>Principales movimientos del emprendimiento.</p>
            </div>
        </div>

        <div class="linea-tiempo-estadisticas">
            @if (Model.Actividad.Count == 0)
            {
                <p>Todavía no hay actividad registrada.</p>
            }

            @foreach (ActividadEstadisticaViewModel item in Model.Actividad)
            {
                <div class="actividad-estadistica">
                    <span class="icono-actividad-estadistica @item.Tipo">
                        <i class="bi @item.Icono"></i>
                    </span>

                    <div>
                        <strong>@item.Titulo</strong>
                        <p>@item.Detalle</p>
                        <span>@TiempoRelativo(item.Fecha)</span>
                    </div>
                </div>
            }
        </div>
    </article>

</section>

<!-- RENDIMIENTO DE PRODUCTOS -->
<section class="bloque-estadisticas-emprendedor tabla-rendimiento-estadisticas">

    <div class="encabezado-bloque-estadisticas">
        <div>
            <span class="subtitulo-emprendedor">Rendimiento individual</span>
            <h2>Rendimiento de productos</h2>
            <p>Compara el stock, los favoritos, las ventas y los ingresos de tus publicaciones.</p>
        </div>

        <div class="buscador-rendimiento-estadisticas">
            <i class="bi bi-search"></i>
            <input type="search"
                   id="buscarProductoEstadisticas"
                   placeholder="Buscar producto..."
                   aria-label="Buscar producto en estadísticas" />
        </div>
    </div>

    <div class="contenedor-tabla-rendimiento">
        <div class="tabla-productos-estadisticas">

            <div class="fila-producto-rendimiento encabezado-rendimiento">
                <span>Producto</span>
                <span>Stock</span>
                <span>Favoritos</span>
                <span>Unidades</span>
                <span>Órdenes</span>
                <span>Ingresos</span>
            </div>

            @foreach (ProductoEstadisticaViewModel producto in Model.Productos)
            {
                <article class="fila-producto-rendimiento producto-rendimiento-filtrable"
                         data-producto="@producto.Nombre">

                    <div class="producto-tabla-estadisticas">
                        <img src="@ImagenDe(producto.ImagenUrl)" alt="@producto.Nombre" />
                        <div>
                            <strong>@producto.Nombre</strong>
                            <span>@(producto.Categoria ?? "Sin categoría")</span>
                        </div>
                    </div>

                    <span>@producto.Stock</span>
                    <span>@producto.Favoritos</span>
                    <strong>@producto.Unidades</strong>
                    <span>@producto.Ordenes</span>
                    <strong class="ingreso-producto-estadistica">@Dinero(producto.Ingresos)</strong>
                </article>
            }
        </div>

        @if (Model.Productos.Count == 0)
        {
            <p>Todavía no tienes productos publicados.</p>
        }

        <div id="mensajeSinProductosEstadisticas" class="mensaje-sin-productos-estadisticas">
            <i class="bi bi-bar-chart"></i>
            <h2>No se encontraron productos</h2>
            <p>Utiliza otro término de búsqueda.</p>
        </div>
    </div>

</section>

<!-- RECOMENDACIONES -->
<section class="recomendaciones-estadisticas-emprendedor">

    <div class="encabezado-recomendaciones-estadisticas">
        <span class="icono-recomendaciones-estadisticas"><i class="bi bi-lightbulb-fill"></i></span>
        <div>
            <span class="subtitulo-emprendedor">Recomendaciones</span>
            <h2>Oportunidades para mejorar</h2>
            <p>Acciones sugeridas según el rendimiento del emprendimiento.</p>
        </div>
    </div>

    <div class="grid-recomendaciones-estadisticas">

        <article>
            <span class="numero-recomendacion-estadistica">01</span>
            <div>
                <h3>Actualiza el inventario</h3>
                <p>
                    @if (Model.ProductosBajoStock > 0)
                    {
                        <text>Tienes @Model.ProductosBajoStock producto(s) con 3 unidades o menos disponibles. Reponerlos evita perder ventas.</text>
                    }
                    else
                    {
                        <text>Tu inventario está al día. Mantén tus existencias actualizadas para no perder ventas.</text>
                    }
                </p>
                <a asp-controller="Emprendedor" asp-action="Inventario">
                    Revisar inventario
                    <i class="bi bi-arrow-right"></i>
                </a>
            </div>
        </article>

        <article>
            <span class="numero-recomendacion-estadistica">02</span>
            <div>
                <h3>Destaca tus mejores productos</h3>
                <p>
                    @if (Model.ProductoEstrella is not null)
                    {
                        <text>«@Model.ProductoEstrella» fue tu producto más vendido en este período. Destácalo para que más personas lo encuentren.</text>
                    }
                    else
                    {
                        <text>Todavía no hay ventas en este período. Destaca tus mejores productos para atraer más compradores.</text>
                    }
                </p>
                <a asp-controller="Emprendedor" asp-action="MisProductos">
                    Ver mis productos
                    <i class="bi bi-arrow-right"></i>
                </a>
            </div>
        </article>

    </div>

</section>

@section Scripts {
    <script>
        document.addEventListener("DOMContentLoaded", () => {
            const buscador = document.getElementById("buscarProductoEstadisticas");
            const filas = document.querySelectorAll(".producto-rendimiento-filtrable");
            const mensaje = document.getElementById("mensajeSinProductosEstadisticas");

            buscador?.addEventListener("input", () => {
                const texto = buscador.value.trim().toLowerCase();
                let visibles = 0;

                filas.forEach((fila) => {
                    const mostrar = fila.dataset.producto.toLowerCase().includes(texto);
                    fila.style.display = mostrar ? "" : "none";

                    if (mostrar) {
                        visibles++;
                    }
                });

                if (mensaje) {
                    mensaje.style.display = visibles === 0 && filas.length > 0 ? "flex" : "none";
                }
            });
        });
    </script>
}