@using ProyectoClubCreativo.Models.Entities
@using ProyectoClubCreativo.Models.ViewModels

@{
    ViewData["Title"] = "Panel del emprendedor";
    Layout = "~/Views/Shared/_LayoutEmprendedor.cshtml";

    string estadoEmprendimientoPanel =
        ViewBag.EstadoEmprendimiento as string ?? "Pendiente";

    List<Producto> productosInventarioBajo =
        ViewBag.ProductosInventarioBajo as List<Producto>
        ?? new List<Producto>();

    List<VentaEmprendedorViewModel> ventasRecientes =
        (ViewBag.Ventas as List<VentaEmprendedorViewModel>
        ?? new List<VentaEmprendedorViewModel>())
        .Take(3)
        .ToList();

    decimal totalVentas =
        (ViewBag.Ventas as List<VentaEmprendedorViewModel>
        ?? new List<VentaEmprendedorViewModel>())
        .Where(v => v.Estado == "Entregada")
        .Sum(v => v.Monto);

    List<EventoPublicoViewModel> proximosEventos =
        ViewBag.ProximosEventos as List<EventoPublicoViewModel>
        ?? new List<EventoPublicoViewModel>();

    List<Notificacione> actividadReciente =
        ViewBag.ActividadReciente as List<Notificacione>
        ?? new List<Notificacione>();
}

@if (TempData["MensajeEmprendedor"] is not null)
{
    <div class="mensaje-exito-emprendedor">
        <i class="bi bi-check-circle-fill"></i>
        @TempData["MensajeEmprendedor"]
    </div>
}

<section class="banner-emprendedor">

    <div class="contenido-banner-emprendedor">

        <span class="etiqueta-emprendedor">
            Panel de administración
        </span>

        <h1>
            Bienvenido a tu espacio de emprendimiento
        </h1>

        <p>
            Administra tus productos, inventario, ventas,
            suscripción y participación en eventos desde un solo lugar.
        </p>

        <a asp-controller="Emprendedor"
           asp-action="PerfilEmprendimiento"
           class="boton-principal-emprendedor">
            <i class="bi bi-shop"></i>
            Ver mi emprendimiento
        </a>

    </div>

    <div class="imagen-banner-emprendedor">
        <img src="~/images/registro-emprendedor.jpg"
             alt="Emprendimiento creativo" />
    </div>

</section>

<section class="resumen-emprendedor">

    <article class="tarjeta-resumen-emprendedor">
        <span class="icono-resumen-emprendedor icono-estado-emprendedor">
            <i class="bi bi-patch-check-fill"></i>
        </span>

        <div>
            <strong>@estadoEmprendimientoPanel</strong>
            <span>Estado del emprendimiento</span>
        </div>
    </article>

    <article class="tarjeta-resumen-emprendedor">
        <span class="icono-resumen-emprendedor icono-plan-emprendedor">
            <i class="bi bi-gem"></i>
        </span>

        <div>
            <strong>@ViewBag.PlanSuscripcion</strong>
            <span>Suscripción actual</span>
        </div>
    </article>

    <article class="tarjeta-resumen-emprendedor">
        <span class="icono-resumen-emprendedor icono-productos-emprendedor">
            <i class="bi bi-box-seam-fill"></i>
        </span>

        <div>
            <strong>@(ViewBag.TotalProductosPublicados ?? 0)</strong>
            <span>Productos publicados</span>
        </div>
    </article>

    <article class="tarjeta-resumen-emprendedor">
        <span class="icono-resumen-emprendedor icono-ventas-emprendedor">
            <i class="bi bi-cash-coin"></i>
        </span>

        <div>
            <strong>₡@totalVentas.ToString("N0")</strong>
            <span>Ventas entregadas (total histórico)</span>
        </div>
    </article>

</section>

<section class="grid-panel-emprendedor">

    <div class="columna-principal-emprendedor">

        <article class="bloque-panel-emprendedor">

            <div class="encabezado-bloque-emprendedor">
                <div>
                    <span class="subtitulo-emprendedor">
                        Inventario
                    </span>

                    <h2>Productos con bajo inventario</h2>
                </div>

                <a asp-controller="Emprendedor"
                   asp-action="Inventario">
                    Ver inventario →
                </a>
            </div>

            <div class="lista-inventario-panel">

                @if (productosInventarioBajo.Any())
                {
                    foreach (var producto in productosInventarioBajo)
                    {
                        <div class="producto-inventario-panel">

                            <img src="@(producto.ProductoImagene?.UrlImagen ?? "/images/logo.jpg")"
                                 alt="@producto.Nombre" />

                            <div>
                                <strong>@producto.Nombre</strong>

                                <span>
                                    Solo quedan @producto.StockActual unidad(es)
                                </span>
                            </div>

                            <span class="estado-inventario-bajo">
                                Bajo
                            </span>

                        </div>
                    }
                }
                else
                {
                    <div style="width: 100%; padding: 20px 15px; text-align: center;">
                        <i class="bi bi-check-circle-fill"
                           style="font-size: 28px; color: #28a745;"></i>

                        <p style="margin: 10px 0 5px; font-weight: 600;">
                            ¡Inventario en buen estado!
                        </p>

                        <p style="margin: 0; color: #777;">
                            No tienes productos publicados con inventario bajo.
                        </p>
                    </div>
                }

            </div>

        </article>

        <article class="bloque-panel-emprendedor">

            <div class="encabezado-bloque-emprendedor">
                <div>
                    <span class="subtitulo-emprendedor">
                        Ventas
                    </span>

                    <h2>Ventas recientes</h2>
                </div>

                <a asp-controller="Emprendedor"
                   asp-action="Ventas">
                    Ver todas →
                </a>
            </div>

            <div class="tabla-panel-emprendedor">

                <div class="fila-tabla-emprendedor encabezado-tabla-emprendedor">
                    <span>Orden</span>
                    <span>Cliente</span>
                    <span>Total</span>
                    <span>Estado</span>
                </div>

                @if (ventasRecientes.Any())
                {
                    foreach (var venta in ventasRecientes)
                    {
                        string claseEstado = venta.Estado switch
                        {
                            "Entregada" => "entregada",
                            "Pendiente" => "pendiente",
                            "En preparación" => "preparacion",
                            "Preparación" => "preparacion",
                            _ => "pendiente"
                        };

                        <div class="fila-tabla-emprendedor">
                            <span>@venta.NumeroOrden</span>

                            <span>@venta.NombreComprador</span>

                            <span>₡@venta.Monto.ToString("N0")</span>

                            <span class="estado-venta @claseEstado">
                                @venta.Estado
                            </span>
                        </div>
                    }
                }
                else
                {
                    <div style="padding: 20px; text-align: center; color: #777;">
                        Todavía no tienes ventas registradas.
                    </div>
                }

            </div>

        </article>

    </div>

    <aside class="columna-secundaria-emprendedor">

        <article class="bloque-panel-emprendedor">

            <div class="encabezado-bloque-emprendedor">
                <div>
                    <span class="subtitulo-emprendedor">
                        Eventos
                    </span>

                    <h2>Próximos eventos</h2>
                </div>
            </div>

            <div class="lista-eventos-emprendedor">

                @if (proximosEventos.Any())
                {
                    foreach (var evento in proximosEventos)
                    {
                        <article class="evento-panel-emprendedor">
                            <img src="@(string.IsNullOrWhiteSpace(evento.ImagenUrl)
                                            ? "/images/hero-feria.jpg"
                                            : evento.ImagenUrl)"
                                 alt="@evento.Nombre" />

                            <div>
                                <strong>@evento.Nombre</strong>

                                <span>
                                    <i class="bi bi-calendar3"></i>
                                    @evento.FechaInicio.ToString(
                                        "d 'de' MMMM",
                                        new System.Globalization.CultureInfo("es-CR"))
                                </span>

                                <span>
                                    <i class="bi bi-geo-alt-fill"></i>
                                    @evento.Ubicacion
                                </span>
                            </div>
                        </article>
                    }
                }
                else
                {
                    <div style="padding: 20px; text-align: center; color: #777;">
                        No hay próximos eventos disponibles.
                    </div>
                }

            </div>

            <a asp-controller="Emprendedor"
               asp-action="ParticipacionEventos"
               class="boton-secundario-emprendedor">
                Ver eventos disponibles
            </a>

        </article>

        <article class="bloque-panel-emprendedor">

            <div class="encabezado-bloque-emprendedor">
                <div>
                    <span class="subtitulo-emprendedor">
                        Notificaciones
                    </span>

                    <h2>Actividad reciente</h2>
                </div>
            </div>

            @if (productosInventarioBajo.Any())
            {
                <div class="notificacion-emprendedor">
                    <span class="icono-notificacion-emprendedor">
                        <i class="bi bi-exclamation-triangle-fill"></i>
                    </span>

                    <div>
                        <p>
                            Tienes @productosInventarioBajo.Count producto(s)
                            con inventario bajo.
                        </p>

                        <span>
                            Revisa tu inventario para reabastecer los productos.
                        </span>
                    </div>
                </div>
            }

            @if (actividadReciente.Any())
            {
                foreach (var notificacion in actividadReciente)
                {
                    string icono = notificacion.Tipo switch
                    {
                        "Compra" => "bi-bag-check-fill",
                        "Evento" => "bi-calendar-check-fill",
                        "Puntos" => "bi-star-fill",
                        _ => "bi-bell-fill"
                    };

                    <div class="notificacion-emprendedor">
                        <span class="icono-notificacion-emprendedor">
                            <i class="bi @icono"></i>
                        </span>

                        <div>
                            <p>@notificacion.Mensaje</p>

                            <span>
                                @notificacion.FechaEnvio.ToString("dd/MM/yyyy HH:mm")
                            </span>
                        </div>
                    </div>
                }
            }
            else if (!productosInventarioBajo.Any())
            {
                <div style="padding: 20px; text-align: center; color: #777;">
                    No tienes actividad reciente.
                </div>
            }

        </article>

    </aside>

</section>
