@model ProyectoClubCreativo.Models.ViewModels.PerfilEmprendimientoViewModel
@{
    ViewData["Title"] = "Perfil del emprendimiento";
    Layout = "~/Views/Shared/_LayoutEmprendedor.cshtml";

    string estadoTexto = "Pendiente de aprobación";
    string estadoClase = "pendiente";
    string estadoIcono = "bi-hourglass-split";

    if (Model.EstadoAprobacion == "Aprobado" && !Model.Activo)
    {
        estadoTexto = "Desactivado";
        estadoClase = "rechazado";
        estadoIcono = "bi-slash-circle-fill";
    }
    else if (Model.EstadoAprobacion == "Aprobado")
    {
        estadoTexto = "Aprobado";
        estadoClase = "aprobado";
        estadoIcono = "bi-check-circle-fill";
    }
    else if (Model.EstadoAprobacion == "Rechazado")
    {
        estadoTexto = "Rechazado";
        estadoClase = "rechazado";
        estadoIcono = "bi-x-circle-fill";
    }
}

@if (TempData["MensajePerfil"] is not null)
{
    <div class="mensaje-exito-emprendedor">
        <i class="bi bi-check-circle-fill"></i>
        @TempData["MensajePerfil"]
    </div>
}

<!-- CABECERA -->
<section class="cabecera-vista-emprendedor">

    <div>
        <span class="subtitulo-emprendedor">
            Mi emprendimiento
        </span>

        <h1>Perfil del emprendimiento</h1>

        <p>
            Revisa la información comercial que se mostrará públicamente
            cuando tu emprendimiento sea aprobado.
        </p>
    </div>

    <a asp-controller="Emprendedor"
       asp-action="EditarEmprendimiento"
       class="boton-editar-perfil-emprendedor">

        <i class="bi bi-pencil-square"></i>
        Editar emprendimiento

    </a>

</section>


<!-- PORTADA DEL PERFIL -->
<section class="portada-perfil-emprendimiento">

    <div class="fondo-portada-emprendimiento">

        @if (Model.Fotografias.Any())
        {
            <img src="@Model.Fotografias[0]"
                 alt="Foto de @Model.NombreComercial" />
        }

        <div class="capa-portada-emprendimiento"></div>

    </div>

    <div class="informacion-portada-emprendimiento">

        <div class="logo-perfil-emprendimiento">

            <img src="@(string.IsNullOrWhiteSpace(Model.LogoUrl) ? "/images/logo.jpg" : Model.LogoUrl)"
                 alt="Logo de @Model.NombreComercial" />

        </div>

        <div class="datos-portada-emprendimiento">

            <div class="titulo-portada-emprendimiento">

                <div>
                    <span class="categoria-perfil-emprendimiento">
                        @Model.Categoria
                    </span>

                    <h2>@Model.NombreComercial</h2>
                </div>

                <span class="estado-perfil-emprendimiento @estadoClase">
                    <i class="bi @estadoIcono"></i>
                    @estadoTexto
                </span>

            </div>

            <p>
                @Model.Descripcion
            </p>

        </div>

    </div>

</section>


<!-- RESUMEN -->
<section class="resumen-perfil-emprendimiento">

    <article class="dato-resumen-perfil">
        <span class="icono-dato-perfil productos">
            <i class="bi bi-box-seam-fill"></i>
        </span>

        <div>
            <strong>@Model.ProductosPublicados</strong>
            <span>Productos publicados</span>
        </div>
    </article>

    <article class="dato-resumen-perfil">
        <span class="icono-dato-perfil ventas">
            <i class="bi bi-bag-check-fill"></i>
        </span>

        <div>
            <strong>@Model.VentasRealizadas</strong>
            <span>Ventas realizadas</span>
        </div>
    </article>

    <article class="dato-resumen-perfil">
        <span class="icono-dato-perfil favoritos">
            <i class="bi bi-heart-fill"></i>
        </span>

        <div>
            <strong>@Model.Favoritos</strong>
            <span>Favoritos</span>
        </div>
    </article>

    <article class="dato-resumen-perfil">
        <span class="icono-dato-perfil valoracion">
            <i class="bi bi-star-fill"></i>
        </span>

        <div>
            <strong>@(Model.ValoracionPromedio?.ToString("0.0") ?? "—")</strong>
            <span>Valoración promedio</span>
        </div>
    </article>

</section>


<!-- CONTENIDO PRINCIPAL -->
<section class="grid-perfil-emprendimiento">

    <div class="columna-principal-perfil">

        <!-- ACERCA DEL EMPRENDIMIENTO -->
        <article class="bloque-perfil-emprendimiento">

            <div class="encabezado-bloque-perfil">

                <div>
                    <span class="subtitulo-emprendedor">
                        Nuestra historia
                    </span>

                    <h2>Acerca del emprendimiento</h2>
                </div>

                <a asp-controller="Emprendedor"
                   asp-action="EditarEmprendimiento">

                    <i class="bi bi-pencil"></i>
                    Editar

                </a>

            </div>

            <div class="descripcion-perfil-emprendimiento">
                <p>@Model.Descripcion</p>
            </div>

        </article>


        <!-- GALERÍA -->
        <article class="bloque-perfil-emprendimiento">

            <div class="encabezado-bloque-perfil">

                <div>
                    <span class="subtitulo-emprendedor">
                        Imágenes
                    </span>

                    <h2>Galería del emprendimiento</h2>
                </div>

                <a asp-controller="Emprendedor"
                   asp-action="EditarEmprendimiento">

                    <i class="bi bi-images"></i>
                    Administrar

                </a>

            </div>

            @if (Model.Fotografias.Any())
            {
                <div class="galeria-perfil-emprendimiento">

                    <div class="imagen-galeria-principal">
                        <img src="@Model.Fotografias[0]"
                             alt="Foto de @Model.NombreComercial" />
                    </div>

                    @for (int i = 1; i < Model.Fotografias.Count && i < 4; i++)
                    {
                        <div>
                            <img src="@Model.Fotografias[i]"
                                 alt="Foto de @Model.NombreComercial" />
                        </div>
                    }

                    @if (Model.Fotografias.Count > 4)
                    {
                        <div class="ultima-imagen-galeria">

                            <img src="@Model.Fotografias[4]"
                                 alt="Foto de @Model.NombreComercial" />

                            <span>
                                <i class="bi bi-plus-lg"></i>
                                @(Model.Fotografias.Count - 4) fotografías más
                            </span>

                        </div>
                    }

                </div>
            }
            else
            {
                <span class="nombre-archivo-emprendedor">
                    Todavía no has agregado fotografías.
                </span>
            }

        </article>


        <!-- PRODUCTOS -->
        <article class="bloque-perfil-emprendimiento">

            <div class="encabezado-bloque-perfil">

                <div>
                    <span class="subtitulo-emprendedor">
                        Catálogo
                    </span>

                    <h2>Productos destacados</h2>
                </div>

                <a asp-controller="Emprendedor"
                   asp-action="MisProductos">

                    Ver todos
                    <i class="bi bi-arrow-right"></i>

                </a>

            </div>

            @if (Model.ProductosDestacados.Any())
            {
                <div class="grid-productos-perfil">

                    @foreach (ProyectoClubCreativo.Models.ViewModels.ProductoPerfilViewModel producto in Model.ProductosDestacados)
                    {
                        <article class="producto-perfil-emprendimiento">

                            <div class="imagen-producto-perfil">

                                @if (!string.IsNullOrWhiteSpace(producto.ImagenUrl))
                                {
                                    <img src="@producto.ImagenUrl"
                                         alt="@producto.Nombre" />
                                }

                                <span class="estado-producto-perfil @producto.Estado.ToLower()">
                                    @producto.Estado
                                </span>

                            </div>

                            <div class="contenido-producto-perfil">

                                <span>@producto.Categoria</span>

                                <h3>@producto.Nombre</h3>

                                <strong>₡@producto.Precio.ToString("N0")</strong>

                            </div>

                        </article>
                    }

                </div>
            }
            else
            {
                <span class="nombre-archivo-emprendedor">
                    Todavía no has agregado productos destacados.
                </span>
            }

        </article>

    </div>


    <!-- COLUMNA LATERAL -->
    <aside class="columna-lateral-perfil">

        <!-- INFORMACIÓN COMERCIAL -->
        <article class="bloque-perfil-emprendimiento">

            <div class="encabezado-bloque-perfil">

                <div>
                    <span class="subtitulo-emprendedor">
                        Información
                    </span>

                    <h2>Datos comerciales</h2>
                </div>

            </div>

            <div class="lista-datos-comerciales">

                <div class="dato-comercial-perfil">

                    <span class="icono-dato-comercial">
                        <i class="bi bi-shop"></i>
                    </span>

                    <div>
                        <span>Nombre comercial</span>
                        <strong>@Model.NombreComercial</strong>
                    </div>

                </div>

                <div class="dato-comercial-perfil">

                    <span class="icono-dato-comercial">
                        <i class="bi bi-grid-fill"></i>
                    </span>

                    <div>
                        <span>Categoría</span>
                        <strong>@Model.Categoria</strong>
                    </div>

                </div>

                @if (!string.IsNullOrWhiteSpace(Model.Cedula))
                {
                    <div class="dato-comercial-perfil">

                        <span class="icono-dato-comercial">
                            <i class="bi bi-person-vcard-fill"></i>
                        </span>

                        <div>
                            <span>Cédula</span>
                            <strong>@Model.Cedula</strong>
                        </div>

                    </div>
                }

                @if (!string.IsNullOrWhiteSpace(Model.Telefono))
                {
                    <div class="dato-comercial-perfil">

                        <span class="icono-dato-comercial">
                            <i class="bi bi-telephone-fill"></i>
                        </span>

                        <div>
                            <span>Teléfono</span>
                            <strong>@Model.Telefono</strong>
                        </div>

                    </div>
                }

                <div class="dato-comercial-perfil">

                    <span class="icono-dato-comercial">
                        <i class="bi bi-envelope-fill"></i>
                    </span>

                    <div>
                        <span>Correo</span>
                        <strong>@Model.Correo</strong>
                    </div>

                </div>

            </div>

        </article>


        <!-- REDES -->
        @if (!string.IsNullOrWhiteSpace(Model.Instagram) ||
             !string.IsNullOrWhiteSpace(Model.Facebook) ||
             !string.IsNullOrWhiteSpace(Model.SitioWeb))
        {
            <article class="bloque-perfil-emprendimiento">

                <div class="encabezado-bloque-perfil">

                    <div>
                        <span class="subtitulo-emprendedor">
                            Contacto
                        </span>

                        <h2>Redes sociales</h2>
                    </div>

                </div>

                <div class="redes-perfil-emprendimiento">

                    @if (!string.IsNullOrWhiteSpace(Model.Instagram))
                    {
                        <a href="@Model.Instagram" target="_blank" rel="noopener noreferrer">

                            <span class="icono-red-perfil instagram">
                                <i class="bi bi-instagram"></i>
                            </span>

                            <span>
                                <strong>Instagram</strong>
                                @Model.Instagram
                            </span>

                            <i class="bi bi-box-arrow-up-right"></i>

                        </a>
                    }

                    @if (!string.IsNullOrWhiteSpace(Model.Facebook))
                    {
                        <a href="@Model.Facebook" target="_blank" rel="noopener noreferrer">

                            <span class="icono-red-perfil facebook">
                                <i class="bi bi-facebook"></i>
                            </span>

                            <span>
                                <strong>Facebook</strong>
                                @Model.Facebook
                            </span>

                            <i class="bi bi-box-arrow-up-right"></i>

                        </a>
                    }

                    @if (!string.IsNullOrWhiteSpace(Model.SitioWeb))
                    {
                        <a href="@Model.SitioWeb" target="_blank" rel="noopener noreferrer">

                            <span class="icono-red-perfil web">
                                <i class="bi bi-globe2"></i>
                            </span>

                            <span>
                                <strong>Sitio web</strong>
                                @Model.SitioWeb
                            </span>

                            <i class="bi bi-box-arrow-up-right"></i>

                        </a>
                    }

                </div>

            </article>
        }


        <!-- PARTICIPACIÓN -->
        <article class="bloque-perfil-emprendimiento">

            <div class="encabezado-bloque-perfil">

                <div>
                    <span class="subtitulo-emprendedor">
                        Comunidad
                    </span>

                    <h2>Programas de participación</h2>
                </div>

            </div>

            <div class="programa-perfil-emprendimiento @(Model.ParticipaClubCreativo ? "seleccionado" : "")">

                <span>
                    <i class="bi bi-stars"></i>
                </span>

                <div>
                    <strong>Club Creativo</strong>

                    <p>
                        @(Model.ParticipaClubCreativo
                            ? "Participación solicitada en ferias, talleres y actividades."
                            : "Aún no has solicitado participación en este programa.")
                    </p>
                </div>

                <i class="bi @(Model.ParticipaClubCreativo ? "bi-check-circle-fill" : "bi-dash-circle")"></i>

            </div>

            <div class="programa-perfil-emprendimiento @(Model.ParticipaHechoEnCr ? "seleccionado" : "")">

                <span>
                    <i class="bi bi-geo-alt-fill"></i>
                </span>

                <div>
                    <strong>Hecho en CR</strong>

                    <p>
                        @(Model.ParticipaHechoEnCr
                            ? "Ya estás participando en este programa."
                            : "Aún no has solicitado participación en este programa.")
                    </p>
                </div>

                <i class="bi @(Model.ParticipaHechoEnCr ? "bi-check-circle-fill" : "bi-dash-circle")"></i>

            </div>

        </article>


        <!-- VISTA PÚBLICA -->
        <article class="vista-publica-perfil">

            <div class="icono-vista-publica">
                <i class="bi bi-eye-fill"></i>
            </div>

            <div>
                <h2>Vista pública</h2>

                <p>
                    El perfil estará visible para los visitantes cuando
                    la solicitud sea aprobada.
                </p>

                <a asp-controller="Home"
                   asp-action="Index">

                    Vista previa
                    <i class="bi bi-arrow-right"></i>

                </a>
            </div>

        </article>

    </aside>

</section>