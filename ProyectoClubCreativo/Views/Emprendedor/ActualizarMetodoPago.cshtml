@model ProyectoClubCreativo.Models.ViewModels.PagoSuscripcionViewModel

@{
    ViewData["Title"] = "Actualizar método de pago";
    Layout = "~/Views/Shared/_LayoutEmprendedor.cshtml";
}

<section class="cabecera-vista-emprendedor">

    <div>
        <span class="subtitulo-emprendedor">
            Suscripción
        </span>

        <h1>Actualizar método de pago</h1>

        <p>
            Ingresa los datos de la nueva tarjeta que deseas utilizar
            para las próximas renovaciones automáticas.
        </p>
    </div>

    <a asp-controller="Emprendedor"
       asp-action="MiSuscripcion"
       class="boton-volver-emprendedor">

        <i class="bi bi-arrow-left"></i>
        Volver a mi suscripción

    </a>

</section>


<section class="grid-mi-suscripcion">

    <!-- COLUMNA PRINCIPAL -->
    <div class="columna-principal-suscripcion">

        <article class="bloque-suscripcion-emprendedor">

            <div class="encabezado-bloque-suscripcion">

                <div>
                    <span class="subtitulo-emprendedor">
                        Método de pago
                    </span>

                    <h2>Nueva tarjeta</h2>

                    <p>
                        La nueva tarjeta sustituirá el método de pago
                        utilizado para las renovaciones automáticas.
                    </p>
                </div>

            </div>

            <form asp-controller="Emprendedor"
                  asp-action="ActualizarMetodoPago"
                  method="post"
                  class="formulario-emprendedor"
                  novalidate>

                @Html.AntiForgeryToken()

                <input asp-for="IdPlan" type="hidden" />

                <div asp-validation-summary="ModelOnly"
                     class="resumen-validacion-emprendedor">
                </div>


                <div class="grupo-campo-emprendedor">

                    <label asp-for="NombreTitular"></label>

                    <input asp-for="NombreTitular"
                           class="control-emprendedor"
                           autocomplete="cc-name"
                           placeholder="Nombre como aparece en la tarjeta" />

                    <span asp-validation-for="NombreTitular"
                          class="mensaje-validacion-emprendedor">
                    </span>

                </div>


                <div class="grupo-campo-emprendedor">

                    <label asp-for="NumeroTarjeta"></label>

                    <input asp-for="NumeroTarjeta"
                           class="control-emprendedor"
                           inputmode="numeric"
                           autocomplete="cc-number"
                           maxlength="16"
                           placeholder="0000000000000000" />

                    <span asp-validation-for="NumeroTarjeta"
                          class="mensaje-validacion-emprendedor">
                    </span>

                </div>


                <div class="fila-formulario">

                    <div class="grupo-campo-emprendedor">

                        <label asp-for="MesVencimiento"></label>

                        <input asp-for="MesVencimiento"
                               class="control-emprendedor"
                               type="number"
                               min="1"
                               max="12"
                               autocomplete="cc-exp-month"
                               placeholder="MM" />

                        <span asp-validation-for="MesVencimiento"
                              class="mensaje-validacion-emprendedor">
                        </span>

                    </div>


                    <div class="grupo-campo-emprendedor">

                        <label asp-for="AnioVencimiento"></label>

                        <input asp-for="AnioVencimiento"
                               class="control-emprendedor"
                               type="number"
                               autocomplete="cc-exp-year"
                               placeholder="AAAA" />

                        <span asp-validation-for="AnioVencimiento"
                              class="mensaje-validacion-emprendedor">
                        </span>

                    </div>


                    <div class="grupo-campo-emprendedor">

                        <label asp-for="Cvv"></label>

                        <input asp-for="Cvv"
                               class="control-emprendedor"
                               type="password"
                               inputmode="numeric"
                               autocomplete="cc-csc"
                               maxlength="4"
                               placeholder="CVV" />

                        <span asp-validation-for="Cvv"
                              class="mensaje-validacion-emprendedor">
                        </span>

                    </div>

                </div>


                <div class="acciones-formulario-emprendedor">

                    <a asp-controller="Emprendedor"
                       asp-action="MiSuscripcion"
                       class="boton-cancelar-formulario-emprendedor">

                        Cancelar

                    </a>

                    <button type="submit"
                            class="boton-guardar-formulario-emprendedor">

                        <i class="bi bi-credit-card-fill"></i>
                        Actualizar método de pago

                    </button>

                </div>

            </form>

        </article>

    </div>


    <!-- COLUMNA LATERAL -->
    <aside class="columna-lateral-suscripcion">

        <article class="bloque-suscripcion-emprendedor">

            <div class="encabezado-bloque-suscripcion">

                <div>
                    <span class="subtitulo-emprendedor">
                        Suscripción actual
                    </span>

                    <h2>@Model.NombrePlan</h2>
                </div>

            </div>

            <div class="detalle-renovacion-suscripcion">

                <div>
                    <span>Precio</span>

                    @if (Model.Precio == 0)
                    {
                        <strong>Gratis</strong>
                    }
                    else
                    {
                        <strong>₡@Model.Precio.ToString("N0")</strong>
                    }
                </div>

                <div>
                    <span>Periodicidad</span>
                    <strong>@Model.Periodicidad</strong>
                </div>

            </div>

        </article>


        <article class="soporte-suscripcion-emprendedor">

            <span>
                <i class="bi bi-shield-lock-fill"></i>
            </span>

            <div>
                <h2>Datos protegidos</h2>

                <p>
                    Por seguridad, el sistema no almacena el número
                    completo de la tarjeta ni el código CVV.
                </p>
            </div>

        </article>

    </aside>

</section>


@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}