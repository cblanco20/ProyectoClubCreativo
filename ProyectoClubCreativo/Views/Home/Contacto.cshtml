@{
    ViewData["Title"] = "Contacto";
    Layout = "~/Views/Shared/_LayoutExterno.cshtml";
}

<section class="seccion-contacto">

    <div class="contenedor-club">

        <div class="burbuja-contacto">

            <div class="informacion-contacto">

                <span class="etiqueta-contacto">
                    Hablemos
                </span>

                <h1>Contacto</h1>

                <p>
                    ¿Tienes consultas sobre ferias, talleres,
                    productos o participación de emprendimientos?
                    Estamos para ayudarte.
                </p>

                <div class="datos-contacto">

                    <div>
                        <strong>WhatsApp</strong>
                        <span>+506 7130-1389</span>
                    </div>

                    <div>
                        <strong>Ubicación</strong>
                        <span>San José, Costa Rica</span>
                    </div>

                </div>

                <div class="decoracion-contacto">
                    Club Creativo MiVo ✦
                </div>

            </div>

            <div class="formulario-contacto d-flex flex-column justify-content-center">

                <div class="mb-4">
                    <i class="bi bi-whatsapp text-success"
                       style="font-size: 3.5rem;"></i>
                </div>

                <h2 class="mb-3">
                    ¡Conversemos!
                </h2>

                <p class="mb-3">
                    Nos encantaría conocer tus dudas, ideas
                    y consultas. Si necesitas información
                    sobre nuestros productos, eventos,
                    talleres o cómo formar parte de nuestra
                    comunidad, puedes escribirnos directamente
                    por WhatsApp.
                </p>

                <p class="mb-4">
                    Déjanos tu mensaje y con mucho gusto
                    te atenderemos lo antes posible.
                </p>

                <a href="https://wa.me/50671301389?text=Hola%2C%20me%20gustar%C3%ADa%20recibir%20informaci%C3%B3n%20sobre%20Club%20Creativo%20MiVo."
                   target="_blank"
                   rel="noopener noreferrer"
                   class="btn btn-success rounded-pill px-4 py-3 fw-bold">

                    <i class="bi bi-whatsapp me-2"></i>
                    Escríbenos por WhatsApp

                </a>

                <p class="text-muted small mt-3 mb-0">
                    Al presionar el botón, se abrirá una
                    conversación en WhatsApp.
                </p>

            </div>

        </div>
    </div>
</section>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
