@model List<ProyectoClubCreativo.Models.ViewModels.Admin.GaleriaAdminViewModel>

@{
    ViewData["Title"] = "Galería Multimedia";
    Layout = "_LayoutExterno";
    string categoriaActiva = ViewBag.CategoriaActiva as string ?? string.Empty;
    int totalFotos = Model.Sum(g => g.Imagenes.Count);
}

<section class="hero-eventos">
    <div class="container hero-eventos-grid">
        <div class="hero-eventos-texto">
            <span class="etiqueta-eventos">Momentos del Club</span>
            <h1>Galería de nuestra comunidad creativa</h1>
            <p>
                Revive los mejores momentos de ferias, talleres, emprendimientos y
                productos de Club Creativo MiVo.
            </p>
            <a href="#galeria-listado" class="boton-eventos">Ver galería</a>
        </div>
        <div class="hero-eventos-imagen">
            <img src="~/images/galeria-portada.jpg" alt="Collage de actividades de Club Creativo" />
            <div class="tarjeta-flotante-eventos">
                <i class="bi bi-images"></i>
                <div>
                                        <strong>@totalFotos foto(s)</strong>
                    <span>de nuestras actividades</span>
                </div>
            </div>
        </div>
    </div>
</section>

<section class="categorias-emprendimientos">
    <div class="container">
               <div class="lista-categorias-emprendimientos">
            <a asp-action="GaleriaMultimedia" class="categoria-chip @(categoriaActiva == "" ? "categoria-chip-activa" : "")">Todas</a>
            <a asp-action="GaleriaMultimedia" asp-route-categoria="evento" class="categoria-chip @(categoriaActiva == "evento" ? "categoria-chip-activa" : "")">Eventos</a>
            <a asp-action="GaleriaMultimedia" asp-route-categoria="emprendimiento" class="categoria-chip @(categoriaActiva == "emprendimiento" ? "categoria-chip-activa" : "")">Emprendimientos</a>
            <a asp-action="GaleriaMultimedia" asp-route-categoria="producto" class="categoria-chip @(categoriaActiva == "producto" ? "categoria-chip-activa" : "")">Productos</a>
        </div>
    </div>
</section>

<section class="emprendimientos-listado" id="galeria-listado">
    <div class="container">
                @if (Model.Count == 0)
        {
            <p>Aún no hay galerías publicadas en esta categoría.</p>
        }
        else
        {
            <div class="grid-galeria-multimedia">
                @foreach (var galeria in Model)
                {
                    @foreach (var imagen in galeria.Imagenes)
                    {
                        <div class="item-galeria-multimedia">
                            <img src="@imagen.Url" alt="@galeria.Nombre" title="@galeria.Nombre" />
                            <span>@galeria.Categoria</span>
                        </div>
                    }
                }
            </div>
        }
       
    </div>
</section>

<section class="cta-emprendimientos">
    <div class="container">
        <div class="cta-emprendimientos-contenido">
            <span>Club Creativo MiVo</span>
            <h2>¿Estuviste en una de nuestras actividades?</h2>
            <p>Compartí tus fotos con nosotros y formá parte de la próxima galería.</p>
            <a asp-controller="Home" asp-action="Contacto" class="boton-emprendimientos boton-emprendimientos-claro">
                Enviar mis fotos
            </a>
        </div>
    </div>
</section>
