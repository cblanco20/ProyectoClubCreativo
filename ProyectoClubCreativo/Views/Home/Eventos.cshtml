@using ProyectoClubCreativo.Models.Entities
@using ProyectoClubCreativo.Models.ViewModels

@{
    ViewData["Title"] = "Eventos";
    Layout = "_LayoutExterno";

    List<EventoPublicoViewModel> eventos =
        ViewBag.Eventos as List<EventoPublicoViewModel> ?? new();

    List<Categoria> categorias =
        ViewBag.CategoriasEvento as List<Categoria> ?? new();

    int? categoriaSeleccionada = ViewBag.CategoriaSeleccionada as int?;

    string imagenPorDefecto = Url.Content("~/images/hero-feria.jpg");
}

<!-- HERO -->
<section class="hero-eventos">
    <div class="container hero-eventos-grid">

        <div class="hero-eventos-texto">
            <span class="etiqueta-eventos">
                Agenda creativa
            </span>

            <h1>Vive experiencias que conectan arte y comunidad</h1>

            <p>
                Ferias, exposiciones y encuentros creados para descubrir
                emprendimientos, talleres y talento costarricense.
            </p>

            <a href="#eventos-listado"
               class="boton-eventos">
                Ver próximos eventos
            </a>
        </div>

        <div class="hero-eventos-imagen">
            <img src="~/images/hero-feria.jpg"
                 alt="Feria de emprendimientos de Club Creativo" />

            @if (eventos.Any())
            {
                <div class="tarjeta-flotante-eventos">
                    <i class="bi bi-calendar-heart-fill"></i>

                    <div>
                        <strong>Próximo evento</strong>
                        <span>@eventos.First().FechaTexto</span>
                    </div>
                </div>
            }

    </div>
</section>


<!-- INTRODUCCIÓN -->
<section class="introduccion-eventos">
    <div class="container">

        <div class="titulo-eventos-centro">
            <span class="subtitulo-eventos">
                Agenda completa
            </span>

            <h2>Todos nuestros eventos en un solo lugar</h2>

            <p>
                Desde ferias de emprendimientos hasta encuentros temáticos,
                aquí encontrás toda la información para participar.
            </p>
        </div>

    </div>
</section>


    <!-- LISTADO DE EVENTOS -->
    <section class="eventos-listado" id="eventos-listado">
        <div class="container">

            @if (categorias.Any())
            {
                <div class="filtros-eventos">

                    <a asp-controller="Home"
                       asp-action="Eventos"
                       class="chip-filtro-evento @(categoriaSeleccionada is null ? "activo" : "")">
                        Todos
                    </a>

                    @foreach (Categoria categoria in categorias)
                    {
                        <a asp-controller="Home"
                           asp-action="Eventos"
                           asp-route-categoria="@categoria.IdCategoria"
                           class="chip-filtro-evento @(categoriaSeleccionada == categoria.IdCategoria ? "activo" : "")">
                            @categoria.Nombre
                        </a>
                    }

                </div>
            }

            @if (!eventos.Any())
            {
                <div class="sin-eventos-pagina">

                    <i class="bi bi-calendar-x"></i>

                    @if (categoriaSeleccionada is null)
                    {
                        <h3>No hay eventos disponibles por el momento</h3>

                        <p>
                            Estamos preparando nuevas actividades.
                            Vuelve pronto para conocerlas.
                        </p>
                    }
                    else
                    {
                        <h3>No hay eventos disponibles en esta categoría</h3>

                        <p>
                            Prueba con otra categoría o consulta todos los eventos.
                        </p>

                        <a asp-controller="Home"
                           asp-action="Eventos"
                           class="enlace-evento-pagina">
                            Ver todos los eventos
                            <i class="bi bi-arrow-right"></i>
                        </a>
                    }

                </div>
            }
            else
            {
                <div class="grid-eventos-pagina">

                    @foreach (EventoPublicoViewModel evento in eventos)
                    {
                        string descripcion = evento.Descripcion.Length > 140
                            ? evento.Descripcion[..140].TrimEnd() + "…"
                            : evento.Descripcion;

                        string imagen = string.IsNullOrWhiteSpace(evento.ImagenUrl)
                            ? imagenPorDefecto
                            : Url.Content(evento.ImagenUrl);

                        <article class="tarjeta-evento-pagina">
                            <img src="@imagen"
                                 alt="@evento.Nombre" />

                            <div class="cuerpo-evento-pagina">
                                <span class="fecha-evento-pagina">@evento.FechaTexto</span>

                                @if (!string.IsNullOrWhiteSpace(evento.Categoria))
                                {
                                    <span class="categoria-evento-pagina">@evento.Categoria</span>
                                }

                                <h3>@evento.Nombre</h3>

                                <p>@descripcion</p>

                                <div class="datos-evento-pagina">
                                    <span><i class="bi bi-geo-alt-fill"></i> @evento.Ubicacion</span>
                                    <span><i class="bi bi-clock-fill"></i> @evento.HoraTexto</span>
                                </div>

                                <a asp-controller="Home"
                                   asp-action="DetalleEvento"
                                   asp-route-id="@evento.IdEvento"
                                   class="enlace-evento-pagina">
                                    Ver evento
                                    <i class="bi bi-arrow-right"></i>
                                </a>
                            </div>
                        </article>
                    }

                </div>
            }

        </div>
    </section>


<!-- CTA FINAL -->
<section class="cta-eventos">
    <div class="container">

        <div class="cta-eventos-contenido">
            <span>Club Creativo MiVo</span>

            <h2>No te pierdas nuestros próximos eventos</h2>

            <p>
                Registrate en el Club y recibí información anticipada
                sobre fechas, cupos y actividades especiales.
            </p>

            <a asp-controller="Cuenta"
               asp-action="SeleccionarRegistro"
               class="boton-eventos boton-eventos-claro">
                Crear una cuenta
            </a>
        </div>

    </div>
</section>
