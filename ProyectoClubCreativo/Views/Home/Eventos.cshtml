@{
    ViewData["Title"] = "Eventos";
    Layout = "_LayoutExterno";
}

<!-- HERO -->
<section class="hero-eventos">
    <div class="container hero-eventos-grid">

        <div class="hero-eventos-texto">
            <span class="etiqueta-eventos">
                Agenda creativa
            </span>

            <h1>Vive experiencias que conectan arte y comunidad</h1>

            <p>
                Ferias, exposiciones y encuentros creados para descubrir
                emprendimientos, talleres y talento costarricense.
            </p>

            <a href="#eventos-listado"
               class="boton-eventos">
                Ver próximos eventos
            </a>
        </div>

        <div class="hero-eventos-imagen">
            <img src="~/images/hero-feria.jpg"
                 alt="Feria de emprendimientos de Club Creativo" />

            <div class="tarjeta-flotante-eventos">
                <i class="bi bi-calendar-heart-fill"></i>

                <div>
                    <strong>Próximo evento</strong>
                    <span>15 y 16 de agosto</span>
                </div>
            </div>
        </div>

    </div>
</section>


<!-- INTRODUCCIÓN -->
<section class="introduccion-eventos">
    <div class="container">

        <div class="titulo-eventos-centro">
            <span class="subtitulo-eventos">
                Agenda completa
            </span>

            <h2>Todos nuestros eventos en un solo lugar</h2>

            <p>
                Desde ferias de emprendimientos hasta encuentros temáticos,
                aquí encontrás toda la información para participar.
            </p>
        </div>

    </div>
</section>


<!-- LISTADO DE EVENTOS -->
<section class="eventos-listado" id="eventos-listado">
    <div class="container">

        <div class="grid-eventos-pagina">

            <article class="tarjeta-evento-pagina">
                <img src="~/images/evento-san-pedro.jpg"
                     alt="Arte Inarrivo San Pedro" />

                <div class="cuerpo-evento-pagina">
                    <span class="fecha-evento-pagina">15 y 16 de agosto</span>

                    <h3>Arte Inarrivo San Pedro</h3>

                    <p>
                        Una edición especial con arte, diseño y
                        emprendimientos locales.
                    </p>

                    <div class="datos-evento-pagina">
                        <span><i class="bi bi-geo-alt-fill"></i> San Pedro</span>
                        <span><i class="bi bi-clock-fill"></i> 12:00 p. m.</span>
                    </div>

                    <a href="#" class="enlace-evento-pagina">
                        Ver evento
                        <i class="bi bi-arrow-right"></i>
                    </a>
                </div>
            </article>

            <article class="tarjeta-evento-pagina">
                <img src="~/images/evento-santa-ana.jpg"
                     alt="Feria Creativa Santa Ana" />

                <div class="cuerpo-evento-pagina">
                    <span class="fecha-evento-pagina">5 al 7 de septiembre</span>

                    <h3>Feria Creativa Santa Ana</h3>

                    <p>
                        Marcas creativas, productos únicos y actividades
                        para toda la comunidad.
                    </p>

                    <div class="datos-evento-pagina">
                        <span><i class="bi bi-geo-alt-fill"></i> Santa Ana</span>
                        <span><i class="bi bi-clock-fill"></i> 10:00 a. m.</span>
                    </div>

                    <a href="#" class="enlace-evento-pagina">
                        Ver evento
                        <i class="bi bi-arrow-right"></i>
                    </a>
                </div>
            </article>

            <article class="tarjeta-evento-pagina">
                <img src="~/images/evento-madres.jpg"
                     alt="Edición especial Día de las Madres" />

                <div class="cuerpo-evento-pagina">
                    <span class="fecha-evento-pagina">Edición especial</span>

                    <h3>Día de las Madres</h3>

                    <p>
                        Regalos, experiencias y talento local para
                        celebrar a mamá.
                    </p>

                    <div class="datos-evento-pagina">
                        <span><i class="bi bi-geo-alt-fill"></i> Heredia</span>
                        <span><i class="bi bi-clock-fill"></i> 11:00 a. m.</span>
                    </div>

                    <a href="#" class="enlace-evento-pagina">
                        Ver evento
                        <i class="bi bi-arrow-right"></i>
                    </a>
                </div>
            </article>

            <article class="tarjeta-evento-pagina">
                <img src="~/images/convivencia.jpg"
                     alt="Convivencia creativa de la comunidad" />

                <div class="cuerpo-evento-pagina">
                    <span class="fecha-evento-pagina">28 de septiembre</span>

                    <h3>Convivencia Creativa MiVo</h3>

                    <p>
                        Una tarde para compartir en comunidad, conocer
                        emprendimientos y disfrutar de música en vivo.
                    </p>

                    <div class="datos-evento-pagina">
                        <span><i class="bi bi-geo-alt-fill"></i> Alajuela</span>
                        <span><i class="bi bi-clock-fill"></i> 2:00 p. m.</span>
                    </div>

                    <a href="#" class="enlace-evento-pagina">
                        Ver evento
                        <i class="bi bi-arrow-right"></i>
                    </a>
                </div>
            </article>

            <article class="tarjeta-evento-pagina">
                <img src="~/images/feria-promociones.jpg"
                     alt="Feria de emprendimientos con promociones" />

                <div class="cuerpo-evento-pagina">
                    <span class="fecha-evento-pagina">12 de octubre</span>

                    <h3>Feria de Fin de Año Anticipada</h3>

                    <p>
                        Adelanto de las promociones de fin de año con
                        productos de nuestros emprendimientos aliados.
                    </p>

                    <div class="datos-evento-pagina">
                        <span><i class="bi bi-geo-alt-fill"></i> San José</span>
                        <span><i class="bi bi-clock-fill"></i> 9:00 a. m.</span>
                    </div>

                    <a href="#" class="enlace-evento-pagina">
                        Ver evento
                        <i class="bi bi-arrow-right"></i>
                    </a>
                </div>
            </article>

            <article class="tarjeta-evento-pagina">
                <img src="~/images/acceso-feria.jpg"
                     alt="Feria creativa nocturna" />

                <div class="cuerpo-evento-pagina">
                    <span class="fecha-evento-pagina">Próximamente</span>

                    <h3>Feria Creativa Nocturna</h3>

                    <p>
                        Una nueva edición con exposiciones, música y
                        emprendimientos bajo las estrellas.
                    </p>

                    <div class="datos-evento-pagina">
                        <span><i class="bi bi-geo-alt-fill"></i> Por confirmar</span>
                        <span><i class="bi bi-clock-fill"></i> 6:00 p. m.</span>
                    </div>

                    <a href="#" class="enlace-evento-pagina">
                        Ver evento
                        <i class="bi bi-arrow-right"></i>
                    </a>
                </div>
            </article>

        </div>

    </div>
</section>


<!-- CTA FINAL -->
<section class="cta-eventos">
    <div class="container">

        <div class="cta-eventos-contenido">
            <span>Club Creativo MiVo</span>

            <h2>No te pierdas nuestros próximos eventos</h2>

            <p>
                Registrate en el Club y recibí información anticipada
                sobre fechas, cupos y actividades especiales.
            </p>

            <a asp-controller="Cuenta"
               asp-action="SeleccionarRegistro"
               class="boton-eventos boton-eventos-claro">
                Crear una cuenta
            </a>
        </div>

    </div>
</section>
