@model ProyectoClubCreativo.Models.ViewModels.DetalleNoticiaPublicaViewModel

@{
    var cultura = new System.Globalization.CultureInfo("es-CR");
    var noticia = Model.Noticia;
    string[] parrafos = noticia.Contenido
        .Split(new[] { "\r\n", "\n" }, StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries);
    int minutos = Math.Max(1, (int)Math.Ceiling(noticia.Contenido.Split(' ', StringSplitOptions.RemoveEmptyEntries).Length / 200.0));
    ViewData["Title"] = noticia.Titulo;
    Layout = "_LayoutExterno";
}

<!-- ENCABEZADO DE LA NOTICIA -->
<section class="encabezado-detalle-noticia">
    <div class="container">

        <nav class="migas-detalle-noticia"
             aria-label="Navegación secundaria">

            <a asp-controller="Home"
               asp-action="Index">
                Inicio
            </a>

            <i class="bi bi-chevron-right"></i>

            <a asp-controller="Home"
               asp-action="Noticias">
                Noticias
            </a>

            <i class="bi bi-chevron-right"></i>

            <span>@noticia.Titulo</span>
        </nav>

        <div class="contenido-encabezado-detalle">

            <span class="categoria-detalle-noticia">
                @noticia.Tipo
            </span>

            <h1>@noticia.Titulo</h1>

            <p class="resumen-detalle-noticia">@noticia.Resumen</p>

            <div class="informacion-detalle-noticia">

                <div>
                    <i class="bi bi-calendar3"></i>
                    <span>@noticia.Fecha.ToString("d 'de' MMMM 'de' yyyy", cultura)</span>
                </div>

                <div>
                    <i class="bi bi-clock"></i>
                    <span>@minutos min de lectura</span>
                </div>

                <div>
                    <i class="bi bi-person-circle"></i>
                    <span>Club Creativo MiVo</span>
                </div>

            </div>

        </div>

    </div>
</section>


<!-- IMAGEN PRINCIPAL -->
<section class="imagen-principal-detalle-noticia">
    <div class="container">

        <div class="contenedor-imagen-detalle">
            <img src="@noticia.ImagenUrl" alt="@noticia.Titulo" />
        </div>

    </div>
</section>


<!-- CONTENIDO DE LA NOTICIA -->
<section class="contenido-detalle-noticia">
    <div class="container">

        <div class="distribucion-detalle-noticia">
         
            <!-- ARTÍCULO -->
            <article class="articulo-detalle-noticia">

                @for (int i = 0; i < parrafos.Length; i++)
                {
                    <p class="@(i == 0 ? "primer-parrafo-detalle" : "")">@parrafos[i]</p>
                }

            </article>

        </div>

    </div>
</section>


<!-- AUTOR -->
<section class="autor-detalle-noticia">
    <div class="container">

        <div class="tarjeta-autor-noticia">

            <div class="icono-autor-noticia">
                <i class="bi bi-megaphone-fill"></i>
            </div>

            <div class="informacion-autor-noticia">

                <span>Publicado por</span>

                <h2>Club Creativo MiVo</h2>

                <p>
                    Compartimos noticias, oportunidades y actividades para
                    fortalecer la creatividad, el emprendimiento y la
                    participación de nuestra comunidad.
                </p>

            </div>

            <a asp-controller="Home"
               asp-action="Noticias"
               class="boton-volver-noticias">
                Ver más noticias
            </a>

        </div>

    </div>
</section>


<!-- NOTICIAS RELACIONADAS -->
<section class="noticias-relacionadas-detalle">
    <div class="container">

        <div class="encabezado-relacionadas-detalle">

            <div>
                <span class="subtitulo-detalle-noticia">
                    Sigue explorando
                </span>

                <h2>Noticias relacionadas</h2>
            </div>

            <a asp-controller="Home"
               asp-action="Noticias">
                Ver todas las noticias
                <i class="bi bi-arrow-right"></i>
            </a>

        </div>

        <div class="grid-relacionadas-detalle">

            @foreach (var relacionada in Model.Relacionadas)
            {
                <article class="tarjeta-relacionada-detalle">

                    <div class="imagen-relacionada-detalle">
                        <img src="@relacionada.ImagenUrl" alt="@relacionada.Titulo" />

                        <span>@relacionada.Tipo</span>
                    </div>

                    <div class="contenido-relacionada-detalle">

                        <div class="fecha-relacionada-detalle">
                            <i class="bi bi-calendar3"></i>
                            @relacionada.Fecha.ToString("d 'de' MMMM 'de' yyyy", cultura)
                        </div>

                        <h3>@relacionada.Titulo</h3>

                        <p>@relacionada.Resumen</p>

                        <a asp-controller="Home"
                           asp-action="DetalleNoticia"
                           asp-route-id="@relacionada.Id">
                            Leer noticia
                            <i class="bi bi-arrow-right"></i>
                        </a>

                    </div>

                </article>
            }

        </div>

    </div>
</section>


<!-- CTA FINAL -->
<section class="cta-detalle-noticia">
    <div class="container">

        <div class="contenido-cta-detalle">

            <span>Club Creativo MiVo</span>

            <h2>Forma parte de nuestra comunidad creativa</h2>

            <p>
                Conoce nuevas actividades, apoya emprendimientos locales
                y comparte experiencias con personas que disfrutan crear.
            </p>

            <a asp-controller="Cuenta"
               asp-action="SeleccionarRegistro"
               class="boton-cta-detalle-noticia">
                Crear una cuenta
            </a>

        </div>

    </div>
</section>