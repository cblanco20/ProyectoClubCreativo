@{
    ViewData["Title"] = "Talleres";
    Layout = "_LayoutExterno";
}

<!-- HERO -->
<section class="hero-talleres">
    <div class="container hero-talleres-grid">

        <div class="hero-talleres-texto">
            <span class="etiqueta-talleres">
                Aprendé haciendo
            </span>

            <h1>Talleres pensados para despertar tu creatividad</h1>

            <p>
                Aprendé nuevas técnicas junto a facilitadores locales,
                en espacios pequeños y con materiales incluidos.
            </p>

            <a href="#talleres-listado"
               class="boton-talleres">
                Ver talleres disponibles
            </a>
        </div>

        <div class="hero-talleres-imagen">
            <img src="~/images/taller-ceramica.jpg"
                 alt="Persona participando en un taller de cerámica" />

            <div class="insignia-flotante-talleres">
                <span>Cupos</span>
                <strong>limitados</strong>
            </div>
        </div>

    </div>
</section>


<!-- INTRODUCCIÓN -->
<section class="introduccion-talleres">
    <div class="container">

        <div class="titulo-talleres-centro">
            <span class="subtitulo-talleres">
                Nuestra oferta
            </span>

            <h2>Elegí el taller que va con vos</h2>

            <p>
                Contamos con talleres para todos los niveles, ideales
                para principiantes y para quienes ya tienen experiencia.
            </p>
        </div>

    </div>
</section>


<!-- LISTADO -->
<section class="talleres-listado" id="talleres-listado">
    <div class="container">

        <div class="grid-talleres-pagina">

            <article class="tarjeta-taller-pagina">
                <img src="~/images/taller-ceramica.jpg"
                     alt="Taller de cerámica" />

                <div class="cuerpo-taller-pagina">
                    <span class="disponibilidad-taller-pagina">
                        Cupos disponibles
                    </span>

                    <h3>Cerámica para principiantes</h3>

                    <p>
                        Aprendé las técnicas básicas del modelado y
                        creá tu primera pieza en arcilla.
                    </p>

                    <div class="datos-taller-pagina">
                        <span><i class="bi bi-calendar3"></i> Sábado 23</span>
                        <span><i class="bi bi-geo-alt-fill"></i> Escazú</span>
                    </div>

                    <a asp-controller="Home" asp-action="DetalleTaller" asp-route-name="Cerámica para principiantes" class="enlace-taller-pagina">
                        Reservar cupo
                        <i class="bi bi-arrow-right"></i>
                    </a>
                </div>
            </article>

            <article class="tarjeta-taller-pagina">
                <img src="~/images/taller-bordado.jpg"
                     alt="Taller de bordado creativo" />

                <div class="cuerpo-taller-pagina">
                    <span class="disponibilidad-taller-pagina">
                        Cupos disponibles
                    </span>

                    <h3>Bordado creativo</h3>

                    <p>
                        Descubrí puntadas básicas y decorá tus propias
                        prendas y accesorios.
                    </p>

                    <div class="datos-taller-pagina">
                        <span><i class="bi bi-calendar3"></i> Domingo 24</span>
                        <span><i class="bi bi-geo-alt-fill"></i> Santa Ana</span>
                    </div>

                    <a asp-controller="Home" asp-action="DetalleTaller" asp-route-name="Cerámica para principiantes" class="enlace-taller-pagina">
                        Reservar cupo
                        <i class="bi bi-arrow-right"></i>
                    </a>
                </div>
            </article>

            <article class="tarjeta-taller-pagina">
                <img src="~/images/taller-velas.jpg"
                     alt="Taller de velas artesanales" />

                <div class="cuerpo-taller-pagina">
                    <span class="disponibilidad-taller-pagina disponibilidad-taller-limitada">
                        Cupos limitados
                    </span>

                    <h3>Velas artesanales</h3>

                    <p>
                        Elaborá tus propias velas con cera vegetal y
                        aromas naturales.
                    </p>

                    <div class="datos-taller-pagina">
                        <span><i class="bi bi-calendar3"></i> Sábado 30</span>
                        <span><i class="bi bi-geo-alt-fill"></i> Heredia</span>
                    </div>

                    <a asp-controller="Home" asp-action="DetalleTaller" asp-route-name="Cerámica para principiantes" class="enlace-taller-pagina">
                        Reservar cupo
                        <i class="bi bi-arrow-right"></i>
                    </a>
                </div>
            </article>

            <article class="tarjeta-taller-pagina">
                <img src="~/images/taller-joyeria.jpg"
                     alt="Taller de joyería en arcilla" />

                <div class="cuerpo-taller-pagina">
                    <span class="disponibilidad-taller-pagina">
                        Cupos disponibles
                    </span>

                    <h3>Joyería en arcilla</h3>

                    <p>
                        Creá aretes, pulseras y collares únicos usando
                        arcilla polimérica.
                    </p>

                    <div class="datos-taller-pagina">
                        <span><i class="bi bi-calendar3"></i> Domingo 31</span>
                        <span><i class="bi bi-geo-alt-fill"></i> Alajuela</span>
                    </div>

                    <a asp-controller="Home" asp-action="DetalleTaller" asp-route-name="Cerámica para principiantes" class="enlace-taller-pagina">
                        Reservar cupo
                        <i class="bi bi-arrow-right"></i>
                    </a>
                </div>
            </article>

            <article class="tarjeta-taller-pagina">
                <img src="~/images/producto-4.jpg"
                     alt="Taller de ilustración y pintura" />

                <div class="cuerpo-taller-pagina">
                    <span class="disponibilidad-taller-pagina">
                        Cupos disponibles
                    </span>

                    <h3>Ilustración y pintura</h3>

                    <p>
                        Explorá distintas técnicas de pintura y desarrollá
                        tu propio estilo creativo.
                    </p>

                    <div class="datos-taller-pagina">
                        <span><i class="bi bi-calendar3"></i> Sábado 6</span>
                        <span><i class="bi bi-geo-alt-fill"></i> San José</span>
                    </div>

                    <a asp-controller="Home" asp-action="DetalleTaller" asp-route-name="Cerámica para principiantes" class="enlace-taller-pagina">
                        Reservar cupo
                        <i class="bi bi-arrow-right"></i>
                    </a>
                </div>
            </article>

            <article class="tarjeta-taller-pagina">
                <img src="~/images/noticia-taller.jpg"
                     alt="Taller de manualidades para principiantes" />

                <div class="cuerpo-taller-pagina">
                    <span class="disponibilidad-taller-pagina disponibilidad-taller-limitada">
                        Cupos limitados
                    </span>

                    <h3>Manualidades desde cero</h3>

                    <p>
                        Un taller introductorio ideal para quienes quieren
                        empezar a desarrollar su creatividad.
                    </p>

                    <div class="datos-taller-pagina">
                        <span><i class="bi bi-calendar3"></i> Domingo 7</span>
                        <span><i class="bi bi-geo-alt-fill"></i> San Pedro</span>
                    </div>

                    <a asp-controller="Home" asp-action="DetalleTaller" asp-route-name="Cerámica para principiantes" class="enlace-taller-pagina">
                        Reservar cupo
                        <i class="bi bi-arrow-right"></i>
                    </a>
                </div>
            </article>

        </div>

    </div>
</section>


<!-- BENEFICIOS -->
<section class="beneficios-talleres">
    <div class="container">

        <div class="titulo-talleres-centro">
            <span class="subtitulo-talleres">
                ¿Por qué participar?
            </span>

            <h2>Una experiencia pensada para vos</h2>
        </div>

        <div class="grid-beneficios-talleres">

            <article class="beneficio-taller">
                <div class="icono-beneficio-taller">
                    <i class="bi bi-box-seam-fill"></i>
                </div>

                <h3>Materiales incluidos</h3>

                <p>
                    Todos los materiales básicos están incluidos en
                    el costo de inscripción.
                </p>
            </article>

            <article class="beneficio-taller">
                <div class="icono-beneficio-taller">
                    <i class="bi bi-person-workspace"></i>
                </div>

                <h3>Grupos pequeños</h3>

                <p>
                    Cupos limitados para una atención personalizada
                    por parte del facilitador.
                </p>
            </article>

            <article class="beneficio-taller">
                <div class="icono-beneficio-taller">
                    <i class="bi bi-award-fill"></i>
                </div>

                <h3>Certificado</h3>

                <p>
                    Recibí un certificado de participación al finalizar
                    cada taller.
                </p>
            </article>

        </div>

    </div>
</section>


<!-- CTA FINAL -->
<section class="cta-talleres">
    <div class="container">

        <div class="cta-talleres-contenido">
            <span>Club Creativo MiVo</span>

            <h2>Reservá tu cupo antes de que se agote</h2>

            <p>
                Los talleres tienen espacio limitado. Registrate para
                asegurar tu lugar en la próxima edición.
            </p>

            <a asp-controller="Cuenta"
               asp-action="SeleccionarRegistro"
               class="boton-talleres boton-talleres-claro">
                Crear una cuenta
            </a>
        </div>

    </div>
</section>
