@{
    ViewData["Title"] = "Detalle de Producto";
    Layout = "_LayoutExterno";
}

<section class="encabezado-detalle-emprendimiento">
    <div class="container">
        <nav class="migas-detalle-emprendimiento" aria-label="Navegación secundaria">
            <a asp-controller="Home" asp-action="Index">Inicio</a>
            <i class="bi bi-chevron-right"></i>
            <a asp-controller="Home" asp-action="CatalogoProductos">Productos</a>
            <i class="bi bi-chevron-right"></i>
            <span>@ViewData["NombreProducto"]</span>
        </nav>

        <div class="perfil-detalle-emprendimiento">
            <img src="~/images/producto-1.jpg" alt="Foto principal del producto" class="logo-detalle-emprendimiento" />

            <div class="informacion-perfil-emprendimiento">
                <span class="categoria-detalle-emprendimiento">Joyería</span>
                <h1>@ViewData["NombreProducto"]</h1>
                <p class="resumen-detalle-emprendimiento">
                    Aretes artesanales tejidos a mano con hilo encerado y semillas naturales recolectadas en distintas zonas del país.
                </p>
                <p class="precio-detalle-producto">₡6.500</p>
                <div class="datos-perfil-emprendimiento">
                    <span><i class="bi bi-shop"></i> Orquídea</span>
                    <span><i class="bi bi-star-fill"></i> 4.9 (32 reseñas)</span>
                    <span><i class="bi bi-box-seam"></i> Stock disponible</span>
                </div>
            </div>
        </div>
    </div>
</section>

<section class="galeria-detalle-emprendimiento">
    <div class="container">
        <div class="grid-galeria-emprendimiento">
            <img src="~/images/producto-1.jpg" alt="Producto, vista principal" />
            <img src="~/images/producto-detalle-zoom.jpg" alt="Producto, detalle de acabado" />
            <img src="~/images/producto-2.jpg" alt="Producto, tercera vista" />
        </div>
    </div>
</section>

<section class="contenido-detalle-emprendimiento">
    <div class="container distribucion-detalle-emprendimiento">
        <article class="informacion-detalle-emprendimiento">
            <h2>Descripción</h2>
            <p>
                Cada pieza se elabora a mano utilizando técnicas de tejido artesanal, combinando
                hilo encerado con semillas naturales seleccionadas por su color y textura.
            </p>
            <p>
                Por tratarse de un producto hecho a mano, pueden existir pequeñas variaciones
                entre piezas, lo que hace que cada producto sea único.
            </p>

            <h2>Detalles del producto</h2>
            <div class="grid-productos-emprendimiento">
                <article class="producto-detalle-emprendimiento">
                    <img src="~/images/producto-1.jpg" alt="Material del producto" />
                    <h3>Material</h3>
                    <p>Hilo encerado y semillas naturales.</p>
                </article>
                <article class="producto-detalle-emprendimiento">
                    <img src="~/images/producto-2.jpg" alt="Cuidados del producto" />
                    <h3>Cuidados</h3>
                    <p>Evitar contacto prolongado con agua y perfumes.</p>
                </article>
                <article class="producto-detalle-emprendimiento">
                    <img src="~/images/producto-4.jpg" alt="Origen del producto" />
                    <h3>Origen</h3>
                    <p>Hecho a mano en Escazú, San José.</p>
                </article>
            </div>
        </article>

        <aside class="tarjeta-contacto-emprendimiento">
            <h2>Comprar producto</h2>
            <ul class="lista-contacto-emprendimiento">
                <li><i class="bi bi-tag-fill"></i><span>Categoría: Joyería</span></li>
                <li><i class="bi bi-box-seam"></i><span>Stock: 14 unidades</span></li>
                <li><i class="bi bi-shop"></i><span>Emprendimiento: Orquídea</span></li>
                <li><i class="bi bi-truck"></i><span>Entrega o retiro en ferias</span></li>
            </ul>
            <a href="#" class="boton-contacto-emprendimiento">
                Agregar al carrito
            </a>
        </aside>
    </div>
</section>

<section class="relacionados-detalle-emprendimiento">
    <div class="container">
        <div class="encabezado-relacionados-emprendimiento">
            <div>
                <span class="subtitulo-emprendimientos">Sigue explorando</span>
                <h2>Otros productos que te pueden interesar</h2>
            </div>
            <a asp-controller="Home" asp-action="CatalogoProductos">
                Ver todo el catálogo <i class="bi bi-arrow-right"></i>
            </a>
        </div>

        <div class="grid-relacionados-emprendimiento">
            <article class="tarjeta-relacionada-emprendimiento">
                <img src="~/images/producto-3.jpg" alt="Vela Luz Natural" />
                <div>
                    <span>Velas y aromas</span>
                    <h3>Vela Luz Natural</h3>
                    <a asp-controller="Home" asp-action="DetalleProducto" asp-route-name="Vela Luz Natural">
                        Ver producto <i class="bi bi-arrow-right"></i>
                    </a>
                </div>
            </article>
            <article class="tarjeta-relacionada-emprendimiento">
                <img src="~/images/taller-joyeria.jpg" alt="Pulsera Arcilla Viva" />
                <div>
                    <span>Joyería</span>
                    <h3>Pulsera Arcilla Viva</h3>
                    <a asp-controller="Home" asp-action="DetalleProducto" asp-route-name="Pulsera Arcilla Viva">
                        Ver producto <i class="bi bi-arrow-right"></i>
                    </a>
                </div>
            </article>
        </div>
    </div>
</section>

<section class="cta-detalle-emprendimiento">
    <div class="container">
        <div class="contenido-cta-detalle-emprendimiento">
            <span>Club Creativo MiVo</span>
            <h2>¿Querés conocer más productos?</h2>
            <p>Explorá el catálogo completo y apoyá el talento creativo costarricense.</p>
            <a asp-controller="Home" asp-action="CatalogoProductos" class="boton-cta-detalle-emprendimiento">
                Ver catálogo
            </a>
        </div>
    </div>
</section>
