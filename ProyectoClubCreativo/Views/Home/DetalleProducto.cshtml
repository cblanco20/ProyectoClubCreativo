@model ProyectoClubCreativo.Models.Entities.Producto

@{
    ViewData["Title"] = "Detalle de Producto";
    Layout = "_LayoutExterno";

    string imagen = Model.ProductoImagene?.UrlImagen
        ?? "/images/logo.jpg";

    string categoria = Model.IdCategoriaNavigation?.Nombre
        ?? "Sin categoría";

    string emprendimiento = Model.IdEmprendimientoNavigation?.NombreComercial
        ?? "Emprendimiento";
}

<section class="encabezado-detalle-emprendimiento">
    <div class="container">

        <nav class="migas-detalle-emprendimiento"
             aria-label="Navegación secundaria">

            <a asp-controller="Home" asp-action="Index">
                Inicio
            </a>

            <i class="bi bi-chevron-right"></i>

            <a asp-controller="Home" asp-action="CatalogoProductos">
                Productos
            </a>

            <i class="bi bi-chevron-right"></i>

            <span>@Model.Nombre</span>
        </nav>

        <div class="perfil-detalle-emprendimiento">

            <img src="@imagen"
                 alt="@Model.Nombre"
                 class="logo-detalle-emprendimiento" />

            <div class="informacion-perfil-emprendimiento">

                <span class="categoria-detalle-emprendimiento">
                    @categoria
                </span>

                <h1>@Model.Nombre</h1>

                <p class="resumen-detalle-emprendimiento">
                    @Model.Descripcion
                </p>

                <p class="precio-detalle-producto">
                    ₡@Model.Precio.ToString("N0")
                </p>

                <div class="datos-perfil-emprendimiento">

                    <span>
                        <i class="bi bi-shop"></i>
                        @emprendimiento
                    </span>

                    <span>
                        <i class="bi bi-box-seam"></i>

                       
                        @if (Model.StockActual > 0)
                        {
                            <text>Stock disponible</text>
                        }
                        else
                        {
                            <text>Agotado</text>
                        }

                    </span>

                </div>
            </div>
        </div>
    </div>
</section>

<section class="galeria-detalle-emprendimiento">
    <div class="container">

        <div class="grid-galeria-emprendimiento">

            <img src="@imagen"
                 alt="Imagen de @Model.Nombre" />

        </div>
    </div>
</section>

<section class="contenido-detalle-emprendimiento">
    <div class="container distribucion-detalle-emprendimiento">

        <article class="informacion-detalle-emprendimiento">

            <h2>Descripción</h2>

            <p>@Model.Descripcion</p>

            <h2>Detalles del producto</h2>

            
            <div class="grid-productos-emprendimiento">

                <article class="producto-detalle-emprendimiento">
                    <h3>Categoría</h3>
                    <p>@categoria</p>
                </article>

                <article class="producto-detalle-emprendimiento">
                    <h3>Disponibilidad</h3>

                    <p>

                        @if (Model.StockActual > 0)
                        {
                            <text>@Model.StockActual unidades disponibles</text>
                        }
                        else
                        {
                            <strong>Agotado</strong>
                        }

                    </p>
                </article>

                <article class="producto-detalle-emprendimiento">
                    <h3>Emprendimiento</h3>
                    <p>@emprendimiento</p>
                </article>

            </div>

        </article>

        <aside class="tarjeta-contacto-emprendimiento">

            <h2>Información del producto</h2>

            <ul class="lista-contacto-emprendimiento">

                <li>
                    <i class="bi bi-tag-fill"></i>
                    <span>Categoría: @categoria</span>
                </li>

                <li>
                    <i class="bi bi-box-seam"></i>
                    <span>Stock: @Model.StockActual unidades</span>
                </li>

                <li>
                    <i class="bi bi-shop"></i>
                    <span>Emprendimiento: @emprendimiento</span>
                </li>

                <li>
                    <i class="bi bi-cash"></i>
                    <span>Precio: ₡@Model.Precio.ToString("N0")</span>
                </li>

            </ul>

            
            
            @if (Model.StockActual > 0)
            {
                <form asp-controller="Usuario"
                      asp-action="AgregarAlCarrito"
                      method="post"
                      style="margin-bottom: 15px;">

                    @Html.AntiForgeryToken()

                    <input type="hidden"
                           name="idProducto"
                           value="@Model.IdProducto" />

                    <button type="submit"
                            class="boton-contacto-emprendimiento boton-agregar-carrito">
                        <i class="bi bi-cart-plus"></i>
                        Agregar al carrito
                    </button>
                </form>
            }
            else
            {
                <button type="button"
                        class="boton-contacto-emprendimiento boton-agregar-carrito"
                        disabled>
                    <i class="bi bi-x-circle"></i>
                    Producto agotado
                </button>
            }



            <a asp-controller="Home"
               asp-action="CatalogoProductos"
               class="boton-contacto-emprendimiento">
                Seguir explorando productos
            </a>

        </aside>

    </div>
</section>

<section class="cta-detalle-emprendimiento">
    <div class="container">

        <div class="contenido-cta-detalle-emprendimiento">

            <span>Club Creativo MiVo</span>

            <h2>¿Querés conocer más productos?</h2>

            <p>
                Explorá el catálogo completo y apoyá
                el talento creativo costarricense.
            </p>

            <a asp-controller="Home"
               asp-action="CatalogoProductos"
               class="boton-cta-detalle-emprendimiento">
                Ver catálogo
            </a>

        </div>
    </div>
</section>
