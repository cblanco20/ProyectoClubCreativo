@model ProyectoClubCreativo.Models.ViewModels.InicioViewModel

@{
    ViewData["Title"] = "Inicio";
    Layout = "~/Views/Shared/_LayoutExterno.cshtml";

    bool haySesion = Context.Session.GetInt32("IdUsuario") is not null;

    string ImagenDe(string? url) =>
        string.IsNullOrWhiteSpace(url)
            ? Url.Content("~/images/logo.jpg")
            : Url.Content(url);

    string Resumen(string? texto, int maximo)
    {
        texto ??= string.Empty;
        return texto.Length <= maximo ? texto : texto[..(maximo - 3)] + "...";
    }
}
<!-- BANNER PRINCIPAL-->
<section class="seccion-hero">
    <div class="contenedor-club">

        <div class="hero-principal">

            <div class="contenido-hero">
                <span class="etiqueta-hero">
                    Talento local hecho en Costa Rica
                </span>

                <h1 class="titulo-hero">
                    Apoyá lo nuestro,
                    <span>viví lo creativo</span>
                </h1>

                <p class="descripcion-hero">
                    Descubrí emprendimientos, productos únicos,
                    eventos, talleres y experiencias creadas
                    por personas apasionadas por el arte,
                    el diseño y la creatividad.
                </p>

                <div class="botones-hero">
                    <a href="#productos"
                       class="boton-principal">
                        Explorar productos
                    </a>

                    <a href="#eventos"
                       class="boton-secundario">
                        Ver eventos
                    </a>
                </div>
            </div>

            <div class="imagen-hero-contenedor">
                <img src="~/images/hero-feria.jpg"
                     alt="Feria de emprendimientos de Club Creativo"
                     class="imagen-hero" />

                <div class="mensaje-flotante-hero">
                    Hecho en Costa Rica ❤
                </div>
            </div>

        </div>

        <div class="barra-beneficios">

            <article class="beneficio">
                <span class="icono-beneficio">🏪</span>

                <div>
                    <h3>Apoyá emprendimientos</h3>
                    <p>
                        Conocé marcas y proyectos costarricenses.
                    </p>
                </div>
            </article>

            <article class="beneficio">
                <span class="icono-beneficio">📅</span>

                <div>
                    <h3>Viví experiencias</h3>
                    <p>
                        Participá en ferias, eventos y talleres.
                    </p>
                </div>
            </article>

            <article class="beneficio">
                <span class="icono-beneficio">🛍️</span>

                <div>
                    <h3>Comprá productos</h3>
                    <p>
                        Encontrá artículos hechos con dedicación.
                    </p>
                </div>
            </article>

            <article class="beneficio">
                <span class="icono-beneficio">⭐</span>

                <div>
                    <h3>Sumá beneficios</h3>
                    <p>
                        Acumulá puntos y disfrutá recompensas.
                    </p>
                </div>
            </article>

        </div>
    </div>
</section>
@if (!haySesion)
{
    <section class="seccion-contenido">
        <div class="burbuja-seccion burbuja-azul-suave">
            <div class="contenedor-club">
                <div class="encabezado-seccion">
                    <div>
                        <h2 class="titulo-seccion">
                            Esto es lo que Club Creativo tiene para vos ✦
                        </h2>
                        <p class="descripcion-seccion">
                            Iniciá sesión para inscribirte en eventos y talleres,
                            guardar tus favoritos, acumular puntos y
                            aprovechar promociones.
                        </p>
                    </div>

                    <div>
                        <a asp-controller="Cuenta"
                           asp-action="IniciarSesion"
                           class="boton-principal">
                            Iniciar sesión
                        </a>
                        <a asp-controller="Cuenta"
                           asp-action="SeleccionarRegistro"
                           class="enlace-ver-todos">
                            Crear cuenta →
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </section>
}
<!-- PRÓXIMOS EVENTOS-->
<section id="eventos"
         class="seccion-contenido">
    <div class="burbuja-seccion burbuja-rosada">
        <div class="contenedor-club">

        <div class="encabezado-seccion">
            <div>
                <h2 class="titulo-seccion">
                    Próximos eventos ✦
                </h2>

                <p class="descripcion-seccion">
                    Conocé las próximas ediciones de Club Creativo
                    y descubrí espacios llenos de arte,
                    diseño y emprendimiento.
                </p>
            </div>

            <a asp-controller="Home"
               asp-action="Eventos"
               class="enlace-ver-todos">
                Ver todos los eventos →
            </a>
        </div>

            @if (Model.Eventos.Count == 0)
            {
                <p>Por ahora no hay eventos próximos. ¡Vuelve pronto!</p>
            }
            else
            {
                <div class="cuadricula-tarjetas">
                    @foreach (var evento in Model.Eventos)
                    {
                        <article class="tarjeta-contenido">
                            <img src="@ImagenDe(evento.ImagenUrl)"
                                 alt="@evento.Nombre"
                                 class="imagen-tarjeta" />

                            <div class="cuerpo-tarjeta">
                                <span class="etiqueta-tarjeta">@evento.FechaTexto</span>

                                <h3 class="titulo-tarjeta">@evento.Nombre</h3>

                                <p class="texto-tarjeta">@Resumen(evento.Descripcion, 110)</p>

                                <div class="datos-tarjeta">
                                    <span>📍 @evento.Ubicacion</span>
                                    <span>🕐 @evento.HoraTexto</span>
                                </div>

                                <a asp-controller="Home"
                                   asp-action="DetalleEvento"
                                   asp-route-id="@evento.IdEvento"
                                   class="enlace-tarjeta">
                                    Ver evento →
                                </a>
                            </div>
                        </article>
                    }
                </div>
            }
    </div>
    </div>
</section>

<!-- TALLERES-->
<section id="talleres"
         class="seccion-contenido">
    <div class="burbuja-seccion burbuja-blanca">
        <div class="contenedor-club">

        <div class="encabezado-seccion">
            <div>
                <h2 class="titulo-seccion">
                    Talleres destacados 〰
                </h2>

                <p class="descripcion-seccion">
                    Aprendé nuevas técnicas, conectá con personas
                    creativas y viví experiencias diferentes.
                </p>
            </div>

            <a asp-controller="Home"
               asp-action="Talleres"
               class="enlace-ver-todos">
                Ver todos los talleres →
            </a>
        </div>

            @if (Model.Talleres.Count == 0)
            {
                <p>Por ahora no hay talleres programados. ¡Vuelve pronto!</p>
            }
            else
            {
                <div class="cuadricula-talleres">
                    @foreach (var taller in Model.Talleres)
                    {
                        <article class="tarjeta-contenido tarjeta-taller">
                            <img src="@ImagenDe(taller.ImagenUrl)"
                                 alt="@taller.Nombre"
                                 class="imagen-tarjeta" />

                            <div class="cuerpo-tarjeta">
                                <span class="etiqueta-tarjeta">@taller.TextoDisponibilidad</span>

                                <h3 class="titulo-tarjeta">@taller.Nombre</h3>

                                <div class="datos-tarjeta">
                                    <span>📅 @taller.FechaTexto</span>
                                    <span>📍 @taller.Ubicacion</span>
                                </div>

                                <a asp-controller="Home"
                                   asp-action="DetalleTaller"
                                   asp-route-id="@taller.IdTaller"
                                   class="enlace-tarjeta">
                                    Ver taller →
                                </a>
                            </div>
                        </article>
                    }
                </div>
            }
    </div>
    </div>
</section>

<!-- EMPRENDIMIENTOS Y PRODUCTOS-->
<section id="productos"
         class="seccion-contenido seccion-fondo-morado">

    <div class="burbuja-seccion burbuja-morada">
    <div id="emprendimientos"
         class="contenedor-club">

        <div class="encabezado-seccion">
            <div>
                <h2 class="titulo-seccion">
                    Emprendimientos y productos destacados
                </h2>

                <p class="descripcion-seccion">
                    Descubrí marcas creadas con pasión
                    y productos hechos por talento costarricense.
                </p>
            </div>

            <a asp-controller="Home"
               asp-action="Emprendimientos"
               class="enlace-ver-todos">
                Ver todos →
            </a>
        </div>

            @if (Model.Emprendimientos.Count == 0)
            {
                <p>Pronto verás aquí los emprendimientos de nuestra comunidad.</p>
            }
            else
            {
                <div class="cuadricula-productos">
                    @foreach (var emprendimiento in Model.Emprendimientos)
                    {
                        <article class="tarjeta-contenido tarjeta-producto">
                            <a asp-controller="Home"
                               asp-action="DetalleEmprendimiento"
                               asp-route-id="@emprendimiento.IdEmprendimiento"
                               class="enlace-tarjeta-producto">

                                <img src="@ImagenDe(emprendimiento.ImagenUrl)"
                                     alt="@emprendimiento.NombreComercial"
                                     class="imagen-tarjeta" />

                                <div class="cuerpo-tarjeta">
                                    <h3 class="titulo-tarjeta">@emprendimiento.NombreComercial</h3>
                                    <p class="texto-tarjeta">
                                        @(emprendimiento.Categoria ?? Resumen(emprendimiento.Descripcion, 60))
                                    </p>
                                </div>

                            </a>
                        </article>
                    }
                </div>
            }
    </div>
    </div>
</section>

<!-- PROMOCIONES -->
<section id="promociones"
         class="seccion-contenido">

    <div class="burbuja-seccion burbuja-amarilla">
    <div class="contenedor-club">

        <div class="encabezado-seccion">
            <div>
                <h2 class="titulo-seccion">
                    Promociones y campañas ✧
                </h2>
            </div>
        </div>

            @if (Model.Promocion is null)
            {
                <p>Por ahora no hay promociones activas. ¡Vuelve pronto!</p>
            }
            else
            {
                <div class="banner-promocion">

                    <div class="contenido-promocion">
                        <span class="descuento-promocion">
                            @Model.Promocion.Descuento OFF
                        </span>

                        <h2>@Model.Promocion.Nombre</h2>

                        <p>
                            @Resumen(Model.Promocion.Descripcion, 160)
                            Aplica a: @Model.Promocion.AplicaA.
                            Vigente hasta el @Model.Promocion.FechaFin.ToString("dd/MM/yyyy").
                        </p>

                        <div>
                            <a asp-controller="Home"
                               asp-action="Promociones"
                               class="boton-principal">
                                Ver promociones
                            </a>

                            @if (!haySesion)
                            {
                                <p>
                                    <small>Iniciá sesión para aprovechar esta promoción.</small>
                                </p>
                            }
                        </div>
                    </div>

                    <img src="~/images/promociones-banner.jpg"
                         alt="Promoción vigente"
                         class="imagen-promocion" />

                </div>
            }
    </div>
    </div>
</section>

<!-- COMUNIDAD-->
<section id="comunidad"
         class="seccion-contenido">

    <div class="burbuja-seccion burbuja-azul-suave">
    <div class="contenedor-club">

        <div class="encabezado-seccion">
            <div>
                <h2 class="titulo-seccion">
                    Comunidad creativa ♥
                </h2>

                <p class="descripcion-seccion">
                    Así vivimos nuestras ferias, talleres
                    y actividades junto a la comunidad.
                </p>
            </div>

            <a href="#"
               class="enlace-ver-todos">
                Síguenos en Instagram →
            </a>
        </div>

        <div class="cuadricula-comunidad">
            <img src="~/images/evento-san-pedro.jpg"
                 alt="Actividad de Club Creativo"
                 class="imagen-comunidad" />

            <img src="~/images/producto-1.jpg"
                 alt="Producto de emprendimiento"
                 class="imagen-comunidad" />

            <img src="~/images/taller-ceramica.jpg"
                 alt="Taller creativo"
                 class="imagen-comunidad" />

            <img src="~/images/evento-santa-ana.jpg"
                 alt="Feria creativa"
                 class="imagen-comunidad" />

            <img src="~/images/producto-3.jpg"
                 alt="Producto artesanal"
                 class="imagen-comunidad" />

            <img src="~/images/taller-bordado.jpg"
                 alt="Comunidad creativa"
                 class="imagen-comunidad" />
        </div>

    </div>
    </div>
</section>