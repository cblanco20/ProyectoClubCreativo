@model List<ProyectoClubCreativo.Models.Entities.Producto>

@{
    ViewData["Title"] = "Catálogo de Productos";
    Layout = "_LayoutExterno";
}

<section class="hero-emprendimientos">
    <div class="container hero-emprendimientos-grid">
        <div class="hero-emprendimientos-texto">
            <span class="etiqueta-emprendimientos">Tienda creativa</span>
            <h1>Productos hechos a mano por nuestra comunidad</h1>
            <p>
                Explorá piezas únicas de joyería, velas, arte y textiles
                creadas por emprendimientos de Club Creativo MiVo.
            </p>
            <a href="#productos-listado" class="boton-emprendimientos">
                Ver productos
            </a>
        </div>

        <div class="hero-emprendimientos-imagen">
            <img src="~/images/catalogo-productos-hero.jpg"
                 alt="Productos artesanales de Club Creativo" />

            <div class="insignia-flotante-emprendimientos">
                <i class="bi bi-bag-heart-fill"></i>
                <div>
                    <strong>@Model.Count productos</strong>
                    <span>disponibles en el catálogo</span>
                </div>
            </div>
        </div>
    </div>
</section>

<section class="categorias-emprendimientos">
    <div class="container">
        <div class="lista-categorias-emprendimientos">
            <span class="categoria-chip categoria-chip-activa">
                Todos
            </span>

            @foreach (var categoria in Model
                .Where(p => p.IdCategoriaNavigation != null)
                .Select(p => p.IdCategoriaNavigation!.Nombre)
                .Distinct()
                .OrderBy(nombre => nombre))
            {
                <span class="categoria-chip">@categoria</span>
            }
        </div>
    </div>
</section>

<section class="emprendimientos-listado" id="productos-listado">
    <div class="container">

        @if (Model.Count == 0)
        {
            <div class="text-center py-5">
                <h3>No hay productos disponibles por el momento.</h3>
                <p>
                    Próximamente encontrarás nuevos productos
                    de nuestros emprendedores.
                </p>
            </div>
        }
        else
        {
            <div class="grid-emprendimientos">

                @foreach (var producto in Model)
                {
                    string imagen = producto.ProductoImagene?.UrlImagen
                        ?? "/images/logo.jpg";

                    string categoria = producto.IdCategoriaNavigation?.Nombre
                        ?? "Sin categoría";

                    string emprendimiento =
                        producto.IdEmprendimientoNavigation?.NombreComercial
                        ?? "Emprendimiento";

                    <article class="tarjeta-emprendimiento">

                        <div class="imagen-tarjeta-emprendimiento">
                            <img src="@imagen"
                                 alt="@producto.Nombre" />

                            <span class="categoria-tarjeta-emprendimiento">
                                @categoria
                            </span>
                        </div>

                        <div class="cuerpo-tarjeta-emprendimiento">

                            <h3>@producto.Nombre</h3>

                            <p>@producto.Descripcion</p>

                            <div class="datos-tarjeta-emprendimiento">

                                <span class="precio-tarjeta-producto">
                                    ₡@producto.Precio.ToString("N0")
                                </span>

                                <span>
                                    <i class="bi bi-shop"></i>
                                    @emprendimiento
                                </span>

                            </div>

                            <a asp-controller="Home"
                               asp-action="DetalleProducto"
                               asp-route-id="@producto.IdProducto"
                               class="enlace-tarjeta-emprendimiento">

                                Ver producto
                                <i class="bi bi-arrow-right"></i>

                            </a>

                        </div>
                    </article>
                }

            </div>
        }

    </div>
</section>

<section class="cta-emprendimientos">
    <div class="container">
        <div class="cta-emprendimientos-contenido">
            <span>Club Creativo MiVo</span>

            <h2>¿Querés vender tus productos aquí?</h2>

            <p>
                Registrá tu emprendimiento y sumá tus productos
                al catálogo de Club Creativo MiVo.
            </p>

            <a asp-controller="Cuenta"
               asp-action="RegistroEmprendedor"
               class="boton-emprendimientos boton-emprendimientos-claro">
                Registrar mi emprendimiento
            </a>
        </div>
    </div>
</section>
