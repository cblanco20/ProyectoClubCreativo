@{
    ViewData["Title"] = "Reglamento";
    Layout = "_LayoutExterno";
}

<!-- HERO -->
<section class="hero-reglamento">
    <div class="container hero-reglamento-grid">

        <div class="hero-reglamento-texto">
            <span class="etiqueta-reglamento">
                Normas de convivencia
            </span>

            <h1>Reglamento de Club Creativo MiVo</h1>

            <p>
                Nuestro objetivo es ofrecer un ambiente seguro, creativo y
                respetuoso, donde todas las personas puedan aprender,
                compartir y disfrutar de nuestras actividades.
            </p>

            <a href="#normas" class="boton-reglamento">
                Conocer las normas
            </a>
        </div>

        <div class="hero-reglamento-imagen">
            <img src="~/images/reglamento-banner.jpg"
                 alt="Personas revisando las normas de una actividad creativa" />
        </div>

    </div>
</section>


<!-- INTRODUCCIÓN -->
<section class="introduccion-reglamento">
    <div class="container">

        <div class="encabezado-reglamento">
            <span class="subtitulo-reglamento">Nuestro compromiso</span>

            <h2>Una comunidad basada en el respeto</h2>

            <p>
                Este reglamento busca garantizar una experiencia positiva
                para participantes, facilitadores, emprendimientos y visitantes.
                Al participar en las actividades de Club Creativo MiVo,
                cada persona acepta cumplir estas normas.
            </p>
        </div>

    </div>
</section>


<!-- NORMAS -->
<section class="normas-reglamento" id="normas">
    <div class="container">

        <div class="titulo-reglamento-centro">
            <span class="subtitulo-reglamento">Reglas principales</span>
            <h2>Normas de participación</h2>

            <p>
                Estas normas nos ayudan a mantener un espacio organizado,
                agradable y seguro para todos.
            </p>
        </div>

        <div class="grid-normas">

            <article class="tarjeta-norma">
                <div class="icono-norma">
                    <i class="bi bi-people-fill"></i>
                </div>

                <span class="numero-norma">01</span>

                <h3>Respeto</h3>

                <p>
                    Todas las personas deben tratar con respeto a los
                    participantes, facilitadores, organizadores y visitantes.
                </p>
            </article>


            <article class="tarjeta-norma">
                <div class="icono-norma">
                    <i class="bi bi-clock-fill"></i>
                </div>

                <span class="numero-norma">02</span>

                <h3>Puntualidad</h3>

                <p>
                    Se recomienda llegar a tiempo para evitar interrupciones
                    y aprovechar completamente cada actividad.
                </p>
            </article>


            <article class="tarjeta-norma">
                <div class="icono-norma">
                    <i class="bi bi-palette-fill"></i>
                </div>

                <span class="numero-norma">03</span>

                <h3>Cuidado de materiales</h3>

                <p>
                    Los materiales, herramientas, muebles y espacios deben
                    utilizarse de manera responsable.
                </p>
            </article>


            <article class="tarjeta-norma">
                <div class="icono-norma">
                    <i class="bi bi-emoji-smile-fill"></i>
                </div>

                <span class="numero-norma">04</span>

                <h3>Buena convivencia</h3>

                <p>
                    Se debe mantener una actitud amable, colaborativa y
                    positiva durante las actividades.
                </p>
            </article>


            <article class="tarjeta-norma">
                <div class="icono-norma">
                    <i class="bi bi-shield-check"></i>
                </div>

                <span class="numero-norma">05</span>

                <h3>Conducta adecuada</h3>

                <p>
                    No se permiten conductas agresivas, discriminatorias,
                    ofensivas o que afecten el bienestar de otras personas.
                </p>
            </article>


            <article class="tarjeta-norma">
                <div class="icono-norma">
                    <i class="bi bi-phone-fill"></i>
                </div>

                <span class="numero-norma">06</span>

                <h3>Uso responsable</h3>

                <p>
                    Los dispositivos electrónicos deben utilizarse sin
                    interrumpir el desarrollo de los talleres o eventos.
                </p>
            </article>

        </div>
    </div>
</section>


<!-- CONVIVENCIA -->
<section class="convivencia-reglamento">
    <div class="container convivencia-reglamento-grid">

        <div class="convivencia-reglamento-imagen">
            <img src="~/images/convivencia.jpg"
                 alt="Personas compartiendo en un taller creativo" />
        </div>

        <div class="convivencia-reglamento-texto">
            <span class="subtitulo-reglamento">Convivencia positiva</span>

            <h2>La creatividad se disfruta mejor en comunidad</h2>

            <p>
                En Club Creativo MiVo creemos que un ambiente respetuoso
                permite que todas las personas desarrollen sus habilidades,
                expresen sus ideas y disfruten plenamente de cada actividad.
            </p>

            <p>
                Por esta razón, promovemos la comunicación, el trabajo en
                equipo, la inclusión y el respeto por las diferencias.
            </p>

            <ul class="lista-convivencia">
                <li>
                    <i class="bi bi-check-circle-fill"></i>
                    Escuchar y respetar las ideas de los demás.
                </li>

                <li>
                    <i class="bi bi-check-circle-fill"></i>
                    Participar de manera positiva y colaborativa.
                </li>

                <li>
                    <i class="bi bi-check-circle-fill"></i>
                    Mantener limpio y ordenado el espacio utilizado.
                </li>

                <li>
                    <i class="bi bi-check-circle-fill"></i>
                    Informar cualquier situación que afecte la convivencia.
                </li>
            </ul>
        </div>

    </div>
</section>


<!-- RESPONSABILIDADES -->
<section class="responsabilidades-reglamento">
    <div class="container">

        <div class="titulo-reglamento-centro">
            <span class="subtitulo-reglamento">Responsabilidad compartida</span>
            <h2>Compromisos de participación</h2>
        </div>

        <div class="grid-responsabilidades">

            <article class="responsabilidad-item">
                <div class="responsabilidad-icono">
                    <i class="bi bi-person-check-fill"></i>
                </div>

                <div>
                    <h3>Participantes</h3>

                    <p>
                        Deben respetar las normas, seguir las instrucciones
                        de los facilitadores y cuidar los recursos disponibles.
                    </p>
                </div>
            </article>


            <article class="responsabilidad-item">
                <div class="responsabilidad-icono">
                    <i class="bi bi-person-workspace"></i>
                </div>

                <div>
                    <h3>Facilitadores</h3>

                    <p>
                        Deben orientar las actividades, responder consultas
                        y promover un ambiente seguro e inclusivo.
                    </p>
                </div>
            </article>


            <article class="responsabilidad-item">
                <div class="responsabilidad-icono">
                    <i class="bi bi-building-check"></i>
                </div>

                <div>
                    <h3>Organización</h3>

                    <p>
                        Debe mantener los espacios adecuados, comunicar las
                        normas y atender situaciones que requieran intervención.
                    </p>
                </div>
            </article>

        </div>
    </div>
</section>


<!-- AVISO IMPORTANTE -->
<section class="aviso-reglamento">
    <div class="container">

        <div class="caja-aviso-reglamento">

            <div class="icono-aviso-reglamento">
                <i class="bi bi-exclamation-triangle-fill"></i>
            </div>

            <div class="texto-aviso-reglamento">
                <h2>Importante</h2>

                <p>
                    El incumplimiento de este reglamento puede provocar una
                    llamada de atención, la suspensión de una actividad o la
                    restricción para participar en futuras actividades,
                    dependiendo de la gravedad de la situación.
                </p>
            </div>

        </div>

    </div>
</section>


<!-- CTA FINAL -->
<section class="cta-reglamento">
    <div class="container">

        <div class="cta-reglamento-contenido">
            <span>Club Creativo MiVo</span>

            <h2>¿Listo para formar parte de nuestra comunidad?</h2>

            <p>
                Descubre nuestros talleres, eventos y actividades creativas
                disponibles para ti.
            </p>

            <a asp-controller="Home"
               asp-action="Talleres"
               class="boton-reglamento boton-reglamento-claro">
                Ver talleres
            </a>
        </div>

    </div>
</section>