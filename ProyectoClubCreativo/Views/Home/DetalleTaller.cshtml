@model ProyectoClubCreativo.Models.ViewModels.TallerPublicoViewModel
@using ProyectoClubCreativo.Models.ViewModels
@{
    ViewData["Title"] = Model.Nombre;
    Layout = "_LayoutExterno";

    string imagen = string.IsNullOrWhiteSpace(Model.ImagenUrl)
        ? Url.Content("~/images/taller-ceramica.jpg")
        : Url.Content(Model.ImagenUrl);

    List<TallerPublicoViewModel> otros = ViewBag.OtrosTalleres as List<TallerPublicoViewModel> ?? new();
    string? error = TempData["ErrorTaller"] as string;
}

<section class="encabezado-detalle-emprendimiento">
    <div class="container">
        <nav class="migas-detalle-emprendimiento" aria-label="Navegación secundaria">
            <a asp-controller="Home" asp-action="Index">Inicio</a>
            <i class="bi bi-chevron-right"></i>
            <a asp-controller="Home" asp-action="Talleres">Talleres</a>
            <i class="bi bi-chevron-right"></i>
            <span>@Model.Nombre</span>
        </nav>

        <div class="perfil-detalle-emprendimiento">
            <img src="@imagen" alt="Foto del taller" class="logo-detalle-emprendimiento" />

            <div class="informacion-perfil-emprendimiento">
                @if (!string.IsNullOrWhiteSpace(Model.Categoria))
                {
                    <span class="categoria-detalle-emprendimiento">@Model.Categoria</span>
                }
                <h1>@Model.Nombre</h1>
                <div class="datos-perfil-emprendimiento">
                    <span><i class="bi bi-calendar3"></i> @Model.FechaTexto, @Model.HoraTexto</span>
                    <span><i class="bi bi-geo-alt-fill"></i> @Model.Ubicacion</span>
                    <span><i class="bi bi-people-fill"></i> @Model.TextoDisponibilidad</span>
                </div>
            </div>
        </div>
    </div>
</section>

<section class="contenido-detalle-emprendimiento">
    <div class="container distribucion-detalle-emprendimiento">
        <article class="informacion-detalle-emprendimiento">
            <h2>Descripción del taller</h2>
            <p>@Model.Descripcion</p>
        </article>

        <aside class="tarjeta-contacto-emprendimiento">
            <h2>Detalles del taller</h2>
            <ul class="lista-contacto-emprendimiento">
                <li><i class="bi bi-calendar3"></i><span>@Model.FechaTexto</span></li>
                <li><i class="bi bi-clock-fill"></i><span>@Model.HorarioTexto</span></li>
                @if (!string.IsNullOrWhiteSpace(Model.ResponsableNombre))
                {
                    <li><i class="bi bi-person-fill"></i><span>Responsable: @Model.ResponsableNombre</span></li>
                }
                <li><i class="bi bi-geo-alt-fill"></i><span>@Model.Ubicacion</span></li>
                <li><i class="bi bi-people-fill"></i><span>@Model.CuposDisponibles de @Model.CupoMaximo cupos disponibles</span></li>
            </ul>

            @if (!string.IsNullOrEmpty(error))
            {
                <p style="color:#b91c1c; font-weight:600;">@error</p>
            }

            @if (Model.PocosCupos && !Model.UsuarioRegistrado)
            {
                <p style="color:#b45309; font-weight:600;"><i class="bi bi-exclamation-triangle-fill"></i> Últimos cupos disponibles</p>
            }

            @if (Model.UsuarioRegistrado)
            {
                <p style="font-weight:600;"><i class="bi bi-check-circle-fill"></i> Ya estás registrado en este taller.</p>
                <a asp-controller="Usuario" asp-action="MisTalleres" class="boton-contacto-emprendimiento">Ver mis talleres</a>
            }
            else if (Model.CupoLleno)
            {
                <p style="color:#b91c1c; font-weight:600;">Cupo completo</p>
                <button type="button" class="boton-contacto-emprendimiento" disabled style="opacity:.5; cursor:not-allowed;">
                    Registrarse en taller
                </button>
            }
            else
            {
                <form asp-controller="Usuario" asp-action="RegistrarseTaller" method="post">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="id" value="@Model.IdTaller" />
                    <button type="submit" class="boton-contacto-emprendimiento" style="border:0; width:100%; cursor:pointer;">
                        Registrarse en taller
                    </button>
                </form>
            }
        </aside>
    </div>
</section>

@if (otros.Any())
{
    <section class="relacionados-detalle-emprendimiento">
        <div class="container">
            <div class="encabezado-relacionados-emprendimiento">
                <div>
                    <span class="subtitulo-talleres">Nuestra oferta</span>
                    <h2>Otros talleres que te pueden interesar</h2>
                </div>
                <a asp-controller="Home" asp-action="Talleres">
                    Ver todos los talleres <i class="bi bi-arrow-right"></i>
                </a>
            </div>

            <div class="grid-relacionados-emprendimiento">
                @foreach (var otro in otros)
                {
                    <article class="tarjeta-relacionada-emprendimiento">
                        <img src="@(string.IsNullOrWhiteSpace(otro.ImagenUrl) ? Url.Content("~/images/taller-bordado.jpg") : Url.Content(otro.ImagenUrl))" alt="@otro.Nombre" />
                        <div>
                            <span>@otro.FechaTexto</span>
                            <h3>@otro.Nombre</h3>
                            <a asp-controller="Home" asp-action="DetalleTaller" asp-route-id="@otro.IdTaller">
                                Ver taller <i class="bi bi-arrow-right"></i>
                            </a>
                        </div>
                    </article>
                }
            </div>
        </div>
    </section>
}

<section class="cta-detalle-emprendimiento">
    <div class="container">
        <div class="contenido-cta-detalle-emprendimiento">
            <span>Club Creativo MiVo</span>
            <h2>¿Querés seguir aprendiendo?</h2>
            <p>Revisá la oferta completa de talleres y encontrá el que va con vos.</p>
            <a asp-controller="Home" asp-action="Talleres" class="boton-cta-detalle-emprendimiento">
                Ver talleres
            </a>
        </div>
    </div>
</section>
