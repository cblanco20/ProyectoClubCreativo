@{
    ViewData["Title"] = "Sobre Nosotros";
    Layout = "_LayoutExterno";
}

<!-- =========================================
                HERO
========================================= -->

<section class="hero-sobre">

    <div class="contenedor-club hero-grid">

        <div class="hero-texto">

            <span class="hero-etiqueta">
                Bienvenido a Club Creativo MiVo
            </span>

            <h1>
                Inspiramos la creatividad y apoyamos el talento local
            </h1>

            <p>
                Somos una comunidad que conecta artistas, emprendedores y
                personas creativas mediante ferias, talleres y actividades
                que impulsan el crecimiento personal y profesional.
            </p>

            <a asp-controller="Cuenta"
               asp-action="SeleccionarRegistro"
               class="boton-hero">
                Únete a nuestra comunidad
            </a>

        </div>

        <div class="hero-imagen">

            <img src="~/images/evento-san-pedro.jpg"
                 alt="Evento Club Creativo">

        </div>

    </div>

</section>

<!-- =========================================
            NUESTRA HISTORIA
========================================= -->

<section class="historia">

    <div class="contenedor-club historia-grid">

        <div class="historia-imagen">

            <img src="~/images/evento-santa-ana.jpg"
                 alt="Nuestra Historia">

        </div>

        <div class="historia-texto">

            <span class="titulo-seccion">
                Nuestra Historia
            </span>

            <h2>
                Un espacio donde las ideas cobran vida
            </h2>

            <p>
                Club Creativo MiVo nació con el propósito de brindar un espacio
                para que emprendedores, artistas y personas creativas pudieran
                mostrar su talento y compartir sus proyectos con la comunidad.
            </p>

            <p>
                A través de ferias, talleres y actividades culturales buscamos
                fortalecer el emprendimiento local, fomentar la colaboración y
                crear oportunidades para quienes desean crecer haciendo lo que
                más les apasiona.
            </p>

        </div>

    </div>

</section>

<!-- =========================================
           MISIÓN Y VISIÓN
========================================= -->

<section class="mision-vision">

    <div class="contenedor-club">

        <div class="titulo-centro">

            <span class="titulo-seccion">
                Conoce más
            </span>

            <h2>
                Nuestra misión y visión
            </h2>

        </div>

        <div class="cards-mision">

            <article class="card-info">

                <div class="icono-card">
                    🎯
                </div>

                <h3>Misión</h3>

                <p>
                    Promover el talento local mediante espacios donde las
                    personas puedan emprender, aprender, compartir experiencias
                    y fortalecer sus habilidades creativas.
                </p>

            </article>

            <article class="card-info">

                <div class="icono-card">
                    🚀
                </div>

                <h3>Visión</h3>

                <p>
                    Ser una comunidad reconocida por impulsar el desarrollo
                    creativo, apoyando a emprendedores y artistas mediante
                    actividades innovadoras y colaborativas.
                </p>

            </article>

        </div>

    </div>

</section>

<!-- =========================================
               VALORES
========================================= -->

<section class="valores">

    <div class="contenedor-club">

        <div class="titulo-centro">

            <span class="titulo-seccion">
                Nuestros valores
            </span>

            <h2>
                Lo que nos representa
            </h2>

        </div>

        <div class="grid-valores">

            <div class="valor">

                <div class="icono-valor">
                    🎨
                </div>

                <h3>Creatividad</h3>

                <p>
                    Creemos que toda idea puede transformarse en una oportunidad.
                </p>

            </div>

            <div class="valor">

                <div class="icono-valor">
                    🤝
                </div>

                <h3>Colaboración</h3>

                <p>
                    Trabajamos en comunidad para crecer juntos.
                </p>

            </div>

            <div class="valor">

                <div class="icono-valor">
                    💡
                </div>

                <h3>Innovación</h3>

                <p>
                    Buscamos nuevas formas de aprender y emprender.
                </p>

            </div>

            <div class="valor">

                <div class="icono-valor">
                    🌱
                </div>

                <h3>Inclusión</h3>

                <p>
                    Todas las personas tienen un lugar dentro de Club Creativo.
                </p>

            </div>

        </div>

    </div>

</section>

<!-- =========================================
            ¿QUÉ OFRECEMOS?
========================================= -->

<section class="ofrecemos">

    <div class="contenedor-club">

        <div class="titulo-centro">

            <span class="titulo-seccion">
                ¿Qué encontrarás?
            </span>

            <h2>
                Mucho más que una comunidad
            </h2>

        </div>

        <div class="cards-servicios">

            <article class="servicio">

                <img src="~/images/taller-velas.jpg"
                     alt="Talleres">

                <h3>Talleres</h3>

                <p>
                    Espacios para desarrollar nuevas habilidades.
                </p>

            </article>

            <article class="servicio">

                <img src="~/images/evento-san-pedro.jpg"
                     alt="Eventos">

                <h3>Eventos</h3>

                <p>
                    Actividades para compartir con toda la comunidad.
                </p>

            </article>

            <article class="servicio">

                <img src="~/images/evento-santa-ana.jpg"
                     alt="Ferias">

                <h3>Ferias</h3>

                <p>
                    Oportunidades para exhibir productos y servicios.
                </p>

            </article>

            <article class="servicio">

                <img src="~/images/logo.jpg"
                     alt="Comunidad">

                <h3>Comunidad</h3>

                <p>
                    Personas que apoyan el talento y el emprendimiento.
                </p>

            </article>

        </div>

    </div>

</section>

<!-- =========================================
              LLAMADO FINAL
========================================= -->

<section class="cta-sobre">

    <div class="contenedor-club">

        <h2>
            ¿Quieres formar parte de Club Creativo?
        </h2>

        <p>
            Regístrate y descubre talleres, eventos, emprendimientos y muchas
            oportunidades para crecer junto a nuestra comunidad.
        </p>

        <a asp-controller="Cuenta"
           asp-action="SeleccionarRegistro"
           class="boton-hero">
            Crear una cuenta
        </a>

    </div>

</section>