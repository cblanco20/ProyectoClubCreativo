@model ProyectoClubCreativo.Models.ViewModels.EventoPublicoViewModel
@using ProyectoClubCreativo.Models.Entities
@using ProyectoClubCreativo.Models.ViewModels

@{
    ViewData["Title"] = Model.Nombre;
    Layout = "_LayoutExterno";

    List<Emprendimiento> emprendimientos =
        ViewBag.Emprendimientos as List<Emprendimiento> ?? new();

    List<EventoPublicoViewModel> otrosEventos =
        ViewBag.OtrosEventos as List<EventoPublicoViewModel> ?? new();

    string imagenPorDefecto = Url.Content("~/images/hero-feria.jpg");

    string ImagenDe(string? url) =>
        string.IsNullOrWhiteSpace(url) ? imagenPorDefecto : Url.Content(url);
}

<section class="encabezado-detalle-emprendimiento">
    <div class="container">
        <nav class="migas-detalle-emprendimiento" aria-label="Navegación secundaria">
            <a asp-controller="Home" asp-action="Index">Inicio</a>
            <i class="bi bi-chevron-right"></i>
            <a asp-controller="Home" asp-action="Eventos">Eventos</a>
            <i class="bi bi-chevron-right"></i>
            <span>@Model.Nombre</span>
        </nav>

        <div class="perfil-detalle-emprendimiento">
            <img src="@ImagenDe(Model.ImagenUrl)" alt="Portada del evento" class="logo-detalle-emprendimiento" />

            <div class="informacion-perfil-emprendimiento">
                @if (!string.IsNullOrWhiteSpace(Model.Categoria))
                {
                    <span class="categoria-detalle-emprendimiento">@Model.Categoria</span>
                }
                <h1>@Model.Nombre</h1>
                <div class="datos-perfil-emprendimiento">
                    <span><i class="bi bi-calendar3"></i> @Model.FechaTexto</span>
                    <span><i class="bi bi-clock-fill"></i> @Model.HoraTexto</span>
                    <span><i class="bi bi-geo-alt-fill"></i> @Model.Ubicacion</span>
                </div>
            </div>
        </div>
    </div>
</section>

<section class="contenido-detalle-emprendimiento">
    <div class="container distribucion-detalle-emprendimiento">
        <article class="informacion-detalle-emprendimiento">
            <h2>Sobre el evento</h2>
            <p>@Model.Descripcion</p>

            <h2>Emprendimientos participantes</h2>

            @if (!emprendimientos.Any())
            {
                <p>Los emprendimientos participantes se anunciarán pronto.</p>
            }
            else
            {
                <div class="grid-productos-emprendimiento">
                    @foreach (Emprendimiento emprendimiento in emprendimientos)
                    {
                        <article class="producto-detalle-emprendimiento">
                            <img src="@ImagenDe(emprendimiento.LogoUrl)" alt="@emprendimiento.NombreComercial" />
                            <h3>@emprendimiento.NombreComercial</h3>
                            <p>
                                @(emprendimiento.Descripcion.Length > 80
                                    ? emprendimiento.Descripcion[..80].TrimEnd() + "…"
                                    : emprendimiento.Descripcion)
                            </p>
                        </article>
                    }
                </div>
            }
        </article>

        <aside class="tarjeta-contacto-emprendimiento">
            <h2>Detalles del evento</h2>
            <ul class="lista-contacto-emprendimiento">
                <li><i class="bi bi-calendar3"></i><span>@Model.FechaTexto</span></li>
                <li><i class="bi bi-clock-fill"></i><span>@Model.HorarioTexto</span></li>
                <li><i class="bi bi-geo-alt-fill"></i><span>@Model.Ubicacion</span></li>
                <li>
                    <i class="bi bi-people-fill"></i>
                    <span>
                        @(Model.CupoMaximo.HasValue
                            ? $"Cupo: {Model.CupoMaximo} personas"
                            : "Cupo abierto")
                    </span>
                </li>
            </ul>
            <a href="#" class="boton-contacto-emprendimiento">
                Inscribirme al evento
            </a>
        </aside>
    </div>
</section>

@if (otrosEventos.Any())
{
    <section class="relacionados-detalle-emprendimiento">
        <div class="container">
            <div class="encabezado-relacionados-emprendimiento">
                <div>
                    <span class="subtitulo-eventos">Agenda</span>
                    <h2>Otros eventos que te pueden interesar</h2>
                </div>
                <a asp-controller="Home" asp-action="Eventos">
                    Ver todos los eventos <i class="bi bi-arrow-right"></i>
                </a>
            </div>

            <div class="grid-relacionados-emprendimiento">
                @foreach (EventoPublicoViewModel otro in otrosEventos)
                {
                    <article class="tarjeta-relacionada-emprendimiento">
                        <img src="@ImagenDe(otro.ImagenUrl)" alt="@otro.Nombre" />
                        <div>
                            <span>@otro.FechaTexto</span>
                            <h3>@otro.Nombre</h3>
                            <a asp-controller="Home" asp-action="DetalleEvento" asp-route-id="@otro.IdEvento">
                                Ver evento <i class="bi bi-arrow-right"></i>
                            </a>
                        </div>
                    </article>
                }
            </div>
        </div>
    </section>
}

<section class="cta-detalle-emprendimiento">
    <div class="container">
        <div class="contenido-cta-detalle-emprendimiento">
            <span>Club Creativo MiVo</span>
            <h2>¿Quieres vivir esta experiencia?</h2>
            <p>Revisa la agenda completa y separa la fecha de tu próximo evento favorito.</p>
            <a asp-controller="Home" asp-action="Eventos" class="boton-cta-detalle-emprendimiento">
                Ver agenda de eventos
            </a>
        </div>
    </div>
</section>
