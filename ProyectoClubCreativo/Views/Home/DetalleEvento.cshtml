@model ProyectoClubCreativo.Models.ViewModels.EventoPublicoViewModel
@using ProyectoClubCreativo.Models.Entities
@using ProyectoClubCreativo.Models.ViewModels

@{
    ViewData["Title"] = Model.Nombre;
    Layout = "_LayoutExterno";

    bool eventoFinalizado =
    (Model.FechaFin ?? Model.FechaInicio) < DateTime.Now;

    List<Emprendimiento> emprendimientos =
        ViewBag.Emprendimientos as List<Emprendimiento> ?? new();

    List<EventoPublicoViewModel> otrosEventos =
        ViewBag.OtrosEventos as List<EventoPublicoViewModel> ?? new();

    string imagenPorDefecto = Url.Content("~/images/hero-feria.jpg");

    string ImagenDe(string? url) =>
        string.IsNullOrWhiteSpace(url) ? imagenPorDefecto : Url.Content(url);


    List<ResenaPublicaViewModel> resenas =
        ViewBag.Resenas as List<ResenaPublicaViewModel> ?? new();

    double promedioResenas =
        ViewBag.PromedioResenas is double promedio
            ? promedio
            : 0d;
    ResenaPublicaViewModel? miResena =
        ViewBag.MiResenaEvento as ResenaPublicaViewModel;


}

<section class="encabezado-detalle-emprendimiento">
    <div class="container">
        <nav class="migas-detalle-emprendimiento" aria-label="Navegación secundaria">
            <a asp-controller="Home" asp-action="Index">Inicio</a>
            <i class="bi bi-chevron-right"></i>
            <a asp-controller="Home" asp-action="Eventos">Eventos</a>
            <i class="bi bi-chevron-right"></i>
            <span>@Model.Nombre</span>
        </nav>

        <div class="perfil-detalle-emprendimiento">
            <img src="@ImagenDe(Model.ImagenUrl)" alt="Portada del evento" class="logo-detalle-emprendimiento" />

            <div class="informacion-perfil-emprendimiento">
                @if (!string.IsNullOrWhiteSpace(Model.Categoria))
                {
                    <span class="categoria-detalle-emprendimiento">@Model.Categoria</span>
                }
                <h1>@Model.Nombre</h1>
                <div class="datos-perfil-emprendimiento">
                    <span><i class="bi bi-calendar3"></i> @Model.FechaTexto</span>
                    <span><i class="bi bi-clock-fill"></i> @Model.HoraTexto</span>
                    <span><i class="bi bi-geo-alt-fill"></i> @Model.Ubicacion</span>
                </div>
            </div>
        </div>
    </div>
</section>

<section class="contenido-detalle-emprendimiento">
    <div class="container distribucion-detalle-emprendimiento">
        <article class="informacion-detalle-emprendimiento">
            <h2>Sobre el evento</h2>
            <p>@Model.Descripcion</p>

            <h2>Emprendimientos participantes</h2>

            @if (!emprendimientos.Any())
            {
                <p>Los emprendimientos participantes se anunciarán pronto.</p>
            }
            else
            {
                <div class="grid-productos-emprendimiento">
                    @foreach (Emprendimiento emprendimiento in emprendimientos)
                    {
                        <article class="producto-detalle-emprendimiento">
                            <img src="@ImagenDe(emprendimiento.LogoUrl)" alt="@emprendimiento.NombreComercial" />
                            <h3>@emprendimiento.NombreComercial</h3>
                            <p>
                                @(emprendimiento.Descripcion.Length > 80
                                    ? emprendimiento.Descripcion[..80].TrimEnd() + "…"
                                    : emprendimiento.Descripcion)
                            </p>
                        </article>
                    }
                </div>
            }
        </article>

        <aside class="tarjeta-contacto-emprendimiento">
            <h2>Detalles del evento</h2>
            <ul class="lista-contacto-emprendimiento">
                <li><i class="bi bi-calendar3"></i><span>@Model.FechaTexto</span></li>
                <li><i class="bi bi-clock-fill"></i><span>@Model.HorarioTexto</span></li>
                <li><i class="bi bi-geo-alt-fill"></i><span>@Model.Ubicacion</span></li>
                <li>
                    <i class="bi bi-people-fill"></i>
                    <span>
                        @(Model.CupoMaximo.HasValue
                            ? $"Cupo: {Model.CupoMaximo} personas"
                            : "Cupo abierto")
                    </span>
                </li>
            </ul>
            @if (TempData["ErrorEvento"] is string errorEvento)
            {
                <p style="color:#b91c1c; font-weight:600;">@errorEvento</p>
            }

            @if (eventoFinalizado)
            {
                <p style="font-weight:600; color:#64748b;">
                    <i class="bi bi-check-circle-fill"></i>
                    Este evento ya finalizó.
                </p>

                @if (Model.UsuarioRegistrado)
                {
                    <a asp-controller="Usuario"
                       asp-action="MisInscripciones"
                       class="boton-contacto-emprendimiento">
                        Ver mis inscripciones
                    </a>

                    <a href="#resenas-evento"
                       class="boton-contacto-emprendimiento"
                       style="margin-top:10px;">
                        Ver y calificar evento
                    </a>
                }
            }
            else if (Model.UsuarioRegistrado)
            {
                <p style="font-weight:600;"><i class="bi bi-check-circle-fill"></i> Ya estás registrado en este evento.</p>
                <a asp-controller="Usuario" asp-action="MisInscripciones" class="boton-contacto-emprendimiento">Ver mis inscripciones</a>
                @if (Model.FechaInicio > DateTime.Now)
                {
                    <form asp-controller="Usuario"
                          asp-action="CancelarRegistroEvento"
                          method="post"
                          style="margin-top:10px;"
                          onsubmit="return confirm('¿Cancelar tu inscripción a este evento?');">
                        <input type="hidden" name="id" value="@Model.IdEvento" />
                        <button type="submit"
                                class="boton-contacto-emprendimiento"
                                style="border:0; width:100%; cursor:pointer;">
                            Cancelar inscripción
                        </button>
                    </form>
                }
            }
            else if (Model.CupoLleno)
            {
                <p style="color:#b91c1c; font-weight:600;">Cupo lleno</p>
                <button type="button" class="boton-contacto-emprendimiento" disabled style="opacity:.5; cursor:not-allowed;">
                    Registrarse en evento
                </button>
            }
            else
            {
                <form asp-controller="Usuario" asp-action="RegistrarseEvento" method="post">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="id" value="@Model.IdEvento" />
                    <button type="submit" class="boton-contacto-emprendimiento" style="border:0; width:100%; cursor:pointer;">
                        Registrarse en evento
                    </button>
                </form>
            }
        </aside>
    </div>
</section>

<section class="contenido-detalle-emprendimiento"
         id="resenas-evento">

    <div class="container">

        <div style="margin-bottom:25px;">
            <span class="subtitulo-eventos">
                Experiencias de participantes
            </span>

            <h2>Reseñas del evento</h2>

            @if (resenas.Any())
            {
                <p>
                    <i class="bi bi-star-fill"
                       style="color:#eab308;"></i>

                    <strong>
                        @promedioResenas.ToString("0.0")
                    </strong>
                    de 5 estrellas

                    (@resenas.Count
                    @(resenas.Count == 1 ? "reseña" : "reseñas"))
                </p>
            }
            else
            {
                <p>
                    Este evento todavía no tiene reseñas.
                </p>
            }
        </div>

        @if (TempData["MensajeResena"] is string mensajeResena)
        {
            <div class="alert alert-success">
                <i class="bi bi-check-circle-fill"></i>
                @mensajeResena
            </div>
        }

        @if (TempData["ErrorResena"] is string errorResena)
        {
            <div class="alert alert-danger">
                <i class="bi bi-exclamation-circle-fill"></i>
                @errorResena
            </div>
        }

        @if (eventoFinalizado && Model.UsuarioRegistrado)
        {
            <div class="tarjeta-contacto-emprendimiento"
                 style="margin-bottom:25px;">

                <h3>
                    @(miResena == null
                        ? "Calificar este evento"
                        : "Editar mi reseña")
                </h3>

                <p>
                    Comparte tu experiencia y ayuda a otros
                    usuarios a conocer este evento.
                </p>

                <form asp-controller="Usuario"
                      asp-action="CalificarEvento"
                      method="post">

                    @Html.AntiForgeryToken()

                    <input type="hidden"
                           name="IdEvento"
                           value="@Model.IdEvento" />

                    <div style="margin-bottom:15px;">
                        <label for="valoracionEvento"
                               style="display:block; font-weight:600;">
                            Calificación
                        </label>

                        <select id="valoracionEvento"
                                name="Valoracion"
                                class="form-select"
                                required>

                            <option value="">Selecciona una calificación</option>

                            @for (int estrella = 1; estrella <= 5; estrella++)
                            {
                                <option value="@estrella"
                                        selected="@(miResena?.Valoracion == estrella)">
                                    @estrella @(estrella == 1 ? "estrella" : "estrellas")
                                </option>
                            }
                        </select>
                    </div>

                    <div style="margin-bottom:15px;">
                        <label for="comentarioEvento"
                               style="display:block; font-weight:600;">
                            Comentario
                        </label>

                        <textarea id="comentarioEvento"
                                  name="Contenido"
                                  class="form-control"
                                  rows="4"
                                  maxlength="1500"
                                  required
                                  placeholder="Cuéntanos cómo fue tu experiencia...">@(miResena?.Contenido)</textarea>
                    </div>

                    <button type="submit"
                            class="boton-contacto-emprendimiento"
                            style="border:0; cursor:pointer;">
                        <i class="bi bi-star-fill"></i>

                        @(miResena == null
                            ? "Publicar reseña"
                            : "Guardar cambios")
                    </button>

                </form>

                @if (miResena != null)
                {
                    <form asp-controller="Usuario"
                          asp-action="EliminarResena"
                          method="post"
                          style="margin-top:12px;"
                          onsubmit="return confirm('¿Seguro que deseas eliminar tu reseña?');">

                        @Html.AntiForgeryToken()

                        <input type="hidden"
                               name="idComentario"
                               value="@miResena.IdComentario" />

                        <button type="submit"
                                class="boton-contacto-emprendimiento"
                                style="border:0; cursor:pointer; background:#b91c1c;">
                            <i class="bi bi-trash"></i>
                            Eliminar mi reseña
                        </button>

                    </form>
                }
            </div>
        }
        else if (eventoFinalizado && !Model.UsuarioRegistrado)
        {
            <p style="color:#64748b; margin-bottom:25px;">
                Solo los usuarios inscritos en este evento
                pueden publicar una reseña.
            </p>
        }

        @foreach (ResenaPublicaViewModel resena in resenas)
        {
            <article class="tarjeta-contacto-emprendimiento"
                     style="margin-bottom:15px;">

                <div style="display:flex;
                    justify-content:space-between;
                    gap:15px;
                    flex-wrap:wrap;">

                    <strong>@resena.Autor</strong>

                    <span style="color:#eab308;">
                        @for (int estrella = 1; estrella <= 5; estrella++)
                        {
                            <i class="bi @(estrella <= resena.Valoracion
                                                            ? "bi-star-fill"
                                                            : "bi-star")"></i>
                    }
                </span>
            </div>

            <p style="margin-top:12px;
            white-space:pre-wrap;">@resena.Contenido</p>

            <small style="color:#64748b;">
                @resena.Fecha.ToString("dd/MM/yyyy")

                @if (resena.Editada)
                {
                    <span> · Editada</span>
                }
            </small>

        </article>
    }

    @if (!eventoFinalizado)
    {
        <p style="margin-top:20px; color:#64748b;">
            Las reseñas estarán disponibles cuando
            el evento haya finalizado.
        </p>
    }

</div>
</section>

@if (otrosEventos.Any())
{
    <section class="relacionados-detalle-emprendimiento">
        <div class="container">
            <div class="encabezado-relacionados-emprendimiento">
                <div>
                    <span class="subtitulo-eventos">Agenda</span>
                    <h2>Otros eventos que te pueden interesar</h2>
                </div>
                <a asp-controller="Home" asp-action="Eventos">
                    Ver todos los eventos <i class="bi bi-arrow-right"></i>
                </a>
            </div>

            <div class="grid-relacionados-emprendimiento">
                @foreach (EventoPublicoViewModel otro in otrosEventos)
                {
                    <article class="tarjeta-relacionada-emprendimiento">
                        <img src="@ImagenDe(otro.ImagenUrl)" alt="@otro.Nombre" />
                        <div>
                            <span>@otro.FechaTexto</span>
                            <h3>@otro.Nombre</h3>
                            <a asp-controller="Home" asp-action="DetalleEvento" asp-route-id="@otro.IdEvento">
                                Ver evento <i class="bi bi-arrow-right"></i>
                            </a>
                        </div>
                    </article>
                }
            </div>
        </div>
    </section>
}

<section class="cta-detalle-emprendimiento">
    <div class="container">
        <div class="contenido-cta-detalle-emprendimiento">
            <span>Club Creativo MiVo</span>
            <h2>¿Quieres vivir esta experiencia?</h2>
            <p>Revisa la agenda completa y separa la fecha de tu próximo evento favorito.</p>
            <a asp-controller="Home" asp-action="Eventos" class="boton-cta-detalle-emprendimiento">
                Ver agenda de eventos
            </a>
        </div>
    </div>
</section>
