@using ProyectoClubCreativo.Models.ViewModels
@model DetalleEmprendimientoPublicoViewModel

@{
    ViewData["Title"] = Model.NombreComercial;
    Layout = "_LayoutExterno";

    string imagenPorDefecto = Url.Content("~/images/logo.jpg");

    string ImagenDe(string? url) =>
        string.IsNullOrWhiteSpace(url) ? imagenPorDefecto : Url.Content(url);

    string Resumen(string texto, int maximo) =>
        texto.Length <= maximo ? texto : texto[..(maximo - 3)] + "...";

    string? EnlaceRed(string? valor, string baseUrl)
    {
        if (string.IsNullOrWhiteSpace(valor))
        {
            return null;
        }

        string limpio = valor.Trim();

        return limpio.StartsWith("http", StringComparison.OrdinalIgnoreCase)
            ? limpio
            : baseUrl + limpio.TrimStart('@');
    }

    string? instagram = EnlaceRed(Model.Instagram, "https://instagram.com/");
    string? facebook = EnlaceRed(Model.Facebook, "https://facebook.com/");
}

<!-- ENCABEZADO -->
<section class="encabezado-detalle-emprendimiento">
    <div class="container">

        <nav class="migas-detalle-emprendimiento" aria-label="Navegación secundaria">
            <a asp-controller="Home" asp-action="Index">Inicio</a>
            <i class="bi bi-chevron-right"></i>
            <a asp-controller="Home" asp-action="Emprendimientos">Emprendimientos</a>
            <i class="bi bi-chevron-right"></i>
            <span>@Model.NombreComercial</span>
        </nav>

        <div class="perfil-detalle-emprendimiento">

            <img src="@ImagenDe(Model.LogoUrl)"
                 alt="Logo del emprendimiento @Model.NombreComercial"
                 class="logo-detalle-emprendimiento" />

            <div class="informacion-perfil-emprendimiento">
                @if (!string.IsNullOrWhiteSpace(Model.Categoria))
                {
                    <span class="categoria-detalle-emprendimiento">@Model.Categoria</span>
                }

                <h1>@Model.NombreComercial</h1>

                <p class="resumen-detalle-emprendimiento">@Resumen(Model.Descripcion, 180)</p>

                <div class="datos-perfil-emprendimiento">
                    @if (!string.IsNullOrWhiteSpace(Model.Provincia))
                    {
                        <span><i class="bi bi-geo-alt-fill"></i> @Model.Provincia</span>
                    }

                    @if (Model.CantidadResenas > 0 && Model.Valoracion.HasValue)
                    {
                        <span>
                            <i class="bi bi-star-fill"></i>
                            @Model.Valoracion.Value.ToString("0.0", System.Globalization.CultureInfo.InvariantCulture)
                            (@Model.CantidadResenas @(Model.CantidadResenas == 1 ? "reseña" : "reseñas"))
                        </span>
                    }
                    else
                    {
                        <span><i class="bi bi-star"></i> Sin reseñas todavía</span>
                    }

                    <span><i class="bi bi-patch-check-fill"></i> Emprendimiento verificado</span>
                </div>
            </div>

        </div>

    </div>
</section>

<!-- GALERÍA -->
@if (Model.Imagenes.Any())
{
    <section class="galeria-detalle-emprendimiento">
        <div class="container">
            <div class="grid-galeria-emprendimiento">
                @foreach (string imagen in Model.Imagenes)
                {
                    <img src="@ImagenDe(imagen)" alt="Galería de @Model.NombreComercial" />
                }
            </div>
        </div>
    </section>
}

<!-- CONTENIDO -->
<section class="contenido-detalle-emprendimiento">
    <div class="container distribucion-detalle-emprendimiento">

        <article class="informacion-detalle-emprendimiento">

            <h2>Nuestra historia</h2>
            <p>@Model.Descripcion</p>

            @if (Model.Productos.Any())
            {
                <h2>Productos destacados</h2>

                <div class="grid-productos-emprendimiento">
                    @foreach (ProductoEmprendimientoPublicoViewModel producto in Model.Productos)
                    {
                        <article class="producto-detalle-emprendimiento">
                            <a asp-controller="Home" asp-action="DetalleProducto" asp-route-id="@producto.IdProducto">
                                <img src="@ImagenDe(producto.ImagenUrl)" alt="@producto.Nombre" />
                            </a>
                            <h3>@producto.Nombre</h3>
                            <p>@Resumen(producto.Descripcion, 90)</p>
                            <p><strong>₡@producto.Precio.ToString("N0")</strong></p>
                        </article>
                    }
                </div>
            }

        </article>

        <aside class="tarjeta-contacto-emprendimiento">

            <h2>Contacto</h2>

            <ul class="lista-contacto-emprendimiento">
                @if (!string.IsNullOrWhiteSpace(Model.Telefono))
                {
                    <li>
                        <i class="bi bi-whatsapp"></i>
                        <span>@Model.Telefono</span>
                    </li>
                }

                <li>
                    <i class="bi bi-envelope-fill"></i>
                    <span>@Model.Correo</span>
                </li>

                @if (!string.IsNullOrWhiteSpace(Model.Provincia))
                {
                    <li>
                        <i class="bi bi-geo-alt-fill"></i>
                        <span>@Model.Provincia, Costa Rica</span>
                    </li>
                }

                @if (instagram is not null)
                {
                    <li>
                        <i class="bi bi-instagram"></i>
                        <a href="@instagram" target="_blank" rel="noopener">@Model.Instagram</a>
                    </li>
                }

                @if (facebook is not null)
                {
                    <li>
                        <i class="bi bi-facebook"></i>
                        <a href="@facebook" target="_blank" rel="noopener">@Model.Facebook</a>
                    </li>
                }

                @if (!string.IsNullOrWhiteSpace(Model.SitioWeb))
                {
                    <li>
                        <i class="bi bi-globe"></i>
                        <a href="@Model.SitioWeb" target="_blank" rel="noopener">@Model.SitioWeb</a>
                    </li>
                }
            </ul>

            @if (Model.EnlaceWhatsApp is not null)
            {
                <a href="@Model.EnlaceWhatsApp" target="_blank" rel="noopener" class="boton-contacto-emprendimiento">
                    Escribir por WhatsApp
                </a>
            }

        </aside>

    </div>
</section>

<!-- EMPRENDIMIENTOS RELACIONADOS -->
@if (Model.Relacionados.Any())
{
    <section class="relacionados-detalle-emprendimiento">
        <div class="container">

            <div class="encabezado-relacionados-emprendimiento">
                <div>
                    <span class="subtitulo-emprendimientos">Sigue explorando</span>
                    <h2>Otros emprendimientos que te pueden interesar</h2>
                </div>

                <a asp-controller="Home" asp-action="Emprendimientos">
                    Ver todos los emprendimientos
                    <i class="bi bi-arrow-right"></i>
                </a>
            </div>

            <div class="grid-relacionados-emprendimiento">
                @foreach (EmprendimientoPublicoViewModel relacionado in Model.Relacionados)
                {
                    <article class="tarjeta-relacionada-emprendimiento">
                        <img src="@ImagenDe(relacionado.ImagenUrl)" alt="@relacionado.NombreComercial" />

                        <div>
                            @if (!string.IsNullOrWhiteSpace(relacionado.Categoria))
                            {
                                <span>@relacionado.Categoria</span>
                            }
                            <h3>@relacionado.NombreComercial</h3>

                            <a asp-controller="Home"
                               asp-action="DetalleEmprendimiento"
                               asp-route-id="@relacionado.IdEmprendimiento">
                                Ver emprendimiento
                                <i class="bi bi-arrow-right"></i>
                            </a>
                        </div>
                    </article>
                }
            </div>

        </div>
    </section>
}

<!-- CTA FINAL -->
<section class="cta-detalle-emprendimiento">
    <div class="container">
        <div class="contenido-cta-detalle-emprendimiento">
            <span>Club Creativo MiVo</span>

            <h2>¿Querés conocer más talento local?</h2>

            <p>
                Explorá el directorio completo de emprendimientos y
                descubrí productos hechos con dedicación.
            </p>

            <a asp-controller="Home"
               asp-action="Emprendimientos"
               class="boton-cta-detalle-emprendimiento">
                Ver emprendimientos
            </a>
        </div>
    </div>
</section>
