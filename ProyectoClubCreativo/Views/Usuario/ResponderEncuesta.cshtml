@model ProyectoClubCreativo.Models.ViewModels.ResponderEncuestaViewModel

@{
    ViewData["Title"] = "Responder encuesta";
    Layout = "~/Views/Shared/_LayoutUsuario.cshtml";
}

<div class="encabezado-pagina-usuario">
    <div>
        <span class="etiqueta-pagina-usuario">
            @Model.ElementoRelacionado
        </span>

        <h1 class="titulo-pagina-usuario">
            @Model.NombreEncuesta
        </h1>

        <p class="descripcion-pagina-usuario">
            @(string.IsNullOrWhiteSpace(Model.Descripcion) ? "Tu opinión nos ayuda a mejorar las próximas experiencias." : Model.Descripcion)
        </p>
    </div>
</div>

<section class="tarjeta-formulario-usuario">

    <form asp-action="ResponderEncuesta" method="post" novalidate>

        @Html.AntiForgeryToken()

        <input asp-for="IdEncuesta" type="hidden" />

        <div asp-validation-summary="ModelOnly" class="resumen-validacion"></div>

        @for (int i = 0; i < Model.Preguntas.Count; i++)
        {
            var pregunta = Model.Preguntas[i];

            <div class="pregunta-encuesta">
                <input type="hidden" name="Preguntas[@i].IdPregunta" value="@pregunta.IdPregunta" />

                <h2>
                    @pregunta.Texto
                    @if (pregunta.Obligatoria)
                    {
                        <small>(obligatoria)</small>
                    }
                </h2>

                @if (pregunta.Tipo == "Escala")
                {
                    <div class="escala-satisfaccion">
                        @for (int valor = 1; valor <= 5; valor++)
                        {
                            <label>
                                <input type="radio" name="Preguntas[@i].Valor" value="@valor" checked="@(pregunta.Valor == valor)" />
                                <span>@valor</span>
                            </label>
                        }
                    </div>
                }
                else if (pregunta.Tipo == "OpcionUnica")
                {
                    <div class="opciones-encuesta">
                        @foreach (var opcion in pregunta.Opciones)
                        {
                            <label>
                                <input type="radio" name="Preguntas[@i].IdOpcion" value="@opcion.IdOpcion" checked="@(pregunta.IdOpcion == opcion.IdOpcion)" />
                                @opcion.Texto
                            </label>
                        }
                    </div>
                }
                else
                {
                    <textarea name="Preguntas[@i].RespuestaTexto"
                              class="control-formulario"
                              maxlength="1000"
                              placeholder="Escribe tu respuesta...">@pregunta.RespuestaTexto</textarea>
                }
            </div>
        }

        <button type="submit" class="boton-accion-usuario">
            <i class="bi bi-send-fill"></i>
            Enviar encuesta
        </button>

    </form>
</section>
