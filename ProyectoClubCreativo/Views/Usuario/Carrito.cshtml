@model ProyectoClubCreativo.Models.ViewModels.CarritoUsuarioViewModel

@{
    ViewData["Title"] = "Carrito";
    Layout = "~/Views/Shared/_LayoutUsuario.cshtml";
}

<div class="encabezado-pagina-usuario">
    <div>
        <span class="etiqueta-pagina-usuario">Compra</span>
        <h1 class="titulo-pagina-usuario">Carrito de compras</h1>
        <p class="descripcion-pagina-usuario">
            Revisa los productos seleccionados antes de continuar.
        </p>
    </div>
</div>

<section class="distribucion-carrito">

    <div class="tarjeta-modulo-usuario">
        @foreach (var producto in Model.Productos)
        {
            <article class="producto-carrito">

                <img src="@producto.Imagen"
                     alt="@producto.Nombre" />

                <div class="datos-producto-carrito">
                    <h2>@producto.Nombre</h2>
                    <span>@producto.Emprendimiento</span>

                    <div class="cantidad-carrito">
                        <button type="button">−</button>
                        <input value="@producto.Cantidad"
                               min="1"
                               type="number" />
                        <button type="button">+</button>
                    </div>
                </div>

                <div class="precio-producto-carrito">
                    <strong>
                        ₡@producto.Subtotal.ToString("N0")
                    </strong>

                    <button type="button"
                            class="eliminar-carrito">
                        <i class="bi bi-trash3"></i>
                        Eliminar
                    </button>
                </div>

            </article>
        }
    </div>

    <aside class="tarjeta-modulo-usuario resumen-orden-usuario">
        <h2>Resumen de compra</h2>

        <div>
            <span>Subtotal</span>
            <strong>₡@Model.Subtotal.ToString("N0")</strong>
        </div>

        <div>
            <span>Descuento</span>
            <strong>-₡@Model.Descuento.ToString("N0")</strong>
        </div>

        <div class="total-resumen-usuario">
            <span>Total</span>
            <strong>₡@Model.Total.ToString("N0")</strong>
        </div>

        <a asp-action="ProcesoCompra"
           class="boton-accion-usuario boton-ancho-completo">
            Continuar compra
            <i class="bi bi-arrow-right"></i>
        </a>

        <a asp-controller="Home"
           asp-action="CatalogoProductos"
           class="enlace-continuar-comprando">
            Seguir explorando productos
        </a>
    </aside>

</section>