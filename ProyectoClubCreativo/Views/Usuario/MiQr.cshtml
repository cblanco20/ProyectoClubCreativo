@{
    ViewData["Title"] = "Asistencia y puntos";
    Layout = "~/Views/Shared/_LayoutUsuario.cshtml";
}

<div class="encabezado-pagina-usuario">
    <div>
        <span class="etiqueta-pagina-usuario">
            Creativo Frecuente
        </span>

        <h1 class="titulo-pagina-usuario">
            Asistencia y puntos
        </h1>

        <p class="descripcion-pagina-usuario">
            Participa en los talleres de Club Creativo MiVo,
            registra tu asistencia y acumula puntos que podrás
            utilizar en las recompensas disponibles.
        </p>
    </div>
</div>

<!-- Contenedor centrado -->
<section style="
    display: flex;
    justify-content: center;
    width: 100%;
    padding: 25px 20px 50px;
    box-sizing: border-box;
    ">

    <!-- Tarjeta de información -->
    <div style="
        width: 100%;
        max-width: 760px;
        background: white;
        border-radius: 22px;
        padding: 35px;
        box-shadow: 0 8px 28px rgba(0, 0, 0, 0.06);
        box-sizing: border-box;
        ">

        <span class="etiqueta-pagina-usuario">
            ¿Cómo funciona?
        </span>

        <h2 style="
            font-size: clamp(25px, 3vw, 34px);
            margin-top: 18px;
            margin-bottom: 12px;
            ">
            Registra tu asistencia y gana puntos
        </h2>

        <p style="
            font-size: 15px;
            line-height: 1.7;
            color: #666;
            margin-bottom: 28px;
            ">
            Al participar en los talleres de Club Creativo MiVo,
            puedes ganar puntos por tu asistencia.
            Sigue estos pasos para registrarla correctamente.
        </p>

        <!-- Pasos -->
        <div class="pasos-qr-usuario">

            <!-- Paso 1 -->
            <div class="paso-qr-usuario"
                 style="margin-bottom: 14px; padding: 18px;">

                <span>1</span>

                <div>
                    <strong>
                        Inscríbete en un taller
                    </strong>

                    <p>
                        Selecciona un taller disponible
                        y completa tu inscripción.
                    </p>
                </div>
            </div>

            <!-- Paso 2 -->
            <div class="paso-qr-usuario"
                 style="margin-bottom: 14px; padding: 18px;">

                <span>2</span>

                <div>
                    <strong>
                        Registra tu asistencia
                    </strong>

                    <p>
                        El día del taller, sigue las indicaciones
                        del encargado para confirmar tu participación.
                    </p>
                </div>
            </div>

            <!-- Paso 3 -->
            <div class="paso-qr-usuario"
                 style="margin-bottom: 25px; padding: 18px;">

                <span>3</span>

                <div>
                    <strong>
                        Recibe tus puntos
                    </strong>

                    <p>
                        Una vez registrada tu asistencia,
                        consulta los puntos ganados en
                        "Puntos y recompensas".
                    </p>
                </div>
            </div>

        </div>

        <!-- Botón centrado -->
        <div style="
            display: flex;
            justify-content: center;
            margin-top: 25px;
            ">

            <a asp-controller="Usuario"
               asp-action="PuntosRecompensas"
               class="boton-accion-usuario">

                <i class="bi bi-star-fill"></i>
                Ver puntos y recompensas

            </a>

        </div>

    </div>

</section>
